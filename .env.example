# Copy this file to .env and fill in real values before deploying to production.
# The site runs fully without any of these set — payments fall back to an
# "invoice pending" path and emails log to data/email-log.json instead of
# sending, so you can test the whole flow locally before going live.

# --- Admin panel ---
ADMIN_PASSWORD=changeme123
SESSION_SECRET=change-this-to-a-long-random-string

# --- Email (SMTP) — leave blank to log emails instead of sending ---
# Works with any standard SMTP provider (SendGrid, Postmark, Resend, Gmail
# with an app password, your company's own mail server, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Baseline Skills <no-reply@baselineskills.com>"
ADMIN_EMAIL=admin@baselineskills.com

# --- Payments (Paddle) — leave blank to use the invoice-pending fallback ---
# Same provider and env var convention as ReqDrive. PADDLE_API_KEY is used
# server-side to create transactions; PADDLE_CLIENT_TOKEN is used client-side
# to open the Paddle.js checkout overlay — these are two different keys from
# your Paddle dashboard, not the same value twice.
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_ENVIRONMENT=sandbox
PADDLE_WEBHOOK_SECRET=

# --- Payments (PayPal) — leave blank to use the invoice-pending fallback ---
# Both Paddle and PayPal can be configured at once; the checkout page shows
# whichever provider(s) have credentials set (see lib/payments/index.js) —
# except Razorpay below, which is only ever offered to India-based buyers,
# regardless of what else is configured.
# PAYPAL_CLIENT_ID / PAYPAL_CLIENT_SECRET come from a PayPal Developer "app".
# PAYPAL_WEBHOOK_ID comes from registering a webhook against that same app —
# PayPal verifies webhook authenticity via its own API using this ID, unlike
# Paddle's local HMAC signature check.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=

# --- Payments (Razorpay) — India-domestic gateway ---
# PayPal cannot process India-to-India transactions at all (a structural
# RBI restriction on how PayPal is licensed to operate in India, not a
# setting that can be changed — see lib/payments/index.js's
# availableProvidersForCountry), so a buyer whose billing country is India
# is routed to Razorpay instead of PayPal automatically. Leave these blank
# and India-based buyers will fall through to the invoice-pending path,
# same as if no provider were configured at all for them specifically.
# RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET come from Razorpay's dashboard
# (Settings > API Keys). RAZORPAY_WEBHOOK_SECRET is set when you create a
# webhook there (Settings > Webhooks) pointed at
# https://yourdomain.com/webhooks/razorpay, subscribed to the
# payment.captured event.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Razorpay is fundamentally an INR gateway; course prices throughout this
# app are stored in EUR, so this is the exchange rate (INR per 1 EUR) used
# to convert at the moment a Razorpay order is created. A single,
# manually-set number, not a live FX API — update it periodically to
# track the real rate. Required for any India-based registration to reach
# checkout at all once Razorpay is configured; leaving it unset or at 0
# will make Razorpay order creation fail for every India-based buyer.
EUR_TO_INR_RATE=

PORT=3000

# --- Storage location ---
# Leave blank for local development (uses ./data). In production on a
# platform like Render, set this to your persistent disk's mount path —
# e.g. DATA_DIR=/var/data — so registrations and course data survive
# deploys and restarts instead of living on ephemeral container storage.
DATA_DIR=
