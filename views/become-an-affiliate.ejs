<%- include('partials/header') %>

<section class="section-tight" style="background:#fff;border-bottom:1px solid var(--line)">
  <div class="container">
    <span class="eyebrow"><%= t('affiliate_apply_eyebrow') %></span>
    <h1 style="font-size:2.1rem"><%= t('affiliate_apply_title') %></h1>
    <p class="lead"><%= t('affiliate_apply_lead') %></p>
  </div>
</section>

<section class="section">
  <div class="container grid-2" style="align-items:start">
    <div>
      <h3><%= t('hero_howitworks_title') %></h3>
      <ol style="padding-left:20px;color:var(--muted)">
        <li><%= t('affiliate_step1') %></li>
        <li><%= t('affiliate_step2') %></li>
        <li><%= t('affiliate_step3') %></li>
        <li><%= t('affiliate_step4') %></li>
      </ol>
      <p><a href="/docs/Baseline_Skills_Rules_of_Engagement.pdf" target="_blank" class="btn btn-outline"><%= t('download_roe') %></a></p>
      <p style="font-size:.85rem;color:var(--muted)"><%- t('affiliate_already_applied', '<a href="/affiliate/login">' + t('affiliate_login_link_text') + '</a>') %></p>
    </div>

    <div class="card">
      <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
      <form method="POST" action="/become-an-affiliate/apply" enctype="multipart/form-data">
        <div class="form-field"><label><%= t('register_full_name') %> *</label><input type="text" name="name" required></div>
        <div class="form-field"><label><%= t('common_email') %> *</label><input type="email" name="email" required></div>
        <div class="form-field"><label><%= t('signup_password_label', passwordMinLength) %></label><input type="password" name="password" minlength="<%= passwordMinLength %>" required></div>
        <div class="form-field"><label><%= t('common_organization_optional') %></label><input type="text" name="organization"></div>
        <div class="form-field"><label><%= t('signed_roe_required') %></label><input type="file" name="signedRoe" accept="application/pdf" required></div>
        <button type="submit" class="btn btn-navy btn-block"><%= t('submit_application') %></button>
      </form>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
