<%- include('partials/header') %>

<section class="section" style="min-height:60vh;display:flex;align-items:center;justify-content:center">
  <div class="container" style="max-width:420px">
    <h1 style="font-size:1.6rem;text-align:center"><%= t('affiliate_login_title') %></h1>
    <div class="card" style="margin-top:20px">
      <% if (typeof success !== 'undefined' && success) { %><div class="alert alert-success"><%= success %></div><% } %>
      <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
      <form method="POST" action="/affiliate/login">
        <div class="form-field"><label><%= t('common_email') %></label><input type="email" name="email" required autofocus></div>
        <div class="form-field"><label><%= t('common_password') %></label><input type="password" name="password" required></div>
        <button type="submit" class="btn btn-navy btn-block"><%= t('login_log_in') %></button>
      </form>
      <p style="margin-top:16px;font-size:.9rem"><a href="/affiliate/forgot-password" style="font-size:.9rem"><%= t('login_forgot_password') %></a></p>
      <p style="margin-top:8px;font-size:.9rem;color:var(--muted)"><%- t('affiliate_not_yet', '<a href="/become-an-affiliate">' + t('apply_here') + '</a>') %></p>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
