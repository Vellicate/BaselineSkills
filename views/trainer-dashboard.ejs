<%- include('partials/header') %>

<section class="section-tight" style="background:#fff;border-bottom:1px solid var(--line)">
  <div class="container">
    <span class="eyebrow">Trainer Dashboard</span>
    <h1 style="font-size:2rem">Welcome, <%= instructor.name %>.</h1>
    <p class="lead"><a href="/trainer/logout">Log out</a></p>
  </div>
</section>

<section class="section">
  <div class="container">
    <% if (referralCode) { %>
    <div class="card" style="margin-bottom:24px">
      <h3 style="margin-top:0">Your referral link</h3>
      <p style="font-family:monospace;background:var(--surface-2, #f5f5f5);padding:8px 12px;border-radius:6px;display:inline-block">https://baselineskills.com/courses/[course-slug]?ref=<%= referralCode.code %></p>
      <p style="color:var(--muted);font-size:.85rem">Share this link — anyone who registers through it is attributed to you.</p>
    </div>
    <% } %>

    <h2>Courses you teach</h2>
    <% if (courses.length === 0) { %>
      <p class="lead">No courses assigned to you yet — an admin will link your account to your course(s).</p>
    <% } else { %>
    <div class="grid-3">
      <% courses.forEach(c => { %>
        <div class="card"><h4><%= c.title %></h4></div>
      <% }) %>
    </div>
    <% } %>

    <h2 style="margin-top:32px">Earnings</h2>
    <p class="lead">Total earned to date: <strong>$<%= (totalEarnedCents/100).toFixed(2) %></strong></p>
    <% if (earnings.length > 0) { %>
    <table class="admin-table" style="background:#fff">
      <thead><tr><th>Tier</th><th>Rate</th><th>Gross</th><th>Commission</th></tr></thead>
      <tbody>
        <% earnings.forEach(e => { %>
          <tr><td><%= e.tier %></td><td><%= e.ratePercent %>%</td><td>$<%= (e.grossCourseRevenueCents/100).toFixed(2) %></td><td>$<%= (e.commissionCents/100).toFixed(2) %></td></tr>
        <% }) %>
      </tbody>
    </table>
    <% } %>
  </div>
</section>

<section class="section" style="padding-top:0">
  <div class="container">
    <h2>Payout history</h2>
    <% if (payouts.length === 0) { %>
      <p class="lead">No payouts issued yet — completed sales accrue above until an admin generates a payout for a given period.</p>
    <% } else { %>
    <table class="admin-table" style="background:#fff">
      <thead><tr><th>Period</th><th>Amount</th><th>Status</th></tr></thead>
      <tbody>
        <% payouts.forEach(p => { %>
          <tr><td><%= p.periodStart %> – <%= p.periodEnd %></td><td>$<%= (p.totalAmountCents/100).toFixed(2) %></td><td><%= p.status %></td></tr>
        <% }) %>
      </tbody>
    </table>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>
