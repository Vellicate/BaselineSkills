<%- include('partials/header') %>

<section class="section-tight" style="background:#fff;border-bottom:1px solid var(--line)">
  <div class="container">
    <span class="eyebrow">Account Recovery</span>
    <h1 style="font-size:2.1rem">Reset your password.</h1>
  </div>
</section>

<section class="section">
  <div class="container" style="max-width:480px">
    <div class="card">
      <% if (sent) { %>
        <div class="alert alert-success">If an account exists for that email, we've sent a link to reset your password. It expires in 1 hour.</div>
        <p style="margin-top:16px;font-size:.9rem"><a href="/login">Back to log in</a></p>
      <% } else { %>
        <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
        <p style="color:var(--muted);font-size:.9rem;margin-bottom:16px">Enter the email address on your account and we'll send you a link to set a new password.</p>
        <form method="POST" action="/forgot-password">
          <div class="form-field"><label>Email</label><input type="email" name="email" required autofocus></div>
          <div class="form-field">
            <label><%= captchaQuestion %></label>
            <input type="number" name="captchaAnswer" required placeholder="Your answer">
          </div>
          <button type="submit" class="btn btn-navy btn-block">Send Reset Link</button>
        </form>
        <p style="margin-top:16px;font-size:.9rem;color:var(--muted)"><a href="/login">Back to log in</a></p>
      <% } %>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
