<%- include('partials/header') %>

<section class="section-tight" style="background:#fff;border-bottom:1px solid var(--line)">
  <div class="container">
    <span class="eyebrow"><%= t('forgot_eyebrow') %></span>
    <h1 style="font-size:2.1rem"><%= t('forgot_title') %></h1>
  </div>
</section>

<section class="section">
  <div class="container" style="max-width:480px">
    <div class="card">
      <% if (sent) { %>
        <div class="alert alert-success"><%= t('forgot_sent_message') %></div>
        <p style="margin-top:16px;font-size:.9rem"><a href="<%= typeof loginUrl !== 'undefined' ? loginUrl : '/login' %>"><%= t('forgot_back_to_login') %></a></p>
      <% } else { %>
        <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
        <p style="color:var(--muted);font-size:.9rem;margin-bottom:16px"><%= t('forgot_instructions') %></p>
        <form method="POST" action="<%= typeof action !== 'undefined' ? action : '/forgot-password' %>">
          <div class="form-field"><label><%= t('common_email') %></label><input type="email" name="email" required autofocus></div>
          <div class="form-field">
            <label><%= t('captcha_question', captchaA, captchaB) %></label>
            <input type="number" name="captchaAnswer" required placeholder="<%= t('forgot_your_answer_placeholder') %>">
          </div>
          <button type="submit" class="btn btn-navy btn-block"><%= t('forgot_send_reset_link') %></button>
        </form>
        <p style="margin-top:16px;font-size:.9rem;color:var(--muted)"><a href="<%= typeof loginUrl !== 'undefined' ? loginUrl : '/login' %>"><%= t('forgot_back_to_login') %></a></p>
      <% } %>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
