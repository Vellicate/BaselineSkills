<%- include('partials/header') %>

<!-- Hero Section with Animated Headline, Core Trainer Card & Featured Card -->
<section class="hero hero-enhanced">
  <div class="hero-bg-mesh" aria-hidden="true"></div>
  <div class="container hero-inner">
    <div class="hero-content-col">
      <div class="hero-badge-pill animate-fade-in">
        <span class="badge-sparkle">✨</span>
        <span class="badge-text">Professional skills, made practical</span>
      </div>

      <!-- Exact Primary Hero Heading -->
      <h1 class="hero-title animate-title">
        From &ldquo;I should learn this&rdquo; to &ldquo;I can use this.&rdquo;
      </h1>

      <p class="hero-subtitle animate-fade-in delay-1">
        Learn skills that matter at work&mdash;not just courses you can complete. Choose a useful outcome, learn with experienced practitioners, practise what you learn, and take it back to work.
      </p>

      <div class="hero-ctas animate-fade-in delay-2">
        <a href="#outcomes" class="btn btn-gold btn-lg btn-glow" data-analytics-event="choose_outcome">
          <span>Choose your outcome</span>
          <svg class="btn-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
        <a href="/courses" class="btn btn-outline-light btn-lg" data-analytics-event="explore_learning_path">
          <span>Explore learning paths</span>
        </a>
      </div>

      <!-- CORE Professional Trainer Card -->
      <div class="core-trainer-card animate-fade-in delay-3">
        <div class="trainer-card-header">
          <div class="trainer-meta">
            <div class="trainer-title-wrap">
              <span class="trainer-kicker">Proven Track Record</span>
            </div>
          </div>
        </div>

        <div class="trainer-stats-grid">
          <div class="trainer-stat-pill">
            <span class="stat-highlight">Since <%= siteStats.founded %></span>
            <span class="stat-caption">Turning knowledge into practical skills.</span>
          </div>
          <div class="trainer-stat-pill">
            <span class="stat-highlight"><%= siteStats.rating %>/5.0</span>
            <span class="stat-caption">Average Course Rating</span>
          </div>
          <div class="trainer-stat-pill">
            <span class="stat-highlight"><%= siteStats.professionals %></span>
            <span class="stat-caption">Professionals Trained</span>
          </div>
          <div class="trainer-stat-pill">
            <span class="stat-highlight"><%= siteStats.industries %></span>
            <span class="stat-caption">Industries Served</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Right-Aligned Featured Course Card -->
    <div class="hero-featured-col animate-float-right">
      <div class="featured-card-wrapper">
        <div class="featured-card-glow"></div>
        <div class="hero-card next-steps-card">
          <h2 style="margin-bottom:18px;font-size:1.43rem">How it works</h2>
          <div class="next-step-item">
            <span class="next-step-num">01</span>
            <div>
              <h3 style="margin:0 0 4px;font-size:1.05rem">Choose a useful outcome</h3>
              <p style="margin:0;color:var(--muted);font-size:.9rem">Start with what you want to be able to do.</p>
            </div>
          </div>
          <div class="next-step-item">
            <span class="next-step-num">02</span>
            <div>
              <h3 style="margin:0 0 4px;font-size:1.05rem">Learn with practitioners</h3>
              <p style="margin:0;color:var(--muted);font-size:.9rem">Learn from professionals who have done the work.</p>
            </div>
          </div>
          <div class="next-step-item">
            <span class="next-step-num">03</span>
            <div>
              <h3 style="margin:0 0 4px;font-size:1.05rem">Practise what you learn</h3>
              <p style="margin:0;color:var(--muted);font-size:.9rem">Turn concepts into practical capability.</p>
            </div>
          </div>
          <div class="next-step-item">
            <span class="next-step-num">04</span>
            <div>
              <h3 style="margin:0 0 4px;font-size:1.05rem">Take it back to work</h3>
              <p style="margin:0;color:var(--muted);font-size:.9rem">Apply the skill to your project, team or organisation.</p>
            </div>
          </div>
          <div style="margin-top:20px;padding-top:16px;border-top:1px solid var(--line);text-align:center">
            <strong style="color:var(--navy)">Small steps. Real momentum.</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Learn -> Practise -> Apply -->
<section class="section" style="background:#fff">
  <div class="container">
    <div class="section-hdr center">
      <h2>Learning doesn&rsquo;t stop when the session ends.</h2>
      <p class="lead">The difference between knowing a method and being able to use it is practice.</p>
    </div>
    <div class="kpd-progression">
      <span>KNOW</span><span class="kpd-arrow">&darr;</span><span>PRACTISE</span><span class="kpd-arrow">&darr;</span><span>DO</span>
    </div>
    <div class="lpa-grid">
      <div class="lpa-card">
        <div class="lpa-icon" aria-hidden="true">📖</div>
        <h3>Learn</h3>
        <p>Build the concepts, methods and professional judgement with experienced practitioners.</p>
      </div>
      <div class="lpa-card">
        <div class="lpa-icon" aria-hidden="true">🛠️</div>
        <h3>Practise</h3>
        <p>Work through realistic situations and exercises that turn knowledge into capability.</p>
      </div>
      <div class="lpa-card">
        <div class="lpa-icon" aria-hidden="true">🎯</div>
        <h3>Apply</h3>
        <p>Take what you have learned back to your project, team and workplace.</p>
      </div>
    </div>
  </div>
</section>

<!-- Feature Learning Paths Section (Highlighted & Animated) -->
<section class="section learning-paths-section" id="outcomes">
  <div class="container">
    <div class="section-hdr center">
      <span class="eyebrow">Start with what you want to be able to do</span>
      <h2>Choose a useful outcome</h2>
      <p class="lead">Don't start with a course. Start with an outcome.</p>
    </div>

    <% const categoryDisplayLabel = (cat) => cat === 'AI' ? 'Artificial Intelligence' : cat; %>
    <% const outcomeCopy = {
      "Requirements Engineering": { title: "Improve Requirements", desc: "Write, analyse and manage better requirements." },
      "Business Analysis": { title: "Become a Better Business Analyst", desc: "Build practical analysis, stakeholder and decision-making skills." },
      "Systems Engineering": { title: "Build Systems Thinking", desc: "Understand systems, architecture and engineering relationships." },
      "Business Process Modeling": { title: "Improve Business Processes", desc: "Model, analyse and improve how work gets done." },
      "Artificial Intelligence": { title: "Work with AI", desc: "Apply AI thoughtfully to professional work." },
      "AI": { title: "Work with AI", desc: "Apply AI thoughtfully to professional work." },
      "Automotive": { title: "Build Automotive Engineering Skills", desc: "Develop practical capability for modern automotive and software-defined products." },
      "Project Management": { title: "Manage Projects with Confidence", desc: "Plan, track and deliver work that stays on budget and on time." },
    }; %>
    <div class="outcome-grid">
      <% Object.keys(byCategory).forEach((cat) => { %>
        <% const copy = outcomeCopy[cat] || { title: categoryDisplayLabel(cat), desc: "Build practical, job-ready skills in this area." }; %>
        <div class="outcome-card">
          <div class="outcome-count"><%= byCategory[cat].length %> course<%= byCategory[cat].length === 1 ? '' : 's' %></div>
          <h3><%= copy.title %></h3>
          <p><%= copy.desc %></p>
          <a href="#path-<%= cat.replace(/\s+/g,'-') %>" class="btn btn-outline btn-sm" onclick="selectOutcome('<%= cat.replace(/\s+/g,'-') %>', event)" data-analytics-event="choose_outcome" data-category="<%= cat %>">
            Explore <%= categoryDisplayLabel(cat) %>
          </a>
        </div>
      <% }) %>
    </div>

    <!-- Animated Path Tabs Container -->
    <div class="path-tabs-container">
      <div class="path-tabs" style="justify-content:center">
        <% Object.keys(byCategory).forEach((cat, i) => { %>
          <button class="path-tab <%= i===0?'active':'' %>" onclick="showPath('<%= cat.replace(/\s+/g,'-') %>', this)">
            <span class="tab-label"><%= categoryDisplayLabel(cat) %></span>
            <span class="tab-badge"><%= byCategory[cat].length %></span>
          </button>
        <% }) %>
      </div>
    </div>

    <!-- Path Panels Grid -->
    <div class="path-panels-wrapper">
      <% Object.keys(byCategory).forEach((cat, i) => { %>
        <div class="path-panel <%= i===0?'active':'' %>" id="path-<%= cat.replace(/\s+/g,'-') %>">
          <% byCategory[cat].forEach(c => { %>
            <div class="course-mini-card">
              <div class="mini-card-top">
                <span class="tag <%= c.certifyingBodyLabel ? 'tag-cert' : 'tag-skill' %>">
                  <%= c.certifyingBodyLabel ? ('🏅' + c.certifyingBodyLabel) : '⚡ Skills Mastery' %>
                </span>
                <span class="mini-duration"><%= c.durationDays %> Day<%= c.durationDays > 1 ? 's' : '' %></span>
              </div>

              <h4 class="mini-course-title"><%= c.title %></h4>
              <div style="margin:-2px 0 6px"><%- include('partials/practice-badge', { course: c }) %></div>
              <p class="mini-course-summary"><%= c.summary %></p>

              <% const cardMode = c.cardData.nextSession ? c.cardData.nextSession.mode : ((c.sessions && c.sessions.length) ? c.sessions[0].mode : 'Live Online'); %>
              <p style="font-size:.78rem;color:var(--muted);margin:-4px 0 10px" aria-label="Training mode: <%= trainingModeCategory(cardMode) %>">
                <span aria-hidden="true"><%= trainingModeSymbol(cardMode) %></span>
                <strong><%= trainingModeCategory(cardMode) %>:</strong> <%= trainingModeShort(cardMode) %>
              </p>

              <% if (!c.published) { %>
                <p style="font-size:.8rem;color:var(--muted);margin:6px 0">No Schedule</p>
              <% } else { %>
              <div class="mini-price-row">
                <div class="price-val-wrap">
                  <% if (c.cardData.pricing.isFromPrice) { %>
                    <span style="font-size:.75em;color:var(--muted);margin-right:2px">From</span>
                    <span class="price-current"><%= currencySymbol(c.currency) %><%= (c.cardData.pricing.lowestModePriceCents/100).toFixed(0) %></span>
                  <% } else { %>
                    <% if(c.cardData.pricing.discountPercent > 0){ %>
                      <span class="price-was" style="text-decoration:line-through;opacity:.55;font-size:.8em;margin-right:4px"><%= currencySymbol(c.currency) %><%= (c.cardData.pricing.originalPriceCents/100).toFixed(0) %></span>
                    <% } %>
                    <span class="price-current"><%= currencySymbol(c.currency) %><%= (c.cardData.pricing.finalPriceCents/100).toFixed(0) %></span>
                    <% if(c.cardData.pricing.discountPercent > 0){ %>
                      <span class="price-discount-pill"><%= c.cardData.pricing.discountPercent %>% OFF</span>
                    <% } %>
                  <% } %>
                </div>
                <div class="seats-status-pill">
                  <span class="status-pulse-dot"></span>
                  <span>Seats Available</span>
                </div>
              </div>
              <% } %>

              <!-- Interactive Links & Batches Elements -->
              <div class="course-mini-ctas">
                <a href="/courses/<%= c.slug %>" class="btn btn-outline btn-learn-more">
                  <span>Learn More <span class="sr-only">about <%= c.title %></span></span>
                  <svg class="cta-arrow-slide" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
                </a>
                <a href="/courses/<%= c.slug %>#sessions" class="btn btn-navy btn-batches-cta">
                  <span>Upcoming Batches <span class="sr-only">for <%= c.title %></span></span>
                  <span class="batch-count-dot">📅</span>
                </a>
              </div>
            </div>
          <% }) %>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- Sequenced learning paths -->
<% if (learningPaths && learningPaths.length > 0) { %>
<section class="section" style="background:#fff;padding-top:0">
  <div class="container">
    <div class="section-hdr center">
      <h2>Build skills that build on each other.</h2>
      <p class="lead">Follow a practical learning path from foundational knowledge to workplace application.</p>
    </div>
    <% learningPaths.forEach(path => { %>
      <div class="path-sequence-block">
        <h3 class="path-sequence-name"><%= path.name %></h3>
        <div class="path-sequence-row">
          <% path.courses.forEach((c, i) => { %>
            <% if (i > 0) { %><div class="path-sequence-arrow" aria-hidden="true">&rarr;</div><% } %>
            <a href="/courses/<%= c.slug %>" class="path-sequence-item" style="text-decoration:none;color:inherit" data-analytics-event="explore_learning_path" data-course-id="<%= c.id %>">
              <h4><%= c.title %></h4>
              <p><%= c.durationDays %> Day<%= c.durationDays > 1 ? 's' : '' %></p>
            </a>
          <% }) %>
        </div>
      </div>
    <% }) %>
  </div>
</section>
<% } %>

<!-- Upcoming Programs & Live Batches Section -->
<section class="section" style="padding-top:0;padding-bottom:0">
  <div class="container">
    <form method="GET" action="/courses" class="card course-filter-bar" style="margin-bottom:32px;padding:20px">
      <div class="form-field filter-field-search">
        <label for="home-search-q">Search</label>
        <input type="text" id="home-search-q" name="q" placeholder="Search by course name...">
      </div>
      <div class="form-field filter-field-select">
        <label for="home-search-level">Level</label>
        <select id="home-search-level" name="level">
          <% searchLevels.forEach(l => { %><option value="<%= l %>"><%= l %></option><% }) %>
        </select>
      </div>
      <div class="form-field filter-field-select">
        <label for="home-search-format">Format</label>
        <select id="home-search-format" name="format">
          <% searchFormats.forEach(f => { %><option value="<%= f %>"><%= f %></option><% }) %>
        </select>
      </div>
      <div class="form-field filter-field-select">
        <label for="home-search-certbody">Certification Body</label>
        <select id="home-search-certbody" name="certBody">
          <% searchCertBodies.forEach(b => { %>
            <% const val = b === 'All' ? 'All' : b.slug; const label = b === 'All' ? 'All' : b.name; %>
            <option value="<%= val %>"><%= label %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-field filter-field-price">
        <label for="home-search-maxprice">Max price (€)</label>
        <input type="number" id="home-search-maxprice" name="maxPrice" placeholder="Any">
      </div>
      <button type="submit" class="btn btn-navy">Search Courses</button>
    </form>
  </div>
</section>

<section class="section batches-table-section" id="upcoming-batches">
  <div class="container">
    <div class="section-hdr">
      <div class="hdr-kicker-row">
        <span class="eyebrow">Upcoming Cohorts</span>
        <span class="live-cohort-chip"><span class="pulse-green"></span> Guaranteed to Run</span>
      </div>
      <h2>Secure Your Seat in the Next Cohort</h2>
      <p class="lead">Live interactive instructor-led classes with small cohorts for high engagement.</p>
    </div>

    <div class="table-card-wrap">
      <div class="table-wrap">
        <table class="programs-table-enhanced">
          <thead>
            <tr>
              <th>Course Program</th>
              <th>Format</th>
              <th>Start Date</th>
              <th>Duration</th>
              <th>Language</th>
              <th>Price</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% upcoming.forEach(u => { %>
            <% const s = u.cardData.nextSession; %>
            <tr>
              <td>
                <div class="table-course-info">
                  <strong><%= u.course.title %></strong>
                  <span class="table-cat-sub"><%= u.course.category %></span>
                </div>
              </td>
              <td><% if (s) { %><span class="pill pill-mode"><%= trainingModeCategory(s.mode) %></span><% } else { %>—<% } %></td>
              <td>
                <div class="table-date-cell">
                  <% if (s) { %>
                    <span class="date-icon">📅</span>
                    <span><%= s.startDate %></span>
                  <% } else { %>
                    <span style="color:var(--muted)">No Schedule</span>
                  <% } %>
                </div>
              </td>
              <td><strong><%= u.course.durationDays %> Day<%= u.course.durationDays>1?'s':'' %></strong></td>
              <td><%= (s && s.language) || 'English' %></td>
              <td>
                <% if (!u.course.published) { %>
                  <span style="color:var(--muted);font-size:.85rem">—</span>
                <% } else if (u.cardData.pricing.discountPercent > 0) { %>
                  <div class="price-was" style="text-decoration:line-through;opacity:.6;font-size:.85em"><%= currencySymbol(u.course.currency) %><%= (u.cardData.pricing.originalPriceCents/100).toFixed(0) %></div>
                  <div class="price-now" style="font-weight:700"><%= currencySymbol(u.course.currency) %><%= (u.cardData.pricing.finalPriceCents/100).toFixed(0) %></div>
                  <div style="font-size:.75rem;color:#16847B;font-weight:600"><%= u.cardData.pricing.discountPercent %>% OFF</div>
                <% } else { %>
                  <div style="font-size:.7rem;color:var(--muted);text-transform:uppercase;letter-spacing:.04em">Published Price</div>
                  <div style="font-weight:700"><%= currencySymbol(u.course.currency) %><%= (u.cardData.pricing.finalPriceCents/100).toFixed(0) %></div>
                <% } %>
              </td>
              <td>
                <div class="table-action-btns">
                  <% if (u.course.published) { %>
                    <a href="/courses/<%= u.course.slug %>/register" class="btn btn-navy btn-sm">Register<span class="sr-only"> for <%= u.course.title %></span></a>
                  <% } else { %>
                    <a href="/courses/<%= u.course.slug %>#sessions" class="btn btn-navy btn-sm">I am interested<span class="sr-only"> in <%= u.course.title %></span></a>
                  <% } %>
                  <a href="/courses/<%= u.course.slug %>" class="btn btn-outline btn-sm">Details<span class="sr-only"> for <%= u.course.title %></span></a>
                </div>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

<!-- Why Baseline Skills & Pedagogy -->
