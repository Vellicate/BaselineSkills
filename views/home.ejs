<script>
function showPath(id, btn){
  document.querySelectorAll('.path-panel').forEach(p=>p.classList.remove('active'));
  document.querySelectorAll('.path-tab').forEach(t=>t.classList.remove('active'));
  const target = document.getElementById('path-'+id);
  if (target) target.classList.add('active');
  if (btn) btn.classList.add('active');
}

// Outcome cards trigger the same tab-switching as clicking a tab directly,
// then scroll the tabs/panel into view -- so "Explore Requirements
// Engineering" on an outcome card and clicking the "Requirements
// Engineering" tab always land in exactly the same state.
function selectOutcome(id, event){
  if (event) event.preventDefault();
  const tabBtn = Array.from(document.querySelectorAll('.path-tab')).find(t => t.getAttribute('onclick') && t.getAttribute('onclick').includes("'" + id + "'"));
  showPath(id, tabBtn);
  const tabsContainer = document.querySelector('.path-tabs-container');
  if (tabsContainer) tabsContainer.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

// Fire-and-forget analytics beacon for the interactions called out in the
// Phase 1 repositioning brief. Never blocks navigation and never throws --
// an ad blocker or a network hiccup here should not be able to break a CTA.
document.addEventListener('click', function(e) {
  const el = e.target.closest('[data-analytics-event]');
  if (!el) return;
  const body = { eventType: el.dataset.analyticsEvent };
  if (el.dataset.courseId) body.courseId = el.dataset.courseId;
  fetch('/analytics/event', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(body),
    keepalive: true,
  }).catch(() => {});
});
</script>

