<!-- Organizations we've trained professionals from -->
<section class="section" style="background:#f8f9fb;overflow:hidden">
  <div class="container">
    <div class="section-hdr center">
      <h2 style="font-size:1.3rem;color:var(--muted)">Professionals from leading organisations have learned with us</h2>
    </div>
  </div>
  <div class="logo-slider-track" role="list" aria-label="Organizations professionals have learned with us from">
    <% const orgs = [
      { name: "Mercedes-Benz", file: "mercedes-benz.png", w: 600, h: 370 },
