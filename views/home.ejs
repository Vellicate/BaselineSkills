<!-- Feature Learning Paths Section (Highlighted & Animated) -->
<section class="section learning-paths-section" id="outcomes">
  <div class="container">
    <div class="section-hdr center">
      <span class="eyebrow"><%= t('outcomes_eyebrow') %></span>
      <h2><%= t('outcomes_title') %></h2>
      <p class="lead"><%= t('outcomes_lead') %></p>
    </div>

    <% const categoryDisplayLabel = (cat) => cat === 'AI' ? 'Artificial Intelligence' : cat; %>
    <% const outcomeCopy = {
      "Requirements Engineering": { title: t('outcome_re_title'), desc: t('outcome_re_desc') },
      "Business Analysis": { title: t('outcome_ba_title'), desc: t('outcome_ba_desc') },
      "Systems Engineering": { title: t('outcome_se_title'), desc: t('outcome_se_desc') },
      "Business Process Modeling": { title: t('outcome_bpm_title'), desc: t('outcome_bpm_desc') },
      "Artificial Intelligence": { title: t('outcome_ai_title'), desc: t('outcome_ai_desc') },
      "AI": { title: t('outcome_ai_title'), desc: t('outcome_ai_desc') },
      "Automotive": { title: t('outcome_auto_title'), desc: t('outcome_auto_desc') },
      "Project Management": { title: t('outcome_pm_title'), desc: t('outcome_pm_desc') },
    }; %>
    <div class="outcome-grid">
      <% Object.keys(byCategory).forEach((cat) => { %>
        <% const copy = outcomeCopy[cat] || { title: categoryDisplayLabel(cat), desc: t('outcome_default_desc') }; %>
        <div class="outcome-card">
          <div class="outcome-count"><%= byCategory[cat].length %> <%= byCategory[cat].length === 1 ? t('outcome_course_singular') : t('outcome_course_plural') %></div>
          <h3><%= copy.title %></h3>
          <p><%= copy.desc %></p>
          <a href="/courses?category=<%= encodeURIComponent(cat) %>" class="btn btn-outline btn-sm" data-analytics-event="choose_outcome" data-category="<%= cat %>">
            <%= t('outcome_explore', categoryDisplayLabel(cat)) %>
          </a>
        </div>
      <% }) %>
    </div>

  </div>
</section>

<section class="section batches-table-section" id="upcoming-batches">
  <div class="container">
    <div class="section-hdr">
      <div class="hdr-kicker-row">
        <span class="eyebrow"><%= t('schedule_eyebrow') %></span>
        <span class="live-cohort-chip"><span class="pulse-green"></span> <%= t('schedule_guaranteed') %></span>
      </div>
      <h2><%= t('schedule_title') %></h2>
      <p class="lead"><%= t('schedule_lead') %></p>
      <form method="GET" action="/#upcoming-batches" style="margin-top:14px">
        <label style="display:inline-flex;align-items:center;gap:8px;font-size:.88rem;color:var(--muted);cursor:pointer">
          <input type="checkbox" name="showUnscheduled" value="true" <%= showUnscheduled ? 'checked' : '' %> onchange="this.form.submit()">
          <%= t('schedule_show_unscheduled') %>
        </label>
      </form>
    </div>

    <div class="table-card-wrap">
      <div class="table-wrap">
        <table class="programs-table-enhanced">
          <thead>
            <tr>
              <th><%= t('schedule_th_course') %></th>
              <th><%= t('schedule_th_format') %></th>
              <th style="width:160px"><%= t('schedule_th_start_date') %></th>
              <th><%= t('schedule_th_duration') %></th>
              <th><%= t('schedule_th_language') %></th>
              <th><%= t('schedule_th_price') %></th>
              <th><%= t('schedule_th_action') %></th>
            </tr>
          </thead>
          <tbody>
            <% upcoming.forEach(u => { %>
            <% const s = u.cardData.nextSession; %>
            <tr>
              <td>
                <div class="table-course-info">
                  <strong><%= u.course.title %></strong>
                  <span class="table-cat-sub"><%= u.course.category %></span>
                </div>
              </td>
              <td><% if (s) { %><span class="pill pill-mode"><%= trainingModeCategory(s.mode) %></span><% } else { %>—<% } %></td>
              <td>
                <div class="table-date-cell">
                  <% if (s) { %>
                    <span class="date-icon">📅</span>
                    <span><%= s.startDate %></span>
                  <% } else { %>
                    <span style="color:var(--muted)"><%= t('schedule_no_schedule') %></span>
                  <% } %>
                </div>
              </td>
              <td><strong><%= u.course.durationDays %> <%= u.course.durationDays>1 ? t('schedule_day_plural') : t('schedule_day_singular') %></strong></td>
              <td><%= (s && s.language) || t('schedule_default_language') %></td>
              <td>
                <% if (!u.course.published) { %>
                  <span style="color:var(--muted);font-size:.85rem">—</span>
                <% } else if (u.cardData.pricing.discountPercent > 0) { %>
                  <div style="text-decoration:line-through;opacity:.6;font-size:.85em"><%= currencySymbol(u.course.currency) %><%= (u.cardData.pricing.originalPriceCents/100).toFixed(0) %></div>
                  <div style="font-weight:700"><%= currencySymbol(u.course.currency) %><%= (u.cardData.pricing.finalPriceCents/100).toFixed(0) %></div>
                  <div style="font-size:.75rem;color:var(--gold, #D98E04);font-weight:700"><%= t('schedule_discount', u.cardData.pricing.discountPercent) %></div>
                <% } else { %>
                  <div style="font-size:.7rem;color:var(--muted);text-transform:uppercase;letter-spacing:.04em"><%= t('schedule_published_price') %></div>
                  <div style="font-weight:700"><%= currencySymbol(u.course.currency) %><%= (u.cardData.pricing.finalPriceCents/100).toFixed(0) %></div>
                <% } %>
              </td>
              <td>
                <div class="table-action-btns">
                  <% if (u.course.published) { %>
                    <a href="/courses/<%= u.course.slug %>/register" class="btn btn-navy btn-sm"><%= t('schedule_register') %><span class="sr-only"> for <%= u.course.title %></span></a>
                  <% } else { %>
                    <a href="/courses/<%= u.course.slug %>#sessions" class="btn btn-navy btn-sm"><%= t('schedule_interested') %><span class="sr-only"> in <%= u.course.title %></span></a>
                  <% } %>
                  <a href="/courses/<%= u.course.slug %>" class="btn btn-outline btn-sm"><%= t('schedule_details') %><span class="sr-only"> for <%= u.course.title %></span></a>
                </div>
              </td>
            </tr>
            <% }) %>
            <% if (upcoming.length === 0) { %>
            <tr>
              <td colspan="7" style="text-align:center;color:var(--muted);padding:32px 20px"><%= t('schedule_empty_text') %> <a href="/courses"><%= t('schedule_empty_link') %></a>.</td>
            </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

