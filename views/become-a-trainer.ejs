<%- include('partials/header') %>

<section class="section-tight" style="background:#fff;border-bottom:1px solid var(--line)">
  <div class="container">
    <span class="eyebrow"><%= t('trainer_apply_eyebrow') %></span>
    <h1 style="font-size:2.1rem"><%= t('trainer_apply_title') %></h1>
    <p class="lead"><%= t('trainer_apply_lead') %></p>
  </div>
</section>

<section class="section" style="background:#fff">
  <div class="container grid-3">
    <div>
      <h4><%= t('trainer_why_title') %></h4>
      <p style="color:var(--muted);font-size:.9rem"><%= t('trainer_why_desc') %></p>
    </div>
    <div>
      <h4><%= t('trainer_who_title') %></h4>
      <p style="color:var(--muted);font-size:.9rem"><%= t('trainer_who_desc') %></p>
    </div>
    <div>
      <h4><%= t('trainer_benefits_title') %></h4>
      <p style="color:var(--muted);font-size:.9rem"><%= t('trainer_benefits_desc') %></p>
    </div>
  </div>
</section>

<section class="section">
  <div class="container grid-2" style="align-items:start">
    <div>
      <h3><%= t('hero_howitworks_title') %></h3>
      <ol style="padding-left:20px;color:var(--muted)">
        <li><%= t('trainer_step1') %></li>
        <li><%= t('trainer_step2') %></li>
        <li><%= t('trainer_step3') %></li>
        <li><%= t('trainer_step4') %></li>
      </ol>
      <p><a href="/docs/Baseline_Skills_Rules_of_Engagement.pdf" target="_blank" class="btn btn-outline"><%= t('download_roe') %></a></p>
      <p style="font-size:.85rem;color:var(--muted)"><%- t('trainer_already_applied', '<a href="/trainer/login">' + t('trainer_login_link_text') + '</a>') %></p>
    </div>

    <div class="card">
      <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
      <form method="POST" action="/become-a-trainer/apply" enctype="multipart/form-data">
        <div class="form-field"><label><%= t('register_full_name') %> *</label><input type="text" name="name" required></div>
        <div class="form-field"><label><%= t('common_email') %> *</label><input type="email" name="email" required></div>
        <div class="form-field"><label><%= t('signup_password_label', passwordMinLength) %></label><input type="password" name="password" minlength="<%= passwordMinLength %>" required></div>
        <div class="form-field"><label><%= t('common_title_field') %></label><input type="text" name="title" placeholder="e.g. Senior Requirements Engineering Consultant"></div>
        <div class="form-field"><label><%= t('common_bio') %></label><textarea name="bio" rows="3"></textarea></div>
        <div class="form-field"><label><%= t('common_linkedin') %></label><input type="text" name="profileUrl"></div>
        <div class="form-field"><label><%= t('signed_roe_required') %></label><input type="file" name="signedRoe" accept="application/pdf" required></div>
        <button type="submit" class="btn btn-navy btn-block"><%= t('submit_application') %></button>
      </form>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
