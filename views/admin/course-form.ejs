<%- include('partials/head') %>

<h1 style="font-size:1.6rem"><%= mode === 'new' ? 'New course' : 'Edit course' %></h1>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="alert alert-error" style="margin-bottom:16px"><%= error %></div>
<% } %>

<%
  // Looks up a field's validation error (if any) from fieldErrors, passed
  // in only when the last submission failed validation — absent on a
  // normal page load, where every lookup correctly returns null.
  const fieldError = (name) => {
    const found = (typeof fieldErrors !== 'undefined' ? fieldErrors : []).find(e => e.field === name);
    return found ? found.message : null;
  };
%>

<script>
// Shared live character counter for every free-text field below. Reads
// its own max from a data attribute set server-side (from
// config/business-rules.json's courseFieldLimits) rather than a
// hardcoded number here, so the two can never silently drift apart.
function updateCharCount(el) {
  const max = Number(el.dataset.maxlen);
  const counter = document.getElementById(el.dataset.counterId);
  if (!counter) return;
  const len = el.value.length;
  counter.textContent = `${len} / ${max} characters`;
  counter.style.color = len > max ? '#b91c1c' : 'var(--muted)';
}
document.addEventListener('DOMContentLoaded', () => {
  document.querySelectorAll('[data-counter-id]').forEach(updateCharCount);
});
</script>

<form method="POST" id="course-form" action="<%= mode === 'new' ? '/admin/courses/new' : `/admin/courses/${course.id}/edit` %>" enctype="multipart/form-data" class="card" style="max-width:760px">
  <div class="form-row">
    <div class="form-field">
      <label>Title * <span style="font-weight:400;color:var(--muted)">(text, max <%= courseFieldLimits.TITLE_MAX %> characters)</span></label>
      <input type="text" name="title" required maxlength="<%= courseFieldLimits.TITLE_MAX %>" value="<%= course ? course.title : '' %>">
      <% if (fieldError('title')) { %><p style="color:#b91c1c;font-size:.82rem;margin-top:4px"><%= fieldError('title') %></p><% } %>
    </div>
    <div class="form-field">
      <label>Category *</label>
      <select name="category" required>
        <% categories.forEach(cat => { %>
          <option value="<%= cat.name %>" <%= course && course.category===cat.name ? 'selected' : '' %>><%= cat.name %></option>
        <% }) %>
      </select>
      <% if (fieldError('category')) { %><p style="color:#b91c1c;font-size:.82rem;margin-top:4px"><%= fieldError('category') %></p><% } %>
    </div>
  </div>

  <div class="form-field">
    <label>Additional categories (optional — hold Ctrl/Cmd to select multiple)</label>
    <select name="additionalCategories" multiple size="5">
      <% categories.forEach(cat => { %>
        <option value="<%= cat.name %>" <%= course && course.additionalCategories && course.additionalCategories.includes(cat.name) ? 'selected' : '' %>><%= cat.name %></option>
      <% }) %>
    </select>
    <p style="font-size:.8rem;color:var(--muted);margin-top:4px">For a course that's primarily one category but also belongs under another — e.g. AI4RE is primarily Requirements Engineering but also belongs under AI.</p>
  </div>

  <div class="form-field">
    <label>Short summary (shown on cards) * <span style="font-weight:400;color:var(--muted)">(text, max <%= courseFieldLimits.SUMMARY_MAX %> characters)</span></label>
    <input type="text" name="summary" required maxlength="<%= courseFieldLimits.SUMMARY_MAX %>" data-maxlen="<%= courseFieldLimits.SUMMARY_MAX %>" data-counter-id="count-summary" oninput="updateCharCount(this)" value="<%= course ? course.summary : '' %>">
    <span id="count-summary" style="font-size:.78rem;color:var(--muted)"></span>
    <% if (fieldError('summary')) { %><p style="color:#b91c1c;font-size:.82rem;margin-top:4px"><%= fieldError('summary') %></p><% } %>
  </div>
  <div class="form-field">
    <label>Full description * <span style="font-weight:400;color:var(--muted)">(text, max <%= courseFieldLimits.DESCRIPTION_MAX %> characters)</span></label>
    <textarea name="description" rows="5" required data-maxlen="<%= courseFieldLimits.DESCRIPTION_MAX %>" data-counter-id="count-description" oninput="updateCharCount(this)"><%= course ? course.description : '' %></textarea>
    <span id="count-description" style="font-size:.78rem;color:var(--muted)"></span>
    <% if (fieldError('description')) { %><p style="color:#b91c1c;font-size:.82rem;margin-top:4px"><%= fieldError('description') %></p><% } %>
  </div>

  <h4>Program description</h4>
  <div class="form-field">
    <label>Why take this course <span style="font-weight:400;color:var(--muted)">(text, max <%= courseFieldLimits.WHY_TAKE_THIS_COURSE_MAX %> characters)</span></label>
    <textarea name="whyTakeThisCourse" rows="3" data-maxlen="<%= courseFieldLimits.WHY_TAKE_THIS_COURSE_MAX %>" data-counter-id="count-why" oninput="updateCharCount(this)"><%= course ? course.whyTakeThisCourse : '' %></textarea>
    <span id="count-why" style="font-size:.78rem;color:var(--muted)"></span>
  </div>
  <div class="form-field">
    <label>Learning objectives (one per line) <span style="font-weight:400;color:var(--muted)">(text, max <%= courseFieldLimits.OUTCOMES_MAX %> characters total)</span></label>
    <textarea name="outcomes" rows="4" data-maxlen="<%= courseFieldLimits.OUTCOMES_MAX %>" data-counter-id="count-outcomes" oninput="updateCharCount(this)"><%= course && course.outcomes ? course.outcomes.join('\n') : '' %></textarea>
    <span id="count-outcomes" style="font-size:.78rem;color:var(--muted)"></span>
  </div>
  <div class="form-field">
    <label>Who should attend (one per line) <span style="font-weight:400;color:var(--muted)">(text, max <%= courseFieldLimits.AUDIENCE_MAX %> characters total)</span></label>
    <textarea name="audience" rows="3" data-maxlen="<%= courseFieldLimits.AUDIENCE_MAX %>" data-counter-id="count-audience" oninput="updateCharCount(this)"><%= course && course.audience ? course.audience.join('\n') : '' %></textarea>
    <span id="count-audience" style="font-size:.78rem;color:var(--muted)"></span>
  </div>
  <div class="form-field">
    <label>Prerequisites (one per line) <span style="font-weight:400;color:var(--muted)">(text, max <%= courseFieldLimits.PREREQUISITES_MAX %> characters total)</span></label>
    <textarea name="prerequisites" rows="3" placeholder="e.g. No prior RE experience required" data-maxlen="<%= courseFieldLimits.PREREQUISITES_MAX %>" data-counter-id="count-prereq" oninput="updateCharCount(this)"><%= course && course.prerequisites ? course.prerequisites.join('\n') : '' %></textarea>
    <span id="count-prereq" style="font-size:.78rem;color:var(--muted)"></span>
  </div>
  <div class="form-field">
    <label>Format &amp; material <span style="font-weight:400;color:var(--muted)">(text, max <%= courseFieldLimits.FORMAT_AND_MATERIAL_MAX %> characters)</span></label>
    <textarea name="formatAndMaterial" rows="3" placeholder="e.g. Live instructor-led sessions, printed workbook, recorded playback for 90 days" data-maxlen="<%= courseFieldLimits.FORMAT_AND_MATERIAL_MAX %>" data-counter-id="count-format" oninput="updateCharCount(this)"><%= course ? course.formatAndMaterial : '' %></textarea>
    <span id="count-format" style="font-size:.78rem;color:var(--muted)"></span>
  </div>
  <div class="form-field">
    <label>How you'll use this at work (optional) <span style="font-weight:400;color:var(--muted)">(text, max <%= courseFieldLimits.PRACTICAL_APPLICATION_MAX %> characters)</span></label>
    <textarea name="practicalApplication" rows="3" placeholder="e.g. Apply this directly in stakeholder interviews, requirement reviews, and SRS development — leave blank if not yet written" data-maxlen="<%= courseFieldLimits.PRACTICAL_APPLICATION_MAX %>" data-counter-id="count-practical" oninput="updateCharCount(this)"><%= course ? course.practicalApplication : '' %></textarea>
    <span id="count-practical" style="font-size:.78rem;color:var(--muted)"></span>
  </div>
  <div class="form-field">
    <label>What you'll receive (one per line) <span style="font-weight:400;color:var(--muted)">(text, max <%= courseFieldLimits.WHAT_YOULL_RECEIVE_MAX %> characters total)</span></label>
    <textarea name="whatYoullReceive" rows="3" placeholder="e.g. Certificate of completion&#10;Course workbook (PDF)&#10;90-day access to recordings" data-maxlen="<%= courseFieldLimits.WHAT_YOULL_RECEIVE_MAX %>" data-counter-id="count-receive" oninput="updateCharCount(this)"><%= course && course.whatYoullReceive ? course.whatYoullReceive.join('\n') : '' %></textarea>
    <span id="count-receive" style="font-size:.78rem;color:var(--muted)"></span>
  </div>
  <div class="form-field">
    <label>Course outline link <span style="font-weight:400;color:var(--muted)">(URL starting with http:// or https://, max <%= courseFieldLimits.COURSE_OUTLINE_URL_MAX %> characters)</span></label>
    <input type="url" name="courseOutlineUrl" placeholder="https://... link to a detailed outline document" maxlength="<%= courseFieldLimits.COURSE_OUTLINE_URL_MAX %>" value="<%= course ? course.courseOutlineUrl : '' %>">
    <% if (fieldError('courseOutlineUrl')) { %><p style="color:#b91c1c;font-size:.82rem;margin-top:4px"><%= fieldError('courseOutlineUrl') %></p><% } %>
  </div>

  <div class="form-field">
    <label>Trainer</label>
    <select name="trainerId">
      <option value="">— No trainer assigned —</option>
      <% trainers.forEach(t => { %>
        <option value="<%= t.id %>" <%= course && course.trainerId===t.id ? 'selected' : '' %>><%= t.name %><%= t.title ? ' — '+t.title : '' %></option>
      <% }) %>
    </select>
    <p class="form-hint"><a href="/admin/trainers/new" target="_blank">+ Add a new trainer</a> if they're not listed yet.</p>
    <% if (fieldError('trainerId')) { %><p style="color:#b91c1c;font-size:.82rem;margin-top:4px"><%= fieldError('trainerId') %></p><% } %>
  </div>

  <div class="form-field">
    <label>Brochure (PDF)</label>
    <input type="file" name="brochure" accept="application/pdf">
    <% if (course && course.brochureFilename) { %>
      <p class="form-hint">Current brochure: <a href="/brochure/<%= course.brochureFilename %>" target="_blank">view PDF</a> — upload a new file to replace it, or leave blank to keep it.</p>
    <% } %>
  </div>

  <div class="form-field">
    <label>Course contents (one module per line, format: "Module name: topic 1, topic 2") <span style="font-weight:400;color:var(--muted)">(text, max <%= courseFieldLimits.CURRICULUM_MAX %> characters total)</span></label>
    <textarea name="curriculumRaw" rows="4" placeholder="Requirements Elicitation: Techniques, Stakeholder analysis, Workshops" data-maxlen="<%= courseFieldLimits.CURRICULUM_MAX %>" data-counter-id="count-curriculum" oninput="updateCharCount(this)"><%= course && course.curriculum && course.curriculum.length ? course.curriculum.map(m => `${m.module}: ${m.topics.join(', ')}`).join('\n') : '' %></textarea>
    <span id="count-curriculum" style="font-size:.78rem;color:var(--muted)"></span>
    <p class="form-hint">Leave blank to keep the existing course contents unchanged.</p>
    <% if (fieldError('curriculumRaw')) { %><p style="color:#b91c1c;font-size:.82rem;margin-top:4px"><%= fieldError('curriculumRaw') %></p><% } %>
  </div>

  <div class="form-row">
    <div class="form-field">
      <label>Duration (days) * <span style="font-weight:400;color:var(--muted)">(whole number, greater than 0)</span></label>
      <input type="number" name="durationDays" min="1" step="1" required value="<%= course ? course.durationDays : 1 %>">
      <% if (fieldError('durationDays')) { %><p style="color:#b91c1c;font-size:.82rem;margin-top:4px"><%= fieldError('durationDays') %></p><% } %>
    </div>
    <div class="form-field"><label>Currency</label><input type="text" name="currency" value="<%= course ? course.currency : 'USD' %>"></div>
  </div>

  <div class="form-row">
    <div class="form-field">
      <label>Level *</label>

      <select name="level" required>
        <% ["Beginner","Intermediate","Expert"].forEach(l => { %>
          <option value="<%= l %>" <%= course && course.level === l ? 'selected' : '' %>><%= l %></option>
        <% }) %>
      </select>
      <% if (fieldError('level')) { %><p style="color:#b91c1c;font-size:.82rem;margin-top:4px"><%= fieldError('level') %></p><% } %>
    </div>
    <div class="form-field"><label>Course image URL</label><input type="text" name="imageUrl" placeholder="/img/courses/example.jpg" value="<%= course ? (course.imageUrl || '') : '' %>"></div>
  </div>

  <div class="form-field">
    <label>Delivery modes</label>
    <% ["Live Online","Classroom","Corporate On-site","Private Cohort","Recorded","Hybrid"].forEach(m => { %>
      <div class="checkbox-row"><input type="checkbox" name="deliveryModes" value="<%= m %>" <%= course && course.deliveryModes && course.deliveryModes.includes(m) ? 'checked' : '' %>> <label style="margin:0;font-weight:400"><%= m %></label></div>
    <% }) %>
  </div>

  <div class="form-row">
    <div class="form-field">
      <label>Price (€, before discount) * <span style="font-weight:400;color:var(--muted)">(number, 0 or greater)</span></label>
      <input type="number" step="0.01" min="0" name="price" required value="<%= course ? (course.priceCents/100).toFixed(2) : '' %>">
      <% if (fieldError('price')) { %><p style="color:#b91c1c;font-size:.82rem;margin-top:4px"><%= fieldError('price') %></p><% } %>
    </div>

  </div>

  <div class="checkbox-row" style="margin-bottom:14px"><input type="checkbox" name="certification" <%= course && course.certification ? 'checked' : '' %>> <label style="margin:0;font-weight:400">Leads to a certification</label></div>
  <div class="checkbox-row" style="margin-bottom:14px"><input type="checkbox" name="published" <%= !course || course.published ? 'checked' : '' %>> <label style="margin:0;font-weight:400">Published (visible on the public site)</label></div>

  <h4>Sessions (dates &amp; times)</h4>
  <p style="font-size:.82rem;color:var(--muted);margin-top:-8px">Start/end date format: YYYY-MM-DD, or the literal text "On Demand". Seats must be a non-negative number, or left blank if not tracked.</p>
  <% (typeof fieldErrors !== 'undefined' ? fieldErrors : []).filter(e => e.field === 'sessionStartDate' || e.field === 'sessionSeats').forEach(e => { %>
    <p style="color:#b91c1c;font-size:.82rem;margin:4px 0"><%= e.message %></p>
  <% }) %>
  <div id="sessions-wrap">
    <% const sessions = (course && course.sessions && course.sessions.length) ? course.sessions : [{startDate:'',endDate:'',timeFrom:'',timeTo:'',mode:'Live Online',seatsLeft:''}]; %>
    <% sessions.forEach(s => { %>
      <div class="form-row session-row" style="grid-template-columns:1fr 1fr 90px 90px 1fr 80px auto;align-items:end">
        <input type="hidden" name="sessionId" value="<%= s.id || '' %>">
        <div class="form-field"><label>Start date</label><input type="text" name="sessionStartDate" placeholder="2026-09-11 or 'On Demand'" value="<%= s.startDate %>"></div>
        <div class="form-field"><label>End date</label><input type="text" name="sessionEndDate" placeholder="2026-09-14" value="<%= s.endDate || '' %>"></div>
        <div class="form-field"><label>Time from</label><input type="time" name="sessionTimeFrom" value="<%= s.timeFrom || '' %>"></div>
        <div class="form-field"><label>Time to</label><input type="time" name="sessionTimeTo" value="<%= s.timeTo || '' %>"></div>
        <div class="form-field"><label>Mode</label><input type="text" name="sessionMode" value="<%= s.mode %>"></div>
        <div class="form-field"><label>Seats</label><input type="number" name="sessionSeats" value="<%= s.seatsLeft==null ? '' : s.seatsLeft %>"></div>
        <button type="button" class="btn btn-outline btn-sm" onclick="this.closest('.session-row').remove()" style="margin-bottom:18px">Remove</button>
      </div>
    <% }) %>
  </div>
  <button type="button" class="btn btn-outline btn-sm" onclick="addSessionRow()">+ Add session</button>

  <div style="margin-top:26px"><button type="submit" class="btn btn-navy btn-lg">Save course</button></div>
</form>

<% if (course && course.id) { %>
<div class="card" style="margin-top:32px">
  <h3>FAQs for this course</h3>
  <% (faqs || []).forEach(f => { %>
    <div style="display:flex;justify-content:space-between;align-items:start;padding:10px 0;border-bottom:1px solid var(--line)">
      <div>
        <strong><%= f.question %></strong>
        <p style="color:var(--muted);font-size:.9rem;margin:4px 0 0"><%= f.answer %></p>
        <span style="font-size:.8rem;color:<%= f.published ? 'green' : 'var(--muted)' %>"><%= f.published ? 'Published' : 'Unpublished' %></span>
      </div>
      <div style="display:flex;gap:6px;flex-shrink:0">
        <form method="POST" action="/admin/faqs/<%= f.id %>/move-up"><button type="submit" class="btn btn-outline btn-sm">↑</button></form>
        <form method="POST" action="/admin/faqs/<%= f.id %>/move-down"><button type="submit" class="btn btn-outline btn-sm">↓</button></form>
        <form method="POST" action="/admin/faqs/<%= f.id %>/toggle-published"><button type="submit" class="btn btn-outline btn-sm"><%= f.published ? 'Unpublish' : 'Publish' %></button></form>
        <form method="POST" action="/admin/faqs/<%= f.id %>/delete" onsubmit="return confirm('Delete this FAQ?')"><button type="submit" class="btn btn-outline btn-sm">Delete</button></form>
      </div>
    </div>
  <% }) %>
  <form method="POST" action="/admin/courses/<%= course.id %>/faqs/new" style="margin-top:16px" onsubmit="carryCourseFieldsInto(this)">
    <div class="form-field"><label>Question</label><input type="text" name="question" required></div>
    <div class="form-field"><label>Answer</label><textarea name="answer" rows="2" required></textarea></div>
    <button type="submit" class="btn btn-navy">Add FAQ</button>
  </form>
</div>
<% } %>

<script>
// The course-details form above and the FAQ/exam/material forms below it
// are separate <form> elements (HTML can't nest one form inside another),
// so submitting one never sent the other's fields — meaning any course
// detail edits typed in but not saved via "Save course" looked like they'd
// been silently reverted the moment "Add FAQ" (or Add Exam Product /
// Upload Material) was clicked, when really they were just never
// submitted at all. This copies the course form's current field values
// into the secondary form as hidden inputs right before it submits, so
// whichever button is clicked, any pending course edits travel with it.
// File inputs are skipped — a brochure upload only makes sense via
// "Save course" itself, and courseFromForm() already preserves the
// existing brochure when no new file is submitted.
function carryCourseFieldsInto(targetForm) {
  const courseForm = document.getElementById('course-form');
  if (!courseForm) return;
  Array.from(courseForm.elements).forEach((el) => {
    if (!el.name || el.type === 'file' || el.type === 'submit' || el.type === 'button') return;
    if (el.type === 'checkbox' && !el.checked) return;
    // A <select multiple> (like Additional Categories) only exposes its
    // FIRST selected value via .value — copying just that would silently
    // drop every other selection. Its real set of selected values lives
    // in .selectedOptions instead.
    if (el.tagName === 'SELECT' && el.multiple) {
      Array.from(el.selectedOptions).forEach((opt) => {
        const hidden = document.createElement('input');
        hidden.type = 'hidden';
        hidden.name = 'course_' + el.name;
        hidden.value = opt.value;
        targetForm.appendChild(hidden);
      });
      return;
    }
    const hidden = document.createElement('input');
    hidden.type = 'hidden';
    // Prefixed, not the field's own name — the target form (FAQ / exam
    // product / materials) has its own fields that can share a name with
    // a course field (both have "title" and "description", for example).
    // An earlier version of this copied fields under their original
    // names and a real test caught it: a material's own title was
    // silently overwritten by the course's title. The prefix guarantees
    // these can never collide with the target form's own inputs.
    hidden.name = 'course_' + el.name;
    hidden.value = el.value;
    targetForm.appendChild(hidden);
  });
}
</script>

<% if (course && course.id) { %>
<div class="card" style="margin-top:32px">
  <h3>Discounts for this course</h3>
  <p style="color:var(--muted);font-size:.85rem">Multiple discounts can be active at once — the highest one that's currently applicable is what learners see. A blank start date means "applicable immediately"; a blank end date means "doesn't expire until the session itself starts."</p>
  <% (courseDiscounts || []).forEach(d => { %>
    <% const applicableNow = discounts.isDiscountApplicable(d, null); %>
    <div style="display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid var(--line)">
      <div>
        <strong><%= d.label || 'Discount' %></strong> — <%= d.percent %>%
        <span style="color:var(--muted);font-size:.85rem;margin-left:8px">
          <%= d.startDate || 'immediately' %> → <%= d.endDate || 'until session start' %>
        </span>
        <span style="font-size:.8rem;color:<%= applicableNow ? 'green' : 'var(--muted)' %>;margin-left:8px"><%= applicableNow ? 'Currently active' : 'Not currently active' %></span>
      </div>
      <form method="POST" action="/admin/course-discounts/<%= d.id %>/delete" onsubmit="return confirm('Delete this discount?')"><button type="submit" class="btn btn-outline btn-sm">Delete</button></form>
    </div>
  <% }) %>
  <% if (!(courseDiscounts || []).length) { %><p style="color:var(--muted);font-size:.9rem">No discounts yet.</p><% } %>
  <form method="POST" action="/admin/courses/<%= course.id %>/discounts/new" style="margin-top:16px" onsubmit="carryCourseFieldsInto(this)">
    <div class="form-row">
      <div class="form-field"><label>Label</label><input type="text" name="label" placeholder="e.g. Summer Sale"></div>
      <div class="form-field"><label>Percent *</label><input type="number" name="percent" min="0" max="100" required></div>
    </div>
    <div class="form-row">
      <div class="form-field"><label>Start date (blank = immediately)</label><input type="date" name="startDate"></div>
      <div class="form-field"><label>End date (blank = until session start)</label><input type="date" name="endDate"></div>
    </div>
    <button type="submit" class="btn btn-navy">Add Discount</button>
  </form>
</div>
<% } %>

<% if (course && course.id) { %>
<div class="card" style="margin-top:32px">
  <h3>Certification exam for this course</h3>
  <% if (examProduct) { %>
    <p><strong><%= examProduct.certificationName %></strong> (<%= examProduct.certificationBody %>) — <%= currencySymbol(course ? course.currency : null) %><%= (examProduct.priceCents/100).toFixed(2) %></p>
    <p style="color:var(--muted);font-size:.9rem"><%= examProduct.description %></p>
    <form method="POST" action="/admin/certification-exams/<%= examProduct.id %>/delete" onsubmit="return confirm('Remove this exam product?')"><button type="submit" class="btn btn-outline btn-sm">Remove</button></form>
  <% } else { %>
  <form method="POST" action="/admin/courses/<%= course.id %>/certification-exams/new" onsubmit="carryCourseFieldsInto(this)">
    <div class="form-row">
      <div class="form-field"><label>Certification name</label><input type="text" name="certificationName" required placeholder="e.g. CPRE Foundation Level"></div>
      <div class="form-field"><label>Certification body</label><input type="text" name="certificationBody" required placeholder="e.g. IREB"></div>
    </div>
    <div class="form-row">
      <div class="form-field"><label>Exam price (€)</label><input type="number" step="0.01" name="price" required></div>
      <div class="form-field"><label>Exam provider</label><input type="text" name="examProvider" placeholder="e.g. iSQI"></div>
    </div>
    <div class="form-field"><label>Description</label><textarea name="description" rows="2"></textarea></div>
    <div class="form-field"><label>Eligibility</label><input type="text" name="eligibility" placeholder="e.g. No prerequisites"></div>
    <button type="submit" class="btn btn-navy">Add Exam Product</button>
  </form>
  <% } %>
</div>

<% if (course && course.id) { %>
<div class="card" style="margin-top:32px">
  <h3>Course materials</h3>
  <p style="color:var(--muted);font-size:.85rem">Only visible to learners with a confirmed registration for this course — never reachable through a public link.</p>
  <% (materials || []).forEach(m => { %>
    <div style="display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid var(--line)">
      <span><%= m.title %> <span style="color:var(--muted);font-size:.8rem">(<%= Math.round(m.fileSizeBytes/1024) %> KB)</span></span>
      <form method="POST" action="/admin/materials/<%= m.id %>/delete" onsubmit="return confirm('Delete this material?')"><button type="submit" class="btn btn-outline btn-sm">Delete</button></form>
    </div>
  <% }) %>
  <form method="POST" action="/admin/courses/<%= course.id %>/materials/new" enctype="multipart/form-data" style="margin-top:16px" onsubmit="carryCourseFieldsInto(this)">
    <div class="form-field"><label>Title</label><input type="text" name="title" required></div>
    <div class="form-field"><label>Description</label><input type="text" name="description"></div>
    <div class="form-field"><label>File</label><input type="file" name="file" required></div>
    <button type="submit" class="btn btn-navy">Upload Material</button>
  </form>
</div>
<% } %>
<% } %>


<script>
function addSessionRow(){
  const wrap = document.getElementById('sessions-wrap');
  const row = document.createElement('div');
  row.className = 'form-row session-row';
  row.style.gridTemplateColumns = '1fr 1fr 90px 90px 1fr 80px auto';
  row.style.alignItems = 'end';
  row.innerHTML = `
    <input type="hidden" name="sessionId" value="">
    <div class="form-field"><label>Start date</label><input type="text" name="sessionStartDate" placeholder="2026-09-11 or 'On Demand'"></div>
    <div class="form-field"><label>End date</label><input type="text" name="sessionEndDate" placeholder="2026-09-14"></div>
    <div class="form-field"><label>Time from</label><input type="time" name="sessionTimeFrom"></div>
    <div class="form-field"><label>Time to</label><input type="time" name="sessionTimeTo"></div>
    <div class="form-field"><label>Mode</label><input type="text" name="sessionMode" value="Live Online"></div>
    <div class="form-field"><label>Seats</label><input type="number" name="sessionSeats"></div>
    <button type="button" class="btn btn-outline btn-sm" onclick="this.closest('.session-row').remove()" style="margin-bottom:18px">Remove</button>`;
  wrap.appendChild(row);
}
</script>

<%- include('partials/foot') %>
