<%- include('partials/header') %>

<script type="application/ld+json">
<%- JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Course",
  "name": course.title,
  "description": course.summary,
  "provider": { "@type": "Organization", "name": "Baseline Skills", "sameAs": "https://www.baselineskills.com" },
  "hasCourseInstance": course.sessions.map(s => ({
    "@type": "CourseInstance",
    "courseMode": s.mode,
    "startDate": s.startDate,
  })),
  ...(reviewCount ? { "aggregateRating": { "@type": "AggregateRating", "ratingValue": avgRating.toFixed(1), "reviewCount": reviewCount } } : {}),
}) %>
</script>

<% if (faqs.length > 0) { %>
<script type="application/ld+json">
<%- JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": { "@type": "Answer", "text": f.answer },
  })),
}) %>
</script>
<% } %>

<script type="application/ld+json">
<%- JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Courses", "item": "https://www.baselineskills.com/courses" },
    { "@type": "ListItem", "position": 2, "name": course.title, "item": `https://www.baselineskills.com/courses/${course.slug}` },
  ],
}) %>
</script>

<section class="course-header">
  <div class="container">
    <span class="tag"><%= course.category %></span>
    <% if(course.certification){ %><span class="tag" style="margin-left:8px">Certification</span><% } %>
    <% if(certificationBody){ %><a href="/certifications/<%= certificationBody.slug %>" class="tag" style="margin-left:8px;text-decoration:none"><%= certificationBody.name %> Accredited</a><% } %>
    <h1 style="color:#fff;margin-top:14px"><%= course.title %></h1>
    <p style="color:rgba(255,255,255,.8);max-width:640px"><%= course.summary %></p>
    <div class="course-meta">
      <span><strong><%= course.durationDays %></strong> Day<%= course.durationDays>1?'s':'' %></span>
      <span><strong><%= course.deliveryModes.join(', ') %></strong></span>
      <% if (course.published) { %>
        <span><strong><%= course.sessions.length %></strong> upcoming session<%= course.sessions.length!==1?'s':'' %></span>
      <% } else { %>
        <span style="color:rgba(255,255,255,.7)">No Schedule</span>
      <% } %>
    </div>
    <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:18px">
      <% if (course.published) { %>
        <a href="/courses/<%= course.slug %>/register" class="btn btn-gold btn-lg">Register Now</a>
      <% } else { %>
        <button type="button" class="btn btn-gold btn-lg" onclick="document.getElementById('interest-modal').style.display='flex'">I am interested</button>
      <% } %>
      <% if (course.courseOutlineFilename || course.courseOutlineUrl) { %><a href="<%= course.courseOutlineFilename ? '/course-outline/'+course.courseOutlineFilename : course.courseOutlineUrl %>" target="_blank" rel="noopener" class="btn btn-outline btn-lg" style="border-color:rgba(255,255,255,.4);color:#fff">View Course Outline</a><% } %>
      <% if (course.brochureFilename) { %><button type="button" class="btn btn-outline btn-lg" style="border-color:rgba(255,255,255,.4);color:#fff" onclick="document.getElementById('brochure-modal').style.display='flex'">Download Brochure</button><% } %>
    </div>
  </div>
</section>

<div class="container course-body">
  <div>
    <h2>Course Overview</h2>
    <p style="white-space:pre-line;color:var(--text)"><%= course.description %></p>

    <h2 style="margin-top:36px">Is This Course Right For You?</h2>
    <p style="color:var(--muted)">This course is ideal for:</p>
    <div style="display:flex;flex-wrap:wrap;gap:10px;margin-bottom:16px">
      <% course.audience.forEach(a => { %><span class="pill"><%= a %></span><% }) %>
    </div>
    <% if (course.level) { %>
      <p style="color:var(--muted);font-size:.9rem">
        <% if (course.level === 'Foundation' || course.level === 'Beginner') { %>
          If you're already an experienced practitioner in this area, our Advanced-level courses may be a better fit than this Foundation-level course.
        <% } else { %>
          If you're new to this area, our Foundation-level courses are a better starting point than this Advanced-level course.
        <% } %>
      </p>
    <% } %>

    <% if (course.whyTakeThisCourse) { %>
    <h2 style="margin-top:36px">What You'll Be Able To Do</h2>
    <p style="white-space:pre-line;color:var(--text);margin-bottom:14px"><%= course.whyTakeThisCourse %></p>
    <% } else { %>
    <h2 style="margin-top:36px">What You'll Be Able To Do</h2>
    <% } %>
    <ul style="padding-left:20px;color:var(--text)">
      <% course.outcomes.forEach(o => { %><li style="margin-bottom:8px"><%= o %></li><% }) %>
    </ul>

    <h2 style="margin-top:36px">How You'll Use This At Work</h2>
    <% if (course.practicalApplication) { %>
      <p style="white-space:pre-line;color:var(--text)"><%= course.practicalApplication %></p>
    <% } else { %>
      <p class="lead">We're still writing up specific workplace examples for this course — check back soon, or ask your trainer during the course itself.</p>
    <% } %>

    <% if (course.courseOutlineContent) { %>
    <h2 style="margin-top:36px">Course Outline</h2>
    <div class="course-outline-content"><%- course.courseOutlineContent %></div>
    <style>
      /* Quill (the admin editor this content was authored in) represents a
         nested sub-bullet as a flat <li> with a ql-indent-N class, not a
         true nested <ul>/<ol> — these rules are its own indentation
         convention, needed here since this public page doesn't otherwise
         load any of Quill's CSS. */
      .course-outline-content h1, .course-outline-content h2, .course-outline-content h3 { margin: 20px 0 10px }
      .course-outline-content ul, .course-outline-content ol { padding-left: 1.4em; margin: 8px 0 }
      .course-outline-content li { margin-bottom: 4px }
      .course-outline-content .ql-indent-1 { margin-left: 3em }
      .course-outline-content .ql-indent-2 { margin-left: 6em }
      .course-outline-content .ql-indent-3 { margin-left: 9em }
      .course-outline-content .ql-indent-4 { margin-left: 12em }
    </style>
    <% } %>

    <% if (course.curriculum && course.curriculum.length) { %>
    <h2 style="margin-top:36px">Curriculum</h2>
    <% course.curriculum.forEach((mod, i) => { %>
      <div class="accordion-item <%= i===0?'open':'' %>">
        <button class="accordion-btn" onclick="this.parentElement.classList.toggle('open')">
          <span><%= mod.module %></span><span>&#9662;</span>
        </button>
        <div class="accordion-panel">
          <ul style="padding-left:18px">
            <% mod.topics.forEach(t => { %><li><%= t %></li><% }) %>
          </ul>
        </div>
      </div>
    <% }) %>
    <% } %>

    <h2 style="margin-top:36px">How You'll Learn</h2>
    <% if (course.formatAndMaterial) { %>
    <p style="white-space:pre-line;color:var(--text);margin-bottom:14px"><%= course.formatAndMaterial %></p>
    <% } %>
    <div style="display:flex;flex-wrap:wrap;gap:10px">
      <% course.deliveryModes.forEach(m => { %><span class="pill"><%= m %></span><% }) %>
    </div>

    <% if (course.prerequisites && course.prerequisites.length) { %>
    <h2 style="margin-top:36px">Before You Start</h2>
    <ul style="padding-left:20px;color:var(--text)">
      <% course.prerequisites.forEach(p => { %><li style="margin-bottom:8px"><%= p %></li><% }) %>
    </ul>
    <% } %>

    <% if (certificationBody) { %>
    <h2 style="margin-top:36px">Certification &amp; Exam</h2>
    <p style="color:var(--muted);max-width:640px">Certification follows a clear three-party structure — each party has a distinct role:</p>
    <div class="grid-3" style="margin-top:12px">
      <div class="card">
        <h4 style="margin-top:0"><%= certificationBody.name %> defines the standard</h4>
        <p style="font-size:.9rem;color:var(--muted)"><%= certificationBody.name %> sets the syllabus and quality criteria this course is built against.</p>
      </div>
      <div class="card">
        <h4 style="margin-top:0">Baseline Skills delivers the training</h4>
        <p style="font-size:.9rem;color:var(--muted)">Your instructor teaches the syllabus and prepares you for the exam — training and examination are kept separate for objectivity.</p>
      </div>
      <div class="card">
        <h4 style="margin-top:0">An independent body examines you</h4>
        <p style="font-size:.9rem;color:var(--muted)">The certification exam is administered independently of the training provider, so your result reflects your own knowledge, not the course you happened to take.</p>
      </div>
    </div>
    <p style="color:var(--muted);font-size:.85rem;margin-top:12px">Certification exam information (format, fees, retake policy) is provided separately from training details — see the Exams page or ask your trainer for the current details.</p>
    <% } %>

    <% if (course.whatYoullReceive && course.whatYoullReceive.length) { %>
    <h2 style="margin-top:36px">What You'll Get With Baseline Skills</h2>
    <ul style="padding-left:20px;color:var(--text)">
      <% course.whatYoullReceive.forEach(w => { %><li style="margin-bottom:8px"><%= w %></li><% }) %>
    </ul>
    <% } %>

    <% if (materials.length) { %>
    <h2 style="margin-top:36px">Course Materials</h2>
    <% if (hasAccessToMaterials) { %>
      <div class="grid-3">
        <% materials.forEach(m => { %>
          <div class="card">
            <h4><%= m.title %></h4>
            <% if (m.description) { %><p style="font-size:.85rem;color:var(--muted);white-space:pre-line"><%= m.description %></p><% } %>
            <a href="/courses/<%= course.slug %>/materials/<%= m.id %>/download" class="btn btn-outline btn-sm">Download</a>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <p class="lead"><%= materials.length %> material<%= materials.length !== 1 ? 's' : '' %> available to registered learners — <a href="/courses/<%= course.slug %>/register">register for this course</a> to access them.</p>
    <% } %>
    <% } %>

    <% if (trainer) { %>
    <h2 style="margin-top:36px">Your Trainer</h2>
    <div class="card" style="max-width:420px;display:flex;gap:14px;align-items:flex-start">
      <% if (trainer.photoPath) { %>
        <img src="<%= trainer.photoPath %>" alt="<%= trainer.name %>" style="width:56px;height:56px;border-radius:50%;object-fit:cover;flex-shrink:0">
      <% } else { %>
        <div style="width:56px;height:56px;border-radius:50%;background:var(--navy,#0F5C56);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;flex-shrink:0"><%= trainer.name.split(' ').map(n => n[0]).slice(0,2).join('').toUpperCase() %></div>
      <% } %>
      <div>
        <h4 style="margin:0"><%= trainer.name %></h4>
        <% if (trainer.title) { %><p style="color:var(--muted);font-size:.9rem;margin:4px 0 10px"><%= trainer.title %></p><% } %>
        <% if (trainer.bio) { %><p style="font-size:.9rem;white-space:pre-line"><%= trainer.bio.slice(0, 220) %><%= trainer.bio.length > 220 ? '…' : '' %></p><% } %>
        <a href="/trainers/<%= trainer.id %>" class="btn btn-outline btn-sm">View Full Profile</a>
      </div>
    </div>
    <% } %>

    <% if (reviewCount) { %>
    <h2 style="margin-top:36px" id="reviews">Learner Experiences</h2>
    <% if (reviewCount >= 5) { %>
    <p style="font-weight:600">⭐ <%= avgRating.toFixed(1) %> / 5 <span style="font-weight:400;color:var(--muted);font-size:.9rem">(<%= reviewCount %> learners)</span></p>
    <% if (reviews.length >= 5) { %>
    <div style="margin-bottom:16px">
      <% ratingDistribution.forEach(d => { %>
        <div style="display:flex;align-items:center;gap:8px;font-size:.85rem;color:var(--muted)">
          <span style="width:40px"><%= d.star %> star</span>
          <div style="background:var(--line);border-radius:4px;height:8px;width:140px;overflow:hidden"><div style="background:gold;height:100%;width:<%= reviews.length ? (d.count/reviews.length*100) : 0 %>%"></div></div>
          <span><%= d.count %></span>
        </div>
      <% }) %>
    </div>
    <% } %>
    <% } %>
    <% reviews.slice(0, 5).forEach(r => { %>
      <div class="card" style="margin-bottom:10px">
        <p style="font-weight:600">⭐ <%= r.rating %>/5</p>
        <% if (r.comment) { %><p style="color:var(--muted);font-size:.9rem;white-space:pre-line"><%= r.comment %></p><% } %>
      </div>
    <% }) %>
    <% } else { %>
    <h2 style="margin-top:36px" id="reviews">Learner Experiences</h2>
    <p class="lead">No reviews yet.</p>
    <% } %>

    <% if (canReview) { %>
    <div class="card" style="margin-top:16px">
      <h4>Leave a review</h4>
      <form method="POST" action="/courses/<%= course.slug %>/review">
        <div class="form-field">
          <label>Rating</label>
          <select name="rating" required>
            <% [5,4,3,2,1].forEach(n => { %><option value="<%= n %>"><%= n %> star<%= n!==1?'s':'' %></option><% }) %>
          </select>
        </div>
        <div class="form-field"><label>Comment (optional)</label><textarea name="comment" rows="2"></textarea></div>
        <button type="submit" class="btn btn-navy">Submit Review</button>
      </form>
    </div>
    <% } %>

    <% if (faqs.length) { %>
    <h2 style="margin-top:36px">Frequently Asked Questions</h2>
    <div class="faq-accordion">
      <% faqs.forEach((f, i) => { %>
        <details class="card" style="margin-bottom:10px;cursor:pointer">
          <summary style="font-weight:600;list-style:none"><%= f.question %></summary>
          <p style="margin-top:10px;color:var(--muted);white-space:pre-line"><%= f.answer %></p>
        </details>
      <% }) %>
    </div>
    <% } %>

    <% if (related.length) { %>
    <h2 style="margin-top:36px">Where Do You Go Next?</h2>
    <div class="grid-3">
      <% related.forEach(r => { %>
        <div class="card">
          <h4><%= r.title %></h4>
          <p style="font-size:.85rem;color:var(--muted);flex:1"><%= r.summary %></p>
          <a href="/courses/<%= r.slug %>" class="btn btn-outline btn-sm">Learn More</a>
        </div>
      <% }) %>
    </div>
    <% } %>
  </div>

  <div>
    <div class="sticky-card" id="sessions">
      <% if (course.published) { %>
        <div class="price-row">
          <div class="price-now"><%= currencySymbol(course.currency) %><%= (cardData.pricing.finalPriceCents/100).toFixed(0) %></div>
          <% if(cardData.pricing.discountPercent > 0){ %>
            <div class="price-was"><%= currencySymbol(course.currency) %><%= (cardData.pricing.originalPriceCents/100).toFixed(0) %></div>
            <div class="price-savings" style="color:#16847B;font-size:.85rem;font-weight:600">You save <%= currencySymbol(course.currency) %><%= ((cardData.pricing.originalPriceCents-cardData.pricing.finalPriceCents)/100).toFixed(0) %></div>
          <% } %>
        </div>
        <% if(cardData.pricing.discountPercent > 0){ %><span class="discount-badge"><%= cardData.pricing.discountPercent %>% OFF</span><% } %>
        <p class="form-hint" style="margin-top:10px">per person &middot; <%= course.currency %></p>
        <a href="/courses/<%= course.slug %>/register" class="btn btn-gold btn-block" style="margin-top:14px">Register Now</a>
      <% } else { %>
        <p style="color:var(--muted);font-size:.9rem;margin-top:0">This course is being finalized — pricing and scheduling aren't confirmed yet. Let us know you're interested and we'll be in touch as soon as it's ready.</p>
        <button type="button" class="btn btn-gold btn-block" onclick="document.getElementById('interest-modal').style.display='flex'">I am interested</button>
      <% } %>
      <a href="/contact" class="btn btn-outline btn-block" style="margin-top:10px">Corporate Inquiry</a>
      <% if (course.brochureFilename) { %>
        <button type="button" class="btn btn-outline btn-block" style="margin-top:10px" onclick="document.getElementById('brochure-modal').style.display='flex'">Download Brochure</button>
      <% } %>

      <h4 style="margin-top:24px;font-size:.95rem">Upcoming Sessions</h4>
      <% if (!course.published) { %>
        <p style="color:var(--muted);font-size:.9rem">No Schedule</p>
      <% } else { %>
      <div class="form-field" style="margin-bottom:10px">
        <label style="font-size:.82rem">Show times in</label>
        <select id="session-tz-select" onchange="applySessionTimezone(this.value)">
          <option value="Etc/GMT-2" selected>Central European Summer Time (CEST)</option>
          <option value="Etc/GMT">Greenwich Mean Time (GMT)</option>
          <option value="Europe/London">UK Time (London)</option>
          <option value="America/New_York">Eastern Time (US)</option>
          <option value="America/Chicago">Central Time (US)</option>
          <option value="America/Los_Angeles">Pacific Time (US)</option>
          <option value="Asia/Kolkata">India Standard Time (IST)</option>
          <option value="Asia/Dubai">Gulf Standard Time (Dubai)</option>
          <option value="Asia/Singapore">Singapore Time</option>
          <option value="Asia/Tokyo">Japan Standard Time</option>
          <option value="Australia/Sydney">Australian Eastern Time (Sydney)</option>
        </select>
      </div>
      <ul class="session-list">
        <% course.sessions.forEach(s => { %>
          <li>
            <span>
              <%= s.startDate %><%= s.endDate ? ' – ' + s.endDate : '' %> &middot; <%= s.mode %>
              <% if (s.timeFrom || s.timeTo) { %><br><span class="session-time-display" style="font-size:.8rem;color:var(--muted)" data-date="<%= s.startDate %>" data-time-from="<%= s.timeFrom || '' %>" data-time-to="<%= s.timeTo || '' %>"><%= s.timeFrom || '?' %>–<%= s.timeTo || '?' %></span><% } %>
            </span>
            <span><%= s.seatsLeft!=null ? s.seatsLeft+' seats left' : 'On request' %></span>
          </li>
        <% }) %>
      </ul>
      <script>
        // Session times are stored in CEST (a fixed UTC+2 offset — the
        // "summer" variant specifically, not the DST-aware Europe/Berlin
        // zone, per how these were entered). Building an explicit
        // +02:00-offset timestamp for the stored date+time gives the
        // correct absolute moment regardless of the visitor's own
        // browser timezone; Intl.DateTimeFormat then renders that same
        // moment correctly in whichever target zone they pick, DST and
        // all, without this code needing to know DST rules itself.
        function applySessionTimezone(target) {
          document.querySelectorAll('.session-time-display').forEach((el) => {
            const date = el.dataset.date;
            const from = el.dataset.timeFrom;
            const to = el.dataset.timeTo;
            if (!date || (!from && !to)) return;
            const fmt = (t) => {
              if (!t) return '?';
              // Stored times are always CEST (fixed UTC+2) — building the
              // source timestamp with that offset every time, regardless
              // of which target is selected, gives the correct absolute
              // moment; only the target passed to Intl.DateTimeFormat
              // changes which zone that moment gets displayed in.
              const d = new Date(`${date}T${t}:00+02:00`);
              if (isNaN(d.getTime())) return t;
              return new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', hour12: false, timeZone: target }).format(d);
            };
            el.textContent = `${fmt(from)}–${fmt(to)}`;
          });
        }
      </script>
      <% } %>
    </div>
  </div>
</div>

<% if (course.brochureFilename) { %>
<div id="brochure-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:1000;align-items:center;justify-content:center">
  <div class="card" style="max-width:420px;width:90%;background:#fff">
    <h3 style="margin-top:0">Get the Brochure</h3>
    <p style="color:var(--muted);font-size:.9rem">Enter your email and we'll send you the download link right away.</p>
    <div id="brochure-form-area">
      <div class="form-field"><label>Email address</label><input type="email" id="brochure-email" placeholder="you@company.com"></div>
      <div id="brochure-error" class="alert alert-error" style="display:none;margin-bottom:14px"></div>
      <button type="button" class="btn btn-gold btn-block" onclick="submitBrochureRequest()">Send Me the Brochure</button>
    </div>
    <div id="brochure-success" style="display:none">
      <div class="alert alert-success">Check your inbox — the brochure link is on its way.</div>
    </div>
    <button type="button" class="btn btn-outline btn-block" style="margin-top:10px" onclick="document.getElementById('brochure-modal').style.display='none'">Close</button>
  </div>
</div>
<script>
async function submitBrochureRequest() {
  const email = document.getElementById('brochure-email').value.trim();
  const errorBox = document.getElementById('brochure-error');
  errorBox.style.display = 'none';
  try {
    const res = await fetch('/courses/<%= course.slug %>/brochure', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email }),
    });
    const data = await res.json();
    if (!res.ok) {
      errorBox.textContent = data.error || 'Something went wrong. Please try again.';
      errorBox.style.display = 'block';
      return;
    }
    document.getElementById('brochure-form-area').style.display = 'none';
    document.getElementById('brochure-success').style.display = 'block';
  } catch (e) {
    errorBox.textContent = 'Network error — please try again.';
    errorBox.style.display = 'block';
  }
}
</script>
<% } %>

<% if (!course.published) { %>
<div id="interest-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:1000;align-items:center;justify-content:center">
  <div class="card" style="max-width:460px;width:90%;background:#fff;max-height:90vh;overflow-y:auto">
    <h3 style="margin-top:0">I'm Interested</h3>
    <p style="color:var(--muted);font-size:.9rem">This course is still being finalized. Tell us a bit about you and we'll reach out as soon as it's scheduled.</p>
    <div id="interest-form-area">
      <div class="form-field"><label>Course</label><input type="text" value="<%= course.title %>" disabled style="background:var(--bg)"></div>
      <div class="form-field"><label>Name *</label><input type="text" id="interest-name" required></div>
      <div class="form-field"><label>Email *</label><input type="email" id="interest-email" required></div>
      <div class="form-field"><label>Phone</label><input type="text" id="interest-phone"></div>
      <div class="form-field"><label>Company</label><input type="text" id="interest-company"></div>
      <div class="form-field"><label>Team size</label><input type="text" id="interest-teamSize" placeholder="e.g. Just me, or a group of 5"></div>
      <div class="form-field">
        <label>Preferred delivery mode</label>
        <select id="interest-deliveryMode">
          <option value="">No preference</option>
          <% course.deliveryModes.forEach(m => { %><option value="<%= m %>"><%= m %></option><% }) %>
        </select>
      </div>
      <div class="form-field"><label>Message (optional)</label><textarea id="interest-message" rows="3"></textarea></div>
      <div id="interest-error" class="alert alert-error" style="display:none;margin-bottom:14px"></div>
      <button type="button" class="btn btn-gold btn-block" onclick="submitInterestRequest()">Send</button>
    </div>
    <div id="interest-success" style="display:none">
      <div class="alert alert-success">Thanks — we've got your details and will be in touch as soon as this course is scheduled.</div>
    </div>
    <button type="button" class="btn btn-outline btn-block" style="margin-top:10px" onclick="document.getElementById('interest-modal').style.display='none'">Close</button>
  </div>
</div>
<script>
async function submitInterestRequest() {
  const name = document.getElementById('interest-name').value.trim();
  const email = document.getElementById('interest-email').value.trim();
  const errorBox = document.getElementById('interest-error');
  errorBox.style.display = 'none';
  try {
    const res = await fetch('/courses/<%= course.slug %>/interest', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        name, email,
        phone: document.getElementById('interest-phone').value.trim(),
        company: document.getElementById('interest-company').value.trim(),
        teamSize: document.getElementById('interest-teamSize').value.trim(),
        deliveryMode: document.getElementById('interest-deliveryMode').value,
        message: document.getElementById('interest-message').value.trim(),
      }),
    });
    const data = await res.json();
    if (!res.ok) {
      errorBox.textContent = data.error || 'Something went wrong. Please try again.';
      errorBox.style.display = 'block';
      return;
    }
    document.getElementById('interest-form-area').style.display = 'none';
    document.getElementById('interest-success').style.display = 'block';
  } catch (e) {
    errorBox.textContent = 'Something went wrong. Please try again.';
    errorBox.style.display = 'block';
  }
}
</script>
<% } %>

<%- include('partials/footer') %>
