<%- include('partials/header') %>

<script type="application/ld+json">
<%- JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Course",
  "name": course.title,
  "description": course.summary,
  "provider": { "@type": "Organization", "name": "Baseline Skills", "sameAs": "https://www.baselineskills.com" },
  "hasCourseInstance": course.sessions
    .filter(s => s.startDate && s.startDate !== "On Demand" && !isNaN(new Date(s.startDate).getTime()) && !["Corporate On-site", "Private Cohort"].includes(s.mode))
    .map(s => ({
      "@type": "CourseInstance",
      "courseMode": s.mode,
      "startDate": s.startDate,
    })),
  ...(reviewCount ? { "aggregateRating": { "@type": "AggregateRating", "ratingValue": avgRating.toFixed(1), "reviewCount": reviewCount } } : {}),
}) %>
</script>

<% if (faqs.length > 0) { %>
<script type="application/ld+json">
<%- JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": { "@type": "Answer", "text": f.answer },
  })),
}) %>
</script>
<% } %>

<script type="application/ld+json">
<%- JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Courses", "item": "https://www.baselineskills.com/courses" },
    { "@type": "ListItem", "position": 2, "name": course.title, "item": `https://www.baselineskills.com/courses/${course.slug}` },
  ],
}) %>
</script>

<section class="course-header">
  <div class="container">
    <span class="tag"><%= course.category %></span>
    <% if(course.certification){ %><span class="tag" style="margin-left:8px"><%= t('course_certification_tag') %></span><% } %>
    <% if(certificationBody){ %><a href="/certifications/<%= certificationBody.slug %>" class="tag" style="margin-left:8px;text-decoration:none"><%= t('course_accredited', certificationBody.name) %></a><% } %>
    <h1 style="color:#fff;margin-top:14px"><%= course.title %></h1>
    <p style="color:rgba(255,255,255,.8);max-width:640px"><%= course.summary %></p>
    <div class="course-meta">
      <span><strong><%= course.durationDays %></strong> <%= course.durationDays>1 ? t('schedule_day_plural') : t('schedule_day_singular') %></span>
      <span><strong><%= course.deliveryModes.join(', ') %></strong></span>
      <% if (course.published) { %>
        <span><strong><%= course.sessions.length %></strong> <%= course.sessions.length!==1 ? t('course_upcoming_session_plural') : t('course_upcoming_session_singular') %></span>
      <% } else { %>
        <span style="color:rgba(255,255,255,.7)"><%= t('schedule_no_schedule') %></span>
      <% } %>
    </div>
    <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:18px">
      <% if (inquiryOnlyCourse) { %>
        <a href="<%= deliveryOfferings[0].ctaUrl %>" class="btn btn-gold btn-lg"><%= t(deliveryOfferings[0].ctaLabelKey) %></a>
      <% } else if (course.published) { %>
        <a href="/courses/<%= course.slug %>/register" class="btn btn-gold btn-lg"><%= t('course_register_now') %></a>
      <% } else { %>
        <button type="button" class="btn btn-gold btn-lg" onclick="document.getElementById('interest-modal').style.display='flex'"><%= t('schedule_interested') %></button>
      <% } %>
      <% if (course.courseOutlineFilename || course.courseOutlineUrl) { %><a href="<%= course.courseOutlineFilename ? '/course-outline/'+course.courseOutlineFilename : course.courseOutlineUrl %>" target="_blank" rel="noopener" class="btn btn-outline btn-lg" style="border-color:rgba(255,255,255,.4);color:#fff"><%= t('course_view_outline') %></a><% } %>
      <% if (course.brochureFilename) { %><button type="button" class="btn btn-outline btn-lg" style="border-color:rgba(255,255,255,.4);color:#fff" onclick="document.getElementById('brochure-modal').style.display='flex'"><%= t('course_download_brochure') %></button><% } %>
    </div>
  </div>
</section>

<div class="container course-body">
  <div>
    <h2><%= t('course_overview_title') %></h2>
    <p style="white-space:pre-line;color:var(--text)"><%= course.description %></p>

    <h2 style="margin-top:36px"><%= t('course_right_for_you_title') %></h2>
    <p style="color:var(--muted)"><%= t('course_ideal_for') %></p>
    <div style="display:flex;flex-wrap:wrap;gap:10px;margin-bottom:16px">
      <% course.audience.forEach(a => { %><span class="pill"><%= a %></span><% }) %>
    </div>
    <% if (course.level) { %>
      <p style="color:var(--muted);font-size:.9rem">
        <% if (course.level === 'Foundation' || course.level === 'Beginner') { %>
          <%= t('course_foundation_note') %>
        <% } else { %>
          <%= t('course_advanced_note') %>
        <% } %>
      </p>
    <% } %>

    <% if (course.whyTakeThisCourse) { %>
    <h2 style="margin-top:36px"><%= t('course_what_youll_do_title') %></h2>
    <p style="white-space:pre-line;color:var(--text);margin-bottom:14px"><%= course.whyTakeThisCourse %></p>
    <% } else { %>
    <h2 style="margin-top:36px"><%= t('course_what_youll_do_title') %></h2>
    <% } %>
    <ul style="padding-left:20px;color:var(--text)">
      <% course.outcomes.forEach(o => { %><li style="margin-bottom:8px"><%= o %></li><% }) %>
    </ul>

    <h2 style="margin-top:36px"><%= t('course_how_youll_use_title') %></h2>
    <% if (course.practicalApplication) { %>
      <p style="white-space:pre-line;color:var(--text)"><%= course.practicalApplication %></p>
    <% } else { %>
      <p class="lead"><%= t('course_no_practical_examples') %></p>
    <% } %>

    <% if (course.courseOutlineContent) { %>
    <h2 style="margin-top:36px"><%= t('course_outline_title') %></h2>
    <div class="course-outline-content"><%- course.courseOutlineContent %></div>
    <style>
      /* Quill (the admin editor this content was authored in) represents a
         nested sub-bullet as a flat <li> with a ql-indent-N class, not a
         true nested <ul>/<ol> — these rules are its own indentation
         convention, needed here since this public page doesn't otherwise
         load any of Quill's CSS. */
      .course-outline-content h1, .course-outline-content h2, .course-outline-content h3 { margin: 20px 0 10px }
      .course-outline-content ul, .course-outline-content ol { padding-left: 1.4em; margin: 8px 0 }
      .course-outline-content li { margin-bottom: 4px }
      .course-outline-content .ql-indent-1 { margin-left: 3em }
      .course-outline-content .ql-indent-2 { margin-left: 6em }
      .course-outline-content .ql-indent-3 { margin-left: 9em }
      .course-outline-content .ql-indent-4 { margin-left: 12em }
    </style>
    <% } %>

    <% if (course.curriculum && course.curriculum.length) { %>
    <h2 style="margin-top:36px"><%= t('course_curriculum_title') %></h2>
    <% course.curriculum.forEach((mod, i) => { %>
      <div class="accordion-item <%= i===0?'open':'' %>">
        <button class="accordion-btn" onclick="this.parentElement.classList.toggle('open')">
          <span><%= mod.module %></span><span>&#9662;</span>
        </button>
        <div class="accordion-panel">
          <ul style="padding-left:18px">
            <% mod.topics.forEach(t => { %><li><%= t %></li><% }) %>
          </ul>
        </div>
      </div>
    <% }) %>
    <% } %>

    <h2 style="margin-top:36px"><%= t('course_how_youll_learn_title') %></h2>
    <% if (course.formatAndMaterial) { %>
    <p style="white-space:pre-line;color:var(--text);margin-bottom:14px"><%= course.formatAndMaterial %></p>
    <% } %>
    <div style="display:flex;flex-wrap:wrap;gap:10px">
      <% course.deliveryModes.forEach(m => { %><span class="pill"><%= m %></span><% }) %>
    </div>

    <% if (course.prerequisites && course.prerequisites.length) { %>
    <h2 style="margin-top:36px"><%= t('course_before_you_start_title') %></h2>
    <ul style="padding-left:20px;color:var(--text)">
      <% course.prerequisites.forEach(p => { %><li style="margin-bottom:8px"><%= p %></li><% }) %>
    </ul>
    <% } %>

    <% if (certificationBody) { %>
    <h2 style="margin-top:36px"><%- t('course_cert_exam_title') %></h2>
    <p style="color:var(--muted);max-width:640px"><%= t('course_cert_structure_intro') %></p>
    <div class="grid-3" style="margin-top:12px">
      <div class="card">
        <h4 style="margin-top:0"><%= t('course_cert_defines_standard', certificationBody.name) %></h4>
        <p style="font-size:.9rem;color:var(--muted)"><%= t('course_cert_defines_standard_desc', certificationBody.name) %></p>
      </div>
      <div class="card">
        <h4 style="margin-top:0"><%= t('course_cert_delivers_training') %></h4>
        <p style="font-size:.9rem;color:var(--muted)"><%= t('course_cert_delivers_training_desc') %></p>
      </div>
      <div class="card">
        <h4 style="margin-top:0"><%= t('course_cert_independent_body') %></h4>
        <p style="font-size:.9rem;color:var(--muted)"><%= t('course_cert_independent_body_desc') %></p>
      </div>
    </div>
    <p style="color:var(--muted);font-size:.85rem;margin-top:12px"><%= t('course_exam_info_note') %></p>
    <% } %>

    <% if (course.whatYoullReceive && course.whatYoullReceive.length) { %>
    <h2 style="margin-top:36px"><%= t('course_what_youll_receive_title') %></h2>
    <ul style="padding-left:20px;color:var(--text)">
      <% course.whatYoullReceive.forEach(w => { %><li style="margin-bottom:8px"><%= w %></li><% }) %>
    </ul>
    <% } %>

    <% if (materials.length) { %>
    <h2 style="margin-top:36px"><%= t('course_materials_title') %></h2>
    <% if (hasAccessToMaterials) { %>
      <div class="grid-3">
        <% materials.forEach(m => { %>
          <div class="card">
            <h4><%= m.title %></h4>
            <% if (m.description) { %><p style="font-size:.85rem;color:var(--muted);white-space:pre-line"><%= m.description %></p><% } %>
            <% if (m.downloadable) { %>
              <a href="/courses/<%= course.slug %>/materials/<%= m.id %>/download" class="btn btn-outline btn-sm"><%= t('course_download') %></a>
            <% } else { %>
              <a href="/courses/<%= course.slug %>/materials/<%= m.id %>/view" target="_blank" rel="noopener" class="btn btn-outline btn-sm"><%= t('course_view') %></a>
            <% } %>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <p class="lead"><%= materials.length %> <%= materials.length !== 1 ? t('course_material_plural') : t('course_material_singular') %> <%= t('course_materials_locked_text') %> <a href="/courses/<%= course.slug %>/register"><%= t('course_materials_register_link') %></a>.</p>
    <% } %>
    <% } %>

    <% if (trainer) { %>
    <h2 style="margin-top:36px"><%= t('course_your_trainer_title') %></h2>
    <div class="card" style="max-width:420px;display:flex;gap:14px;align-items:flex-start">
      <% if (trainer.photoPath) { %>
        <img src="<%= trainer.photoPath %>" alt="<%= trainer.name %>" style="width:56px;height:56px;border-radius:50%;object-fit:cover;flex-shrink:0">
      <% } else { %>
        <div style="width:56px;height:56px;border-radius:50%;background:var(--navy,#0F5C56);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;flex-shrink:0"><%= trainer.name.split(' ').map(n => n[0]).slice(0,2).join('').toUpperCase() %></div>
      <% } %>
      <div>
        <h4 style="margin:0"><%= trainer.name %></h4>
        <% if (trainer.title) { %><p style="color:var(--muted);font-size:.9rem;margin:4px 0 10px"><%= trainer.title %></p><% } %>
        <% if (trainer.bio) { %><p style="font-size:.9rem;white-space:pre-line"><%= trainer.bio.slice(0, 220) %><%= trainer.bio.length > 220 ? '…' : '' %></p><% } %>
        <a href="/trainers/<%= trainer.id %>" class="btn btn-outline btn-sm"><%= t('course_view_full_profile') %></a>
      </div>
    </div>
    <% } %>

    <% if (reviewCount) { %>
    <h2 style="margin-top:36px" id="reviews"><%= t('course_learner_experiences_title') %></h2>
    <% if (reviewCount >= 5) { %>
    <p style="font-weight:600">⭐ <%= avgRating.toFixed(1) %> / 5 <span style="font-weight:400;color:var(--muted);font-size:.9rem">(<%= reviewCount %> <%= t('courses_learner_plural') %>)</span></p>
    <% if (reviews.length >= 5) { %>
    <div style="margin-bottom:16px">
      <% ratingDistribution.forEach(d => { %>
        <div style="display:flex;align-items:center;gap:8px;font-size:.85rem;color:var(--muted)">
          <span style="width:40px"><%= d.star %> <%= t('course_star_label') %></span>
          <div style="background:var(--line);border-radius:4px;height:8px;width:140px;overflow:hidden"><div style="background:gold;height:100%;width:<%= reviews.length ? (d.count/reviews.length*100) : 0 %>%"></div></div>
          <span><%= d.count %></span>
        </div>
      <% }) %>
    </div>
    <% } %>
    <% } %>
    <% reviews.slice(0, 5).forEach(r => { %>
      <div class="card" style="margin-bottom:10px">
        <p style="font-weight:600">⭐ <%= r.rating %>/5</p>
        <% if (r.comment) { %><p style="color:var(--muted);font-size:.9rem;white-space:pre-line"><%= r.comment %></p><% } %>
      </div>
    <% }) %>
    <% } else { %>
    <h2 style="margin-top:36px" id="reviews"><%= t('course_learner_experiences_title') %></h2>
    <p class="lead"><%= t('course_no_reviews') %></p>
    <% } %>

    <% if (canReview) { %>
    <div class="card" style="margin-top:16px">
      <h4><%= t('course_leave_review_title') %></h4>
      <form method="POST" action="/courses/<%= course.slug %>/review">
        <div class="form-field">
          <label><%= t('common_rating') %></label>
          <select name="rating" required>
            <% [5,4,3,2,1].forEach(n => { %><option value="<%= n %>"><%= n %> <%= n!==1 ? t('course_star_plural') : t('course_star_singular') %></option><% }) %>
          </select>
        </div>
        <div class="form-field"><label><%= t('common_comment_optional') %></label><textarea name="comment" rows="2"></textarea></div>
        <button type="submit" class="btn btn-navy"><%= t('course_submit_review') %></button>
      </form>
    </div>
    <% } %>

    <% if (faqs.length) { %>
    <h2 style="margin-top:36px"><%= t('course_faq_title') %></h2>
    <div class="faq-accordion">
      <% faqs.forEach((f, i) => { %>
        <details class="card" style="margin-bottom:10px;cursor:pointer">
          <summary style="font-weight:600;list-style:none"><%= f.question %></summary>
          <p style="margin-top:10px;color:var(--muted);white-space:pre-line"><%= f.answer %></p>
        </details>
      <% }) %>
    </div>
    <% } %>

    <% if (related.length) { %>
    <h2 style="margin-top:36px"><%= t('course_where_next_title') %></h2>
    <div class="grid-3">
      <% related.forEach(r => { %>
        <div class="card">
          <h4><%= r.title %></h4>
          <p style="font-size:.85rem;color:var(--muted);flex:1"><%= r.summary %></p>
          <a href="/courses/<%= r.slug %>" class="btn btn-outline btn-sm"><%= t('course_learn_more') %></a>
        </div>
      <% }) %>
    </div>
    <% } %>
  </div>

  <div>
    <% if (course.published && deliveryOfferings.length > 1) { %>
      <!-- Part 19: only shown when the course actually has more than one
           configured delivery mode -- a single-mode course already has a
           clear price in the card below, and a one-row "comparison" table
           would just be visual noise on top of it. -->
      <div class="card" style="margin-bottom:20px;padding:20px">
        <h3 style="margin-top:0;font-size:1.05rem"><%= t('course_choose_how_learn') %></h3>
        <table style="width:100%;font-size:.9rem;border-collapse:collapse">
          <thead>
            <tr style="text-align:left;color:var(--muted);border-bottom:1px solid var(--line)">
              <th style="padding:8px 4px"><%= t('common_delivery') %></th><th style="padding:8px 4px"><%= t('common_schedule') %></th><th style="padding:8px 4px"><%= t('schedule_th_price') %></th><th></th>
            </tr>
          </thead>
          <tbody>
            <% deliveryOfferings.forEach(o => { %>
              <tr style="border-bottom:1px solid var(--line)">
                <td style="padding:10px 4px;font-weight:600"><%= o.mode %></td>
                <td style="padding:10px 4px;color:var(--muted)"><%= o.scheduleDates || t(o.scheduleKey) %></td>
                <td style="padding:10px 4px"><%= o.priceLabelKey ? t(o.priceLabelKey) : o.priceLabel %></td>
                <td style="padding:10px 4px;text-align:right"><a href="<%= o.ctaUrl %>" class="btn <%= o.isInquiry ? 'btn-outline' : 'btn-navy' %> btn-sm"><%= t(o.ctaLabelKey) %></a></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
    <div class="sticky-card" id="sessions">
      <% if (inquiryOnlyCourse) { %>
        <!-- Part 1E/1F: this course's only configured delivery mode is
             Corporate On-site or Private Cohort -- no purchase price, no
             payment CTA at all, ever, not even a single-mode "shortcut"
             around the comparison table above (which doesn't render for
             a single-mode course in the first place). -->
        <p style="color:var(--muted);font-size:.9rem;margin-top:0"><%= t('course_pricing_on_request_note') %></p>
        <a href="<%= deliveryOfferings[0].ctaUrl %>" class="btn btn-gold btn-block"><%= t(deliveryOfferings[0].ctaLabelKey) %></a>
      <% } else if (course.published) { %>
        <div class="price-row">
          <% if (cardData.pricing.isFromPrice) { %>
            <div style="font-size:.8rem;color:var(--muted)"><%= t('courses_from_price') %></div>
            <div class="price-now"><%= currencySymbol(course.currency) %><%= (cardData.pricing.lowestModePriceCents/100).toFixed(0) %></div>
          <% } else { %>
            <div class="price-now"><%= currencySymbol(course.currency) %><%= (cardData.pricing.finalPriceCents/100).toFixed(0) %></div>
            <% if(cardData.pricing.discountPercent > 0){ %>
              <div class="price-was"><%= currencySymbol(course.currency) %><%= (cardData.pricing.originalPriceCents/100).toFixed(0) %></div>
              <div class="price-savings" style="color:#16847B;font-size:.85rem;font-weight:600"><%= t('course_you_save', currencySymbol(course.currency) + ((cardData.pricing.originalPriceCents-cardData.pricing.finalPriceCents)/100).toFixed(0)) %></div>
            <% } %>
          <% } %>
        </div>
        <% if(!cardData.pricing.isFromPrice && cardData.pricing.discountPercent > 0){ %><span class="discount-badge"><%= t('schedule_discount', cardData.pricing.discountPercent) %></span><% } %>
        <p class="form-hint" style="margin-top:10px"><%= t('course_per_person') %> &middot; <%= course.currency %></p>
        <a href="/courses/<%= course.slug %>/register" class="btn btn-gold btn-block" style="margin-top:14px"><%= t('course_register_now') %></a>
      <% } else { %>
        <p style="color:var(--muted);font-size:.9rem;margin-top:0"><%= t('course_unconfirmed_note') %></p>
        <button type="button" class="btn btn-gold btn-block" onclick="document.getElementById('interest-modal').style.display='flex'"><%= t('schedule_interested') %></button>
      <% } %>
      <a href="/corporate-training?course=<%= course.slug %>" class="btn btn-outline btn-block" style="margin-top:10px"><%= t('course_corporate_inquiry') %></a>
      <% if (course.brochureFilename) { %>
        <button type="button" class="btn btn-outline btn-block" style="margin-top:10px" onclick="document.getElementById('brochure-modal').style.display='flex'"><%= t('course_download_brochure') %></button>
      <% } %>

      <h4 style="margin-top:24px;font-size:.95rem"><%= t('course_upcoming_sessions_title') %></h4>
      <% if (!course.published) { %>
        <p style="color:var(--muted);font-size:.9rem"><%= t('schedule_no_schedule') %></p>
      <% } else { %>
      <div class="form-field" style="margin-bottom:10px">
        <label style="font-size:.82rem"><%= t('course_show_times_in') %></label>
        <select id="session-tz-select" onchange="applySessionTimezone(this.value)">
          <option value="Etc/GMT-2" selected><%= t('tz_cest') %></option>
          <option value="Etc/GMT"><%= t('tz_gmt') %></option>
          <option value="Europe/London"><%= t('tz_london') %></option>
          <option value="America/New_York"><%= t('tz_est') %></option>
          <option value="America/Chicago"><%= t('tz_cst') %></option>
          <option value="America/Los_Angeles"><%= t('tz_pst') %></option>
          <option value="Asia/Kolkata"><%= t('tz_ist') %></option>
          <option value="Asia/Dubai"><%= t('tz_dubai') %></option>
          <option value="Asia/Singapore"><%= t('tz_singapore') %></option>
          <option value="Asia/Tokyo"><%= t('tz_japan') %></option>
          <option value="Australia/Sydney"><%= t('tz_sydney') %></option>
        </select>
      </div>
      <ul class="session-list">
        <% course.sessions.forEach(s => { %>
          <li>
            <span>
              <%= s.startDate %><%= s.endDate ? ' – ' + s.endDate : '' %> &middot; <%= s.mode %>
              <% if (s.timeFrom || s.timeTo) { %><br><span class="session-time-display" style="font-size:.8rem;color:var(--muted)" data-date="<%= s.startDate %>" data-time-from="<%= s.timeFrom || '' %>" data-time-to="<%= s.timeTo || '' %>"><%= s.timeFrom || '?' %>–<%= s.timeTo || '?' %></span><% } %>
            </span>
            <span><%= s.seatsLeft!=null ? t('course_seats_left', s.seatsLeft) : t('course_on_request') %></span>
          </li>
        <% }) %>
      </ul>
      <script>
        // Session times are stored in CEST (a fixed UTC+2 offset — the
        // "summer" variant specifically, not the DST-aware Europe/Berlin
        // zone, per how these were entered). Building an explicit
        // +02:00-offset timestamp for the stored date+time gives the
        // correct absolute moment regardless of the visitor's own
        // browser timezone; Intl.DateTimeFormat then renders that same
        // moment correctly in whichever target zone they pick, DST and
        // all, without this code needing to know DST rules itself.
        function applySessionTimezone(target) {
          document.querySelectorAll('.session-time-display').forEach((el) => {
            const date = el.dataset.date;
            const from = el.dataset.timeFrom;
            const to = el.dataset.timeTo;
            if (!date || (!from && !to)) return;
            const fmt = (t) => {
              if (!t) return '?';
              // Stored times are always CEST (fixed UTC+2) — building the
              // source timestamp with that offset every time, regardless
              // of which target is selected, gives the correct absolute
              // moment; only the target passed to Intl.DateTimeFormat
              // changes which zone that moment gets displayed in.
              const d = new Date(`${date}T${t}:00+02:00`);
              if (isNaN(d.getTime())) return t;
              return new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', hour12: false, timeZone: target }).format(d);
            };
            el.textContent = `${fmt(from)}–${fmt(to)}`;
          });
        }
      </script>
      <% } %>
    </div>
  </div>
</div>

<% if (course.brochureFilename) { %>
<div id="brochure-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:1000;align-items:center;justify-content:center">
  <div class="card" style="max-width:420px;width:90%;background:#fff">
    <h3 style="margin-top:0"><%= t('course_get_brochure_title') %></h3>
    <p style="color:var(--muted);font-size:.9rem"><%= t('course_brochure_modal_desc') %></p>
    <div id="brochure-form-area">
      <div class="form-field"><label><%= t('common_email_address') %></label><input type="email" id="brochure-email" placeholder="you@company.com"></div>
      <div id="brochure-error" class="alert alert-error" style="display:none;margin-bottom:14px"></div>
      <button type="button" class="btn btn-gold btn-block" onclick="submitBrochureRequest()"><%= t('course_send_brochure') %></button>
    </div>
    <div id="brochure-success" style="display:none">
      <div class="alert alert-success"><%= t('course_brochure_success') %></div>
    </div>
    <button type="button" class="btn btn-outline btn-block" style="margin-top:10px" onclick="document.getElementById('brochure-modal').style.display='none'"><%= t('common_close') %></button>
  </div>
</div>
<script>
// Server-rendered once here, since this script runs client-side where
// t() (an EJS/request-time function) isn't available at all.
const brochureGenericError = <%- JSON.stringify(t('course_generic_error')) %>;
const brochureNetworkError = <%- JSON.stringify(t('course_network_error')) %>;
async function submitBrochureRequest() {
  const email = document.getElementById('brochure-email').value.trim();
  const errorBox = document.getElementById('brochure-error');
  errorBox.style.display = 'none';
  try {
    const res = await fetch('/courses/<%= course.slug %>/brochure', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email }),
    });
    const data = await res.json();
    if (!res.ok) {
      errorBox.textContent = data.error || brochureGenericError;
      errorBox.style.display = 'block';
      return;
    }
    document.getElementById('brochure-form-area').style.display = 'none';
    document.getElementById('brochure-success').style.display = 'block';
  } catch (e) {
    errorBox.textContent = brochureNetworkError;
    errorBox.style.display = 'block';
  }
}
</script>
<% } %>

<% if (!course.published) { %>
<div id="interest-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:1000;align-items:center;justify-content:center">
  <div class="card" style="max-width:460px;width:90%;background:#fff;max-height:90vh;overflow-y:auto">
    <h3 style="margin-top:0"><%= t('course_im_interested_title') %></h3>
    <p style="color:var(--muted);font-size:.9rem"><%= t('course_interest_modal_desc') %></p>
    <div id="interest-form-area">
      <div class="form-field"><label><%= t('common_course') %></label><input type="text" value="<%= course.title %>" disabled style="background:var(--bg)"></div>
      <div class="form-field"><label><%= t('common_name') %> *</label><input type="text" id="interest-name" required></div>
      <div class="form-field"><label><%= t('common_email') %> *</label><input type="email" id="interest-email" required></div>
      <div class="form-field"><label><%= t('common_phone') %></label><input type="text" id="interest-phone"></div>
      <div class="form-field"><label><%= t('common_company') %></label><input type="text" id="interest-company"></div>
      <div class="form-field"><label><%= t('common_team_size') %></label><input type="text" id="interest-teamSize" placeholder="e.g. Just me, or a group of 5"></div>
      <div class="form-field">
        <label><%= t('common_preferred_delivery_mode') %></label>
        <select id="interest-deliveryMode">
          <option value=""><%= t('common_no_preference') %></option>
          <% course.deliveryModes.forEach(m => { %><option value="<%= m %>"><%= m %></option><% }) %>
        </select>
      </div>
      <div class="form-field"><label><%= t('common_message_optional') %></label><textarea id="interest-message" rows="3"></textarea></div>
      <div id="interest-error" class="alert alert-error" style="display:none;margin-bottom:14px"></div>
      <button type="button" class="btn btn-gold btn-block" onclick="submitInterestRequest()"><%= t('course_send') %></button>
    </div>
    <div id="interest-success" style="display:none">
      <div class="alert alert-success"><%= t('course_interest_success') %></div>
    </div>
    <button type="button" class="btn btn-outline btn-block" style="margin-top:10px" onclick="document.getElementById('interest-modal').style.display='none'"><%= t('common_close') %></button>
  </div>
</div>
<script>
const interestGenericError = <%- JSON.stringify(t('course_generic_error')) %>;
async function submitInterestRequest() {
  const name = document.getElementById('interest-name').value.trim();
  const email = document.getElementById('interest-email').value.trim();
  const errorBox = document.getElementById('interest-error');
  errorBox.style.display = 'none';
  try {
    const res = await fetch('/courses/<%= course.slug %>/interest', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        name, email,
        phone: document.getElementById('interest-phone').value.trim(),
        company: document.getElementById('interest-company').value.trim(),
        teamSize: document.getElementById('interest-teamSize').value.trim(),
        deliveryMode: document.getElementById('interest-deliveryMode').value,
        message: document.getElementById('interest-message').value.trim(),
      }),
    });
    const data = await res.json();
    if (!res.ok) {
      errorBox.textContent = data.error || interestGenericError;
      errorBox.style.display = 'block';
      return;
    }
    document.getElementById('interest-form-area').style.display = 'none';
    document.getElementById('interest-success').style.display = 'block';
  } catch (e) {
    errorBox.textContent = interestGenericError;
    errorBox.style.display = 'block';
  }
}
</script>
<% } %>

<%- include('partials/footer') %>
