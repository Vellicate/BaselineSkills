<%- include('partials/header') %>

<script type="application/ld+json">
<%- JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": resource.title,
  "description": resource.excerpt,
  "datePublished": resource.createdAt,
  "dateModified": resource.updatedAt || resource.createdAt,
  "publisher": { "@type": "Organization", "name": "Baseline Skills" },
}) %>
</script>
<script type="application/ld+json">
<%- JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "RE Pulse", "item": "https://www.baselineskills.com/resources" },
    { "@type": "ListItem", "position": 2, "name": resource.title, "item": `https://www.baselineskills.com/resources/${resource.slug}` },
  ],
}) %>
</script>

<section class="course-header">
  <div class="container">
    <span class="tag"><%= resource.category %></span>
    <h1 style="color:#fff;margin-top:14px"><%= resource.title %></h1>
  </div>
</section>

<section class="section">
  <div class="container" style="max-width:760px">
    <p class="lead"><%= resource.excerpt %></p>
    <div style="white-space:pre-line;line-height:1.7;color:var(--body-text,#333)"><%= resource.body %></div>

    <% if (resource.downloadFilename) { %>
    <div class="card" style="margin-top:32px;max-width:460px">
      <h3 style="margin-top:0"><%= t('resdetail_download_title') %></h3>
      <p style="color:var(--muted);font-size:.9rem"><%= t('course_brochure_modal_desc') %></p>
      <div id="download-form-area">
        <div class="form-field"><label><%= t('common_email_address') %></label><input type="email" id="download-email" placeholder="you@company.com"></div>
        <div id="download-error" class="alert alert-error" style="display:none;margin-bottom:14px"></div>
        <button type="button" class="btn btn-gold btn-block" onclick="submitResourceDownloadRequest()"><%= t('resdetail_send_download') %></button>
      </div>
      <div id="download-success" style="display:none">
        <div class="alert alert-success"><%= t('course_brochure_success') %></div>
      </div>
    </div>
    <script>
    const i18nGenericError = <%- JSON.stringify(t('course_generic_error')) %>;
    async function submitResourceDownloadRequest() {
      const email = document.getElementById('download-email').value.trim();
      const errorBox = document.getElementById('download-error');
      errorBox.style.display = 'none';
      try {
        const res = await fetch('/resources/<%= resource.slug %>/download', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        });
        const data = await res.json();
        if (!res.ok) {
          errorBox.textContent = data.error || i18nGenericError;
          errorBox.style.display = 'block';
          return;
        }
        document.getElementById('download-form-area').style.display = 'none';
        document.getElementById('download-success').style.display = 'block';
      } catch (e) {
        errorBox.textContent = i18nGenericError;
        errorBox.style.display = 'block';
      }
    }
    </script>
    <% } %>

    <% if (related.length > 0) { %>
    <h3 style="margin-top:48px"><%= t('resdetail_more_from', resource.category) %></h3>
    <div class="grid-3">
      <% related.forEach(r => { %>
        <div class="card">
          <h4><%= r.title %></h4>
          <p style="font-size:.85rem;color:var(--muted)"><%= r.excerpt %></p>
          <a href="/resources/<%= r.slug %>" class="btn btn-outline btn-sm"><%= t('read_more_lowercase') %></a>
        </div>
      <% }) %>
    </div>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>
