<%- include('partials/header') %>

<section class="section-tight" style="background:#fff;border-bottom:1px solid var(--line)">
  <div class="container">
    <span class="eyebrow"><%= t('about_eyebrow') %></span>
    <h1 style="font-size:2.1rem"><%= t('about_title') %></h1>
    <p class="lead" style="max-width:680px"><%= t('about_lead') %></p>
  </div>
</section>

<section class="section">
  <div class="container grid-2">
    <div class="card">
      <h3><%= t('about_mission_title') %></h3>
      <p><%= t('about_mission_body') %></p>
    </div>
    <div class="card">
      <h3><%= t('about_vision_title') %></h3>
      <p><%= t('about_vision_body') %></p>
    </div>
  </div>
</section>

<section class="section" style="background:#fff">
  <div class="container">
    <div class="section-hdr center">
      <span class="eyebrow"><%= t('about_trainers_eyebrow') %></span>
      <h2><%= t('about_trainers_title') %></h2>
    </div>
    <div class="grid-3">
      <div class="card"><div class="card-icon">RE</div><h4><%= t('about_re_title') %></h4><p style="color:var(--muted);font-size:.9rem"><%= t('about_re_body') %></p></div>
      <div class="card"><div class="card-icon">SE</div><h4><%= t('about_se_title') %></h4><p style="color:var(--muted);font-size:.9rem"><%= t('about_se_body') %></p></div>
      <div class="card"><div class="card-icon">AS</div><h4><%- t('about_as_title') %></h4><p style="color:var(--muted);font-size:.9rem"><%= t('about_as_body') %></p></div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
