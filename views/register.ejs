<%- include('partials/header') %>

<section class="section-tight" style="background:#fff;border-bottom:1px solid var(--line)">
  <div class="container">
    <span class="eyebrow">Register</span>
    <h1 style="font-size:1.9rem">Register for <%= course.title %></h1>
    <p class="lead">Session details and payment on the next step.</p>
  </div>
</section>

<section class="section">
  <div class="container" style="max-width:760px">
    <% if (typeof error !== 'undefined' && error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <div class="grid-2" style="align-items:start">
      <form method="POST" action="/courses/<%= course.slug %>/register" class="card" style="grid-column:1">
        <div class="form-row">
          <div class="form-field"><label>Full name *</label><input type="text" name="name" required value="<%= typeof form!=='undefined' ? form.name||'' : '' %>"></div>
          <div class="form-field"><label>Email *</label><input type="email" name="email" required value="<%= typeof form!=='undefined' ? form.email||'' : '' %>"></div>
        </div>
        <div class="form-row">
          <div class="form-field"><label>Phone</label><input type="tel" name="phone" value="<%= typeof form!=='undefined' ? form.phone||'' : '' %>"></div>
          <div class="form-field"><label>Address</label><input type="text" name="address" value="<%= typeof form!=='undefined' ? form.address||'' : '' %>"></div>
        </div>
        <div class="form-row">
          <div class="form-field"><label>Company</label><input type="text" name="company"></div>
          <div class="form-field"><label>Role</label><input type="text" name="role"></div>
        </div>
        <div class="form-row">
          <div class="form-field">
            <label>Preferred session</label>
            <select name="sessionStartDate" onchange="window.location.href='/courses/<%= course.slug %>/register?session='+encodeURIComponent(this.value)">
              <% course.sessions.forEach(s => { %><option value="<%= s.startDate %>" <%= s.startDate === selectedSessionStartDate ? 'selected' : '' %>><%= s.startDate %> — <%= s.mode %></option><% }) %>
            </select>
          </div>
          <div class="form-field">
            <label>Delivery mode</label>
            <select name="deliveryMode">
              <% course.deliveryModes.forEach(m => { %><option value="<%= m %>"><%= m %></option><% }) %>
            </select>
          </div>
        </div>
        <div class="form-field"><label>Notes (optional)</label><textarea name="notes" rows="3"></textarea></div>

        <% if (examProduct) { %>
        <div class="form-field" style="border:1px solid var(--line);border-radius:8px;padding:14px;margin-top:10px">
          <label style="display:flex;align-items:start;gap:10px;cursor:pointer">
            <input type="checkbox" name="addExam" value="1" style="margin-top:4px">
            <span>
              <strong>Add the <%= examProduct.certificationName %> certification exam</strong> (<%= examProduct.certificationBody %>) — <%= currencySymbol(course.currency) %><%= (examFinalPriceCents/100).toFixed(2) %>
              <br><span style="color:var(--muted);font-size:.85rem"><%= examProduct.description %></span>
            </span>
          </label>
        </div>
        <% } %>

        <button type="submit" class="btn btn-gold btn-block btn-lg">Continue to Payment</button>
        <p class="form-hint" style="text-align:center;margin-top:10px">You'll get an email confirmation immediately after registering.</p>
      </form>

      <div class="sticky-card" style="grid-column:2">
        <h4 style="margin-top:0"><%= course.title %></h4>
        <p style="font-size:.85rem;color:var(--muted)"><%= course.durationDays %> day<%= course.durationDays>1?'s':'' %> &middot; <%= course.category %></p>
        <div class="price-row" style="margin-top:16px">
          <div class="price-now"><%= currencySymbol(course.currency) %><%= (finalPrice/100).toFixed(2) %></div>
          <% if(finalPrice < course.priceCents){ %>
            <div class="price-was"><%= currencySymbol(course.currency) %><%= (course.priceCents/100).toFixed(2) %></div>
            <div class="price-savings" style="color:#16847B;font-size:.85rem;font-weight:600">You save <%= currencySymbol(course.currency) %><%= ((course.priceCents-finalPrice)/100).toFixed(2) %></div>
          <% } %>
        </div>
        <% if (discountInfo.tierLabel === 'Very Early Bird' || discountInfo.tierLabel === 'Early Bird') { %>
          <span class="discount-badge"><%= discountInfo.tierLabel %> — save on this session</span>
          <p style="font-size:.85rem;color:var(--muted);margin-top:8px">
            This rate ends <strong><%= discountInfo.deadlineDate %></strong>
            (<%= discountInfo.daysUntilDeadline %> day<%= discountInfo.daysUntilDeadline !== 1 ? 's' : '' %> from now) —
            book before then to keep this price.
          </p>
        <% } else if (course.discountPercent) { %>
          <span class="discount-badge"><%= course.discountPercent %>% OFF applied</span>
        <% } %>
        <% if (examProduct) { %>
        <p style="font-size:.85rem;color:var(--muted);margin-top:14px;border-top:1px solid var(--line);padding-top:10px">
          Course fee: <%= currencySymbol(course.currency) %><%= (finalPrice/100).toFixed(2) %><br>
          + Exam (if added): <%= currencySymbol(course.currency) %><%= (examFinalPriceCents/100).toFixed(2) %><br>
          <strong>Total with exam: <%= currencySymbol(course.currency) %><%= ((finalPrice+examFinalPriceCents)/100).toFixed(2) %></strong>
        </p>
        <% } %>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
