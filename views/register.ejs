<%- include('partials/header') %>

<section class="section-tight" style="background:#fff;border-bottom:1px solid var(--line)">
  <div class="container">
    <span class="eyebrow"><%= t('register_eyebrow') %></span>
    <h1 style="font-size:1.9rem"><%= t('register_title', course.title) %></h1>
    <p class="lead"><%= t('register_lead') %></p>
  </div>
</section>

<section class="section">
  <div class="container" style="max-width:980px">
    <%
      // Prefill data for a re-rendered form after a validation error.
      // Without this, every dynamically-added participant row (2 and up)
      // rebuilt itself empty from scratch on load, since
      // renderParticipantBlocks() had no way to know what was previously
      // typed there — only the purchaser's own fields survived an error,
      // because those are plain server-rendered <input value="..."> ones,
      // not JS-generated. Computed once here, right after the container
      // opens, so both the purchaserAttending checkbox's initial state
      // below and the script injection further down can both read from
      // it without duplicating this logic.
      const hasForm = typeof form !== "undefined" && form;
      const prefillNames = hasForm && form.participantName ? (Array.isArray(form.participantName) ? form.participantName : [form.participantName]) : [];
      const prefillEmailsArr = hasForm && form.participantEmail ? (Array.isArray(form.participantEmail) ? form.participantEmail : [form.participantEmail]) : [];
      const prefillPhonesArr = hasForm && form.participantPhone ? (Array.isArray(form.participantPhone) ? form.participantPhone : [form.participantPhone]) : [];
      const prefillParticipantsData = prefillNames.map((n, i) => ({ name: n || "", email: (prefillEmailsArr[i] || "").trim(), phone: prefillPhonesArr[i] || "" }));
      const prefillPurchaserEmailLower = (hasForm ? (form.email || "") : "").trim().toLowerCase();
      // Defaults to true (matching the checkbox's original hard-coded
      // "checked" state) whenever there's no submitted data to infer from
      // yet — i.e. the very first, non-error page load.
      const prefillPurchaserAttending = prefillParticipantsData.length === 0 || prefillParticipantsData.some((p) => p.email.toLowerCase() === prefillPurchaserEmailLower);
      const dupEmailsList = typeof duplicateEmails !== "undefined" && duplicateEmails ? duplicateEmails : [];
    %>
    <% if (typeof error !== 'undefined' && error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (typeof resumeUrl !== 'undefined' && resumeUrl) { %>
      <div style="margin:-12px 0 20px"><a href="<%= resumeUrl %>" class="btn btn-gold"><%= t('register_retry_payment') %></a></div>
    <% } %>

    <div class="grid-2 register-grid" style="align-items:start">
      <form method="POST" action="/courses/<%= course.slug %>/register" class="card" style="grid-column:1" id="registerForm">
        <h3 style="margin-top:0;font-size:1.05rem"><%= t('register_your_details') %></h3>
        <div class="form-row">
          <div class="form-field"><label><%= t('register_full_name') %> *</label><input type="text" name="name" id="purchaserName" required value="<%= typeof form!=='undefined' ? form.name||'' : '' %>"></div>
          <div class="form-field"><label><%= t('common_email') %> *</label><input type="email" name="email" id="purchaserEmail" required value="<%= typeof form!=='undefined' ? form.email||'' : '' %>" <%= dupEmailsList.includes(prefillPurchaserEmailLower) ? 'style="border-color:#b91c1c"' : '' %>>
            <% if (dupEmailsList.includes(prefillPurchaserEmailLower)) { %><p style="color:#b91c1c;font-size:.85rem;margin-top:4px"><%= t('register_already_registered') %></p><% } %>
          </div>
        </div>
        <div class="form-row">
          <div class="form-field"><label><%= t('common_phone') %></label><input type="tel" name="phone" id="purchaserPhone" value="<%= typeof form!=='undefined' ? form.phone||'' : '' %>"></div>
          <div class="form-field"><label><%= t('register_address') %></label><input type="text" name="address" value="<%= typeof form!=='undefined' ? form.address||'' : '' %>"></div>
        </div>
        <div class="form-row">
          <div class="form-field"><label><%= t('common_company') %></label><input type="text" name="company" value="<%= typeof form!=='undefined' ? form.company||'' : '' %>"></div>
          <div class="form-field"><label><%= t('common_role') %></label><input type="text" name="role" value="<%= typeof form!=='undefined' ? form.role||'' : '' %>"></div>
        </div>
        <div class="form-row">
          <div class="form-field">
            <label><%= t('register_billing_country') %> *</label>
            <select name="country" id="purchaserCountry" required onchange="refreshPricingPreview()">
              <option value=""><%= t('register_select_country') %></option>
              <% countries.forEach(([code, name]) => { %><option value="<%= code %>"><%= name %></option><% }) %>
            </select>
            <p class="form-hint"><%= t('register_vat_hint') %></p>
          </div>
        </div>
        <div class="form-field" id="sessionFieldWrap">
          <label><%= t('register_preferred_session') %></label>
          <select name="sessionStartDate" id="sessionStartDateSelect" onchange="changeSession(this.value)" style="width:100%">
            <% course.sessions.forEach(s => { const soldOut = s.seatsLeft !== null && s.seatsLeft !== undefined && s.seatsLeft <= 0; %><option value="<%= s.startDate %>" <%= s.startDate === selectedSessionStartDate ? 'selected' : '' %>><%= s.startDate %> — <%= s.mode %><%= soldOut ? ' (' + t('register_sold_out') + ')' : '' %></option><% }) %>
          </select>
          <p class="form-hint" id="sessionNotApplicableNote" style="display:none"><%= t('register_recorded_note') %></p>
        </div>
        <div class="form-field">
          <label><%= t('register_delivery_mode') %></label>
          <select name="deliveryMode" id="deliveryModeSelect" onchange="onDeliveryModeChange()">
            <% course.deliveryModes.filter(m => !["Corporate On-site","Private Cohort"].includes(m)).forEach(m => { %><option value="<%= m %>" <%= (typeof selectedDeliveryMode !== 'undefined' && selectedDeliveryMode === m) ? 'selected' : '' %>><%= m %></option><% }) %>
          </select>
        </div>

        <div class="form-field" style="border:1px solid var(--line);border-radius:8px;padding:14px;margin-top:6px;background:var(--bg-soft,#F8FAFC)">
          <div class="form-row" style="grid-template-columns:1fr auto;align-items:center">
            <label style="margin:0"><%= t('register_num_participants') %></label>
            <div style="display:flex;align-items:center;gap:10px">
              <button type="button" class="btn btn-outline btn-sm" onclick="stepParticipants(-1)" aria-label="Decrease">&minus;</button>
              <input type="number" name="participantCount" id="participantCount" min="1" max="50" value="<%= (typeof form!=='undefined' && form.participantCount) ? form.participantCount : 1 %>" style="width:60px;text-align:center" onchange="renderParticipantBlocks()">
              <button type="button" class="btn btn-outline btn-sm" onclick="stepParticipants(1)" aria-label="Increase">&plus;</button>
            </div>
          </div>
          <div class="checkbox-row" style="margin-top:10px">
            <input type="checkbox" id="purchaserAttending" <%= prefillPurchaserAttending ? 'checked' : '' %> onchange="renderParticipantBlocks()">
            <label style="margin:0;font-weight:400" for="purchaserAttending"><%= t('register_also_attending') %></label>
          </div>
          <p id="groupDiscountNote" class="form-hint" style="margin-top:8px;display:none"></p>
        </div>

        <div id="participantsWrap" style="margin-top:10px"></div>

        <div class="form-field"><label><%= t('register_notes') %></label><textarea name="notes" rows="3"></textarea></div>

        <div class="form-field">
          <label><%= t('register_coupon_code') %></label>
          <div style="display:flex;gap:8px">
            <input type="text" name="couponCode" id="couponCodeInput" value="<%= typeof couponCode !== 'undefined' ? couponCode : '' %>" placeholder="<%= t('register_coupon_placeholder_example') %>" style="flex:1" <%= (typeof couponValidation !== 'undefined' && couponValidation && couponValidation.valid) ? 'readonly' : '' %>>
            <button type="button" class="btn btn-outline" id="couponActionBtn" onclick="<%= (typeof couponValidation !== 'undefined' && couponValidation && couponValidation.valid) ? 'removeCoupon()' : 'applyCoupon()' %>">
              <%= (typeof couponValidation !== 'undefined' && couponValidation && couponValidation.valid) ? t('register_remove') : t('register_apply') %>
            </button>
          </div>
          <p id="couponMessage" style="font-size:.85rem;margin-top:4px">
            <% if (typeof couponValidation !== 'undefined' && couponValidation) { %>
              <% if (couponValidation.valid) { %>
                <span style="color:#16847B"><%= t('register_coupon_applied', couponValidation.percent) %></span>
              <% } else { %>
                <span style="color:#b91c1c"><%= t('coupon_reason_' + couponValidation.reasonKey) %></span>
              <% } %>
            <% } %>
          </p>
        </div>

        <% if (examProduct) { %>
        <div class="form-field" style="border:1px solid var(--line);border-radius:8px;padding:14px;margin-top:10px">
          <label style="display:flex;align-items:start;gap:10px;cursor:pointer">
            <input type="checkbox" name="addExam" value="1" style="margin-top:4px">
            <span>
              <strong><%= t('register_add_exam', examProduct.certificationName) %></strong> (<%= examProduct.certificationBody %>) — <%= currencySymbol(course.currency) %><%= (examFinalPriceCents/100).toFixed(2) %> <%= t('register_per_participant') %>
              <br><span style="color:var(--muted);font-size:.85rem;white-space:pre-line"><%= examProduct.description %></span>
            </span>
          </label>
        </div>
        <% } %>

        <button type="submit" class="btn btn-gold btn-block btn-lg"><%= t('register_continue_to_payment') %></button>
        <p class="form-hint" style="text-align:center;margin-top:10px"><%= t('register_email_confirmation_note') %></p>
      </form>

      <div class="sticky-card" style="grid-column:2">
        <h4 style="margin-top:0"><%= course.title %></h4>
        <p style="font-size:.85rem;color:var(--muted)"><%= course.durationDays %> <%= course.durationDays>1 ? t('schedule_day_plural') : t('schedule_day_singular') %> &middot; <%= course.category %></p>
        <div id="pricingPreview" style="margin-top:16px;font-size:.92rem">
          <div style="display:flex;justify-content:space-between;padding:4px 0"><span><%= t('register_training_label') %></span><span id="lineTraining"><%= currencySymbol(course.currency) %><%= (finalPrice/100).toFixed(2) %></span></div>
          <div style="display:flex;justify-content:space-between;padding:4px 0;display:none" id="lineExamRow"><span><%= t('register_cert_exam_label') %></span><span id="lineExam"></span></div>
          <div style="display:none;justify-content:space-between;padding:4px 0;color:#16847B" id="lineDiscountRow"><span id="lineDiscountLabel"><%= t('register_group_discount_label') %></span><span id="lineDiscount"></span></div>
          <div style="display:none;justify-content:space-between;padding:4px 0;color:var(--muted)" id="lineVatRow"><span id="lineVatLabel"><%= t('register_vat_label') %></span><span id="lineVat"></span></div>
          <div style="display:flex;justify-content:space-between;padding-top:10px;margin-top:6px;border-top:1px solid var(--line);font-weight:700;font-size:1.15rem">
            <span><%= t('register_total_label') %></span><span id="previewFinalTotal"><%= currencySymbol(course.currency) %><%= (finalPrice/100).toFixed(2) %></span>
          </div>
          <p class="form-hint" id="previewBreakdown" style="margin-top:6px"></p>
        </div>
        <% if (discountInfo.tierLabel === 'Very Early Bird' || discountInfo.tierLabel === 'Early Bird') { %>
          <span class="discount-badge"><%= t('register_save_on_session', discountInfo.tierLabel) %></span>
          <p style="font-size:.85rem;color:var(--muted);margin-top:8px">
            <%- t('register_rate_ends', '<strong>' + discountInfo.deadlineDate + '</strong>', discountInfo.daysUntilDeadline, discountInfo.daysUntilDeadline !== 1 ? t('schedule_day_plural') : t('schedule_day_singular')) %>
          </p>
        <% } else if (course.discountPercent) { %>
          <span class="discount-badge"><%= t('register_off_applied', course.discountPercent) %></span>
        <% } %>
      </div>
    </div>
  </div>
</section>

<script>
const courseSlug = <%- JSON.stringify(course.slug) %>;
const sessionStartDate = <%- JSON.stringify(selectedSessionStartDate) %>;
// Escaping "<" defends against a participant name/email containing the
// closing-script-tag sequence and breaking out of this block early —
// every "<" in JSON.stringify's output is necessarily inside one of the
// quoted string values (no JSON structural character uses "<"), so
// replacing it with the unicode escape "\u003c" is always safe: it stays
// inside a string, where a unicode escape is valid JS, rather than
// becoming bare, invalid syntax the way it would outside a string. (This
// comment deliberately avoids spelling out that literal closing-tag
// sequence itself — writing it out here, even inside a JS comment, would
// cause the very same early-termination bug it's describing, since a
// browser's HTML parser looks for that raw byte sequence anywhere in a
// script element's text, with no awareness of JS comments or strings.)
const prefillParticipants = <%- JSON.stringify(prefillParticipantsData).replace(/</g, "\\u003c") %>;
const duplicateEmails = <%- JSON.stringify(dupEmailsList.map((e) => e.toLowerCase())).replace(/</g, "\\u003c") %>;

// t() is an EJS/request-time function, not available once this script runs
// client-side -- every string the JS below builds dynamically (participant
// rows, coupon messages, pricing labels) is rendered once here instead.
const i18nParticipant1You = <%- JSON.stringify(t('register_participant_1_you')) %>;
const i18nParticipantNName = <%- JSON.stringify(t('register_participant_n_name', '{0}')) %>;
const i18nEmailRequired = <%- JSON.stringify(t('common_email') + ' *') %>;
const i18nPhone = <%- JSON.stringify(t('common_phone')) %>;
const i18nAlreadyRegistered = <%- JSON.stringify(t('register_already_registered')) %>;
const i18nCouponInvalidFallback = <%- JSON.stringify(t('register_coupon_invalid_fallback')) %>;
const i18nCouponApplied = <%- JSON.stringify(t('register_coupon_applied', '{0}')) %>;
const i18nApply = <%- JSON.stringify(t('register_apply')) %>;
const i18nRemove = <%- JSON.stringify(t('register_remove')) %>;
const i18nGroupDiscountLabel = <%- JSON.stringify(t('register_group_discount_label')) %>;
const i18nDiscountLabel = <%- JSON.stringify(t('register_discount_label')) %>;
const i18nVatLabel = <%- JSON.stringify(t('register_vat_label')) %>;
const i18nParticipantsCount = <%- JSON.stringify(t('register_participants_count', '{0}')) %>;
const i18nPerParticipantAfterDiscount = <%- JSON.stringify(t('register_per_participant_after_discount', '{0}')) %>;

function changeSession(newSessionStartDate) {
  const mode = document.getElementById('deliveryModeSelect').value;
  window.location.href = '/courses/' + courseSlug + '/register?session=' + encodeURIComponent(newSessionStartDate) + '&mode=' + encodeURIComponent(mode);
}

// Part 1C: Recorded has no session date at all. Handled client-side,
// without reloading the page, unlike changeSession above -- a mode
// change happening after the visitor has already started filling in
// their own and their participants' details shouldn't throw that away.
// The session field is hidden and its value cleared so a blank,
// unambiguous value reaches the server (which independently enforces
// the same rule regardless of what this sends -- Part 23: never trust
// the client alone for something this consequential to pricing).
function onDeliveryModeChange() {
  const mode = document.getElementById('deliveryModeSelect').value;
  const wrap = document.getElementById('sessionFieldWrap');
  const select = document.getElementById('sessionStartDateSelect');
  const note = document.getElementById('sessionNotApplicableNote');
  if (mode === 'Recorded') {
    select.style.display = 'none';
    select.disabled = true;
    note.style.display = 'block';
  } else {
    select.style.display = '';
    select.disabled = false;
    note.style.display = 'none';
  }
  refreshPricingPreview();
}

function stepParticipants(delta) {
  const input = document.getElementById('participantCount');
  const next = Math.max(1, Math.min(50, (parseInt(input.value, 10) || 1) + delta));
  input.value = next;
  renderParticipantBlocks();
}

// Purchaser counts as participant 1 when attending -- their block is
// auto-filled and locked (edited via the purchaser fields above, not
// duplicated as a separately-editable copy) so there's exactly one place
// to change that person's details, not two that could drift apart.
function renderParticipantBlocks() {
  const count = Math.max(1, parseInt(document.getElementById('participantCount').value, 10) || 1);
  const purchaserAttending = document.getElementById('purchaserAttending').checked;
  const wrap = document.getElementById('participantsWrap');

  // Capture whatever is currently typed in the visible rows before wiping
  // them, so increasing/decreasing the count or toggling "I am attending"
  // afterward doesn't silently discard it. This whole function always
  // rebuilds every row from scratch, so without this capture step, a live
  // edit to row 2+ would be lost the moment the count changed next — not
  // just on the very first, prefill-driven render below.
  const existingRows = Array.from(wrap.querySelectorAll('.form-row')).map((row) => {
    const inputs = row.querySelectorAll('input');
    return { name: inputs[0] ? inputs[0].value : '', email: inputs[1] ? inputs[1].value : '', phone: inputs[2] ? inputs[2].value : '' };
  });
  wrap.innerHTML = '';

  const startIndex = purchaserAttending ? 2 : 1;
  if (purchaserAttending) {
    const p1 = document.createElement('div');
    p1.id = 'participant1Block';
    p1.className = 'form-field';
    p1.style.cssText = 'border:1px solid var(--line);border-radius:8px;padding:10px 14px;margin-bottom:8px;background:#F8FAFC';
    p1.innerHTML = '<strong style="font-size:.85rem">' + i18nParticipant1You + '</strong><input type="hidden" name="participantName" value="' + escapeAttr(document.getElementById('purchaserName').value) + '"><input type="hidden" name="participantEmail" value="' + escapeAttr(document.getElementById('purchaserEmail').value) + '"><input type="hidden" name="participantPhone" value="' + escapeAttr(document.getElementById('purchaserPhone').value) + '">';
    wrap.appendChild(p1);
  }
  for (let i = startIndex; i <= count; i++) {
    // prefillParticipants[0] always corresponds to whichever entry was
    // submitted as "Participant 1" — the purchaser's own mirrored data
    // when they attend (unused here, already reflected in the visible
    // purchaser fields above), or a real visible row's data when they
    // don't. Every index after that maps directly to a visible row here,
    // regardless of whether the purchaser attends, since the server built
    // this array in the same order the form actually submits it.
    // Prefer whatever was already live in this row (a prior edit
    // surviving a count change) over the server-supplied prefill; only
    // fall back to the server's prefill — from a validation-error reload —
    // for a row that's never existed in this DOM yet.
    const existing = existingRows[i - startIndex];
    const prefill = existing || prefillParticipants[i - 1] || { name: '', email: '', phone: '' };
    const isDuplicate = prefill.email && duplicateEmails.includes(prefill.email.toLowerCase());
    const block = document.createElement('div');
    block.className = 'form-row';
    block.style.cssText = 'grid-template-columns:1fr 1fr 1fr;margin-bottom:8px';
    block.innerHTML =
      '<div class="form-field"><label>' + i18nParticipantNName.replace('{0}', i) + ' *</label><input type="text" name="participantName" required value="' + escapeAttr(prefill.name) + '"></div>' +
      '<div class="form-field"><label>' + i18nEmailRequired + '</label><input type="email" name="participantEmail" required value="' + escapeAttr(prefill.email) + '"' + (isDuplicate ? ' style="border-color:#b91c1c"' : '') + '>' +
        (isDuplicate ? '<p style="color:#b91c1c;font-size:.85rem;margin-top:4px">' + i18nAlreadyRegistered + '</p>' : '') +
      '</div>' +
      '<div class="form-field"><label>' + i18nPhone + '</label><input type="text" name="participantPhone" value="' + escapeAttr(prefill.phone) + '"></div>';
    wrap.appendChild(block);
  }
  refreshPricingPreview();
}
// Re-copies just the purchaser's current field values into the hidden
// "Participant 1 (you)" inputs, in place -- unlike renderParticipantBlocks,
// this never touches the rest of #participantsWrap, so it's safe to call
// right before submit without erasing whatever the visitor already typed
// for participants 2 and up. renderParticipantBlocks() only refreshes
// those hidden values at the moment the count or checkbox changes, which
// is typically before the visitor has filled in their own name and email
// at all -- without this, participant 1's details would submit blank
// even when the visitor filled in their own details correctly.
function syncParticipant1FromPurchaser() {
  const block = document.getElementById('participant1Block');
  if (!block) return; // purchaser isn't attending -- nothing to sync
  const inputs = block.querySelectorAll('input[type="hidden"]');
  inputs[0].value = document.getElementById('purchaserName').value;
  inputs[1].value = document.getElementById('purchaserEmail').value;
  inputs[2].value = document.getElementById('purchaserPhone').value;
}
function escapeAttr(s) { return (s || '').replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;'); }

// Tracks whichever coupon is currently applied, so it keeps being included
// in every subsequent preview (participant count change, delivery mode
// change, etc.) until Remove is clicked — not just at the moment Apply
// was clicked. Starts from the server-rendered validation result so a
// coupon that was already successfully applied before a validation-error
// reload stays applied, rather than silently reverting to none.
let appliedCouponCode = <%- JSON.stringify((typeof couponValidation !== 'undefined' && couponValidation && couponValidation.valid) ? couponCode : '') %>;

function applyCoupon() {
  const code = document.getElementById('couponCodeInput').value.trim();
  const msg = document.getElementById('couponMessage');
  const btn = document.getElementById('couponActionBtn');
  if (!code) { msg.innerHTML = ''; return; }
  btn.disabled = true;
  appliedCouponCode = code;
  refreshPricingPreview(function (data) {
    btn.disabled = false;
    if (data.couponValid === false) {
      appliedCouponCode = '';
      msg.innerHTML = '<span style="color:#b91c1c">' + (data.couponReason || i18nCouponInvalidFallback) + '</span>';
      return;
    }
    msg.innerHTML = '<span style="color:#16847B">' + i18nCouponApplied.replace('{0}', data.discountPercent) + '</span>';
    document.getElementById('couponCodeInput').readOnly = true;
    btn.textContent = i18nRemove;
    btn.setAttribute('onclick', 'removeCoupon()');
  });
}

function removeCoupon() {
  appliedCouponCode = '';
  const input = document.getElementById('couponCodeInput');
  input.value = '';
  input.readOnly = false;
  document.getElementById('couponMessage').innerHTML = '';
  const btn = document.getElementById('couponActionBtn');
  btn.textContent = i18nApply;
  btn.setAttribute('onclick', 'applyCoupon()');
  refreshPricingPreview();
}

// Live pricing preview (Part 18): re-synced from the server on every
// count change, never computed client-side, since the browser is never
// the authority for a displayed price any more than for the charged one.
// Takes an optional callback so applyCoupon() above can react to this
// specific fetch's result (valid/invalid) without every other caller
// needing to care.
let previewDebounce = null;
function refreshPricingPreview(onResult) {
  clearTimeout(previewDebounce);
  previewDebounce = setTimeout(() => {
    const count = Math.max(1, parseInt(document.getElementById('participantCount').value, 10) || 1);
    const mode = document.getElementById('deliveryModeSelect').value;
    const country = document.getElementById('purchaserCountry').value;
    const examCheckbox = document.querySelector('input[name="addExam"]');
    const addExam = examCheckbox && examCheckbox.checked;
    const url = '/courses/' + courseSlug + '/register/pricing-preview'
      + '?participantCount=' + count
      + '&deliveryMode=' + encodeURIComponent(mode)
      + '&sessionStartDate=' + encodeURIComponent(sessionStartDate || '')
      + '&country=' + encodeURIComponent(country || '')
      + '&addExam=' + (addExam ? 'true' : 'false')
      + '&couponCode=' + encodeURIComponent(appliedCouponCode || '');
    fetch(url)
      .then(r => r.json())
      .then(data => {
        if (onResult) onResult(data);
        if (data.requiresInquiry) return;
        const cur = data.currencySymbol;

        document.getElementById('lineTraining').textContent = cur + (data.baseTotalCents/100).toFixed(2);

        const examRow = document.getElementById('lineExamRow');
        if (data.examPriceCents > 0) {
          examRow.style.display = 'flex';
          document.getElementById('lineExam').textContent = cur + (data.examPriceCents/100).toFixed(2);
        } else {
          examRow.style.display = 'none';
        }

        const discountRow = document.getElementById('lineDiscountRow');
        if (data.discountPercent > 0) {
          discountRow.style.display = 'flex';
          document.getElementById('lineDiscountLabel').textContent = (count > 1 ? i18nGroupDiscountLabel : i18nDiscountLabel) + ' (' + data.discountPercent + '%)';
          document.getElementById('lineDiscount').textContent = '\u2212' + cur + (data.discountAmountCents/100).toFixed(2);
        } else {
          discountRow.style.display = 'none';
        }

        const vatRow = document.getElementById('lineVatRow');
        if (data.vatAmountCents > 0) {
          vatRow.style.display = 'flex';
          document.getElementById('lineVatLabel').textContent = i18nVatLabel + ' (' + data.vatRatePercent + '%)';
          document.getElementById('lineVat').textContent = cur + (data.vatAmountCents/100).toFixed(2);
        } else {
          vatRow.style.display = 'none';
        }

        document.getElementById('previewFinalTotal').textContent = cur + (data.grandTotalCents/100).toFixed(2);

        const note = document.getElementById('groupDiscountNote');
        const breakdown = document.getElementById('previewBreakdown');
        if (count > 1) {
          breakdown.textContent = i18nParticipantsCount.replace('{0}', count);
          if (data.discountPercent > 0) {
            note.style.display = 'block';
            note.textContent = i18nPerParticipantAfterDiscount.replace('{0}', cur + (data.grandTotalCents/100/count).toFixed(2));
          } else {
            note.style.display = 'none';
          }
        } else {
          breakdown.textContent = '';
          note.style.display = 'none';
        }
      })
      .catch(() => {});
  }, 250);
}

document.getElementById('purchaserCountry').addEventListener('change', refreshPricingPreview);
document.addEventListener('change', function (e) {
  if (e.target && e.target.name === 'addExam') refreshPricingPreview();
});

renderParticipantBlocks();
onDeliveryModeChange(); // apply the Recorded-hides-session rule to whatever mode loaded pre-selected

// Critical: renderParticipantBlocks() only copies the purchaser's current
// name/email/phone into the hidden "Participant 1 (you)" fields at the
// moment it runs -- on page load, that's before the visitor has typed
// anything, so those hidden fields would otherwise submit empty even
// though the visitor filled in their own details correctly. Re-run right
// before the browser actually submits, so the hidden fields always carry
// whatever is in the purchaser fields at that final moment, not whatever
// was there when the count or checkbox last changed.
document.getElementById('registerForm').addEventListener('submit', function () {
  syncParticipant1FromPurchaser();
});
</script>

