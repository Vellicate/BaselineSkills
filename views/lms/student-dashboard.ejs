<%- include('../partials/header') %>

<section class="section-tight" style="background:#fff;border-bottom:1px solid var(--line)">
  <div class="container">
    <span class="eyebrow"><%= t('mylearning_eyebrow') %></span>
    <h1 style="font-size:2rem"><%= t('mylearning_title') %></h1>
  </div>
</section>

<section class="section">
  <div class="container">
    <% const lmsModeLabel = (m) => ({ LIVE_ONLINE: t('lms_mode_live_online'), RECORDED: t('lms_mode_recorded'), HYBRID: t('lms_mode_hybrid') }[m] || m); %>
    <% if (active.length === 0 && upcoming.length === 0 && completed.length === 0 && expired.length === 0) { %>
      <div class="card" style="text-align:center;padding:48px 24px">
        <p class="lead" style="color:var(--muted);margin:0"><%= t('mylearning_no_courses') %></p>
        <a href="/courses" class="btn btn-navy" style="margin-top:16px"><%= t('mylearning_browse_courses') %></a>
      </div>
    <% } else { %>

      <% if (active.length > 0) { %>
        <h2 style="font-size:1.3rem;margin-bottom:16px"><%= t('mylearning_active') %></h2>
        <div class="why-grid" style="grid-template-columns:repeat(2,1fr);gap:20px;margin-bottom:36px">
          <% active.forEach(s => { %>
            <div class="card">
              <h3 style="margin:0 0 4px"><%= s.course.title %></h3>
              <p style="font-size:.8rem;color:var(--muted);margin:0 0 10px"><%= lmsModeLabel(s.course.lmsDeliveryMode) %></p>
              <% if (s.progressPercent != null) { %>
                <div style="background:var(--line);border-radius:999px;height:8px;overflow:hidden;margin-bottom:6px">
                  <div style="background:var(--navy);height:100%;width:<%= s.progressPercent %>%"></div>
                </div>
                <p style="font-size:.85rem;color:var(--muted);margin:0 0 10px"><%= t('mylearning_percent_complete', s.progressPercent) %></p>
              <% } else { %>
                <p style="color:var(--muted);font-size:.9rem;margin:0 0 10px"><%= t('mylearning_content_preparing') %></p>
              <% } %>
              <% if (s.nextLesson) { %>
                <p style="font-size:.85rem;margin:0 0 4px"><%- t('mylearning_next', '<strong>' + s.nextLesson.title + '</strong>') %></p>
              <% } %>
              <% if (s.lastActivity) { %>
                <p style="font-size:.78rem;color:var(--muted);margin:0 0 10px"><%= t('mylearning_last_activity', new Date(s.lastActivity).toLocaleDateString()) %></p>
              <% } %>
              <% if (s.endDate) { %>
                <p style="font-size:.78rem;color:var(--muted);margin:0 0 12px"><%= t('mylearning_access_until', new Date(s.endDate).toLocaleDateString()) %></p>
              <% } %>
              <a href="/student/lms/courses/<%= s.course.id %>" class="btn btn-navy btn-sm"><%= t('mylearning_continue') %></a>
            </div>
          <% }) %>
        </div>
      <% } %>

      <% if (upcoming.length > 0) { %>
        <h2 style="font-size:1.3rem;margin-bottom:16px"><%= t('mylearning_upcoming') %></h2>
        <div class="why-grid" style="grid-template-columns:repeat(2,1fr);gap:20px;margin-bottom:36px">
          <% upcoming.forEach(s => { %>
            <div class="card">
              <h3 style="margin:0 0 4px"><%= s.course.title %></h3>
              <p style="font-size:.8rem;color:var(--muted);margin:0 0 10px"><%= lmsModeLabel(s.course.lmsDeliveryMode) %></p>
              <p style="font-size:.85rem;margin:0"><%= t('mylearning_becomes_available', new Date(s.startDate).toLocaleDateString()) %></p>
            </div>
          <% }) %>
        </div>
      <% } %>

      <% if (completed.length > 0) { %>
        <h2 style="font-size:1.3rem;margin-bottom:16px"><%= t('mylearning_completed') %></h2>
        <div class="why-grid" style="grid-template-columns:repeat(2,1fr);gap:20px;margin-bottom:36px">
          <% completed.forEach(s => { %>
            <div class="card">
              <h3 style="margin:0 0 4px"><%= s.course.title %></h3>
              <p style="font-size:.85rem;color:var(--muted);margin:0 0 10px"><%= t('mylearning_completed_on', new Date(s.completedAt).toLocaleDateString()) %></p>
              <a href="/student/lms/courses/<%= s.course.id %>" class="btn btn-navy btn-sm"><%= t('mylearning_review_course') %></a>
              <% if (s.certificate) { %>
                <a href="/account/certificates/<%= s.certificate.id %>/download" class="btn btn-outline btn-sm" target="_blank" rel="noopener"><%= t('mylearning_certificate') %></a>
                <a href="/account/certificates/<%= s.certificate.id %>/badge" class="btn btn-outline btn-sm" target="_blank" rel="noopener"><%= t('mylearning_badge') %></a>
              <% } %>
            </div>
          <% }) %>
        </div>
      <% } %>

      <% if (expired.length > 0) { %>
        <h2 style="font-size:1.3rem;margin-bottom:16px"><%= t('mylearning_expired') %></h2>
        <div class="why-grid" style="grid-template-columns:repeat(2,1fr);gap:20px">
          <% expired.forEach(s => { %>
            <div class="card">
              <h3 style="margin:0 0 4px"><%= s.course.title %></h3>
              <p style="font-size:.85rem;color:var(--muted);margin:0"><%= t('mylearning_access_ended', new Date(s.endDate).toLocaleDateString()) %></p>
            </div>
          <% }) %>
        </div>
      <% } %>

    <% } %>
  </div>
</section>

<%- include('../partials/footer') %>
