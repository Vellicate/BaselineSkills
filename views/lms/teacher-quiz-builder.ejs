<%- include('../partials/header') %>

<section class="section-tight" style="background:#fff;border-bottom:1px solid var(--line)">
  <div class="container">
    <a href="/trainer/lms/courses/<%= course.id %>" style="font-size:.85rem;color:var(--muted)">&larr; <%= course.title %></a>
    <h1 style="font-size:1.8rem;margin-top:8px">Quiz: <%= lesson.title %></h1>
    <a href="/trainer/lms/quizzes/<%= quiz.id %>/grading" class="btn btn-outline btn-sm" style="margin-top:8px">Grade short-answer responses</a>
  </div>
</section>

<section class="section">
  <div class="container" style="max-width:820px">

    <div class="card" style="margin-bottom:24px">
      <h3 style="margin-top:0">Quiz settings</h3>
      <form method="POST" action="/trainer/lms/quizzes/<%= quiz.id %>/settings" style="display:flex;gap:16px;flex-wrap:wrap;align-items:flex-end">
        <div class="form-field">
          <label for="timeLimitMinutes">Time limit (minutes)</label>
          <input type="number" id="timeLimitMinutes" name="timeLimitMinutes" min="1" value="<%= quiz.timeLimitSeconds ? Math.round(quiz.timeLimitSeconds/60) : '' %>" placeholder="No limit">
        </div>
        <div class="form-field">
          <label for="maxAttempts">Max attempts</label>
          <input type="number" id="maxAttempts" name="maxAttempts" min="1" value="<%= quiz.maxAttempts %>" required>
        </div>
        <div class="form-field">
          <label for="passPercentage">Pass percentage</label>
          <input type="number" id="passPercentage" name="passPercentage" min="0" max="100" value="<%= quiz.passPercentage %>" required>
        </div>
        <div class="form-field" style="display:flex;align-items:center;gap:6px">
          <input type="checkbox" id="negativeMarkingEnabled" name="negativeMarkingEnabled" <%= quiz.negativeMarkingEnabled ? 'checked' : '' %> style="width:auto">
          <label for="negativeMarkingEnabled" style="margin:0">Negative marking</label>
        </div>
        <div class="form-field" style="display:flex;align-items:center;gap:6px">
          <input type="checkbox" id="showCorrectAnswers" name="showCorrectAnswers" <%= quiz.showCorrectAnswers ? 'checked' : '' %> style="width:auto">
          <label for="showCorrectAnswers" style="margin:0">Show correct answers on review</label>
        </div>
        <button type="submit" class="btn btn-navy btn-sm">Save settings</button>
      </form>
    </div>

    <div class="card" style="margin-bottom:24px">
      <h3 style="margin-top:0">Case studies</h3>
      <p style="font-size:.85rem;color:var(--muted)">Stored once, then linked from any question below.</p>
      <% caseStudies.forEach(cs => { %>
        <div style="padding:10px 12px;background:var(--bg-soft,#F1F5F9);border-radius:8px;margin-bottom:8px;display:flex;justify-content:space-between;align-items:center;gap:10px">
          <div><strong><%= cs.title || 'Untitled case study' %></strong><div style="font-size:.8rem;color:var(--muted)"><%- cs.content.slice(0, 120) %>&hellip;</div></div>
          <form method="POST" action="/trainer/lms/case-studies/<%= cs.id %>/delete" onsubmit="return confirm('Delete this case study? Its questions will remain as standalone questions.')">
            <button type="submit" class="btn btn-outline btn-sm" style="color:#B91C1C">Delete</button>
          </form>
        </div>
      <% }) %>
      <details style="margin-top:8px">
        <summary style="cursor:pointer;font-size:.85rem;font-weight:600">+ Add case study</summary>
        <form method="POST" action="/trainer/lms/quizzes/<%= quiz.id %>/case-studies" style="margin-top:10px">
          <div class="form-field"><label>Title (optional)</label><input type="text" name="title"></div>
          <div class="form-field"><label>Content</label><textarea name="content" rows="4" required></textarea></div>
          <button type="submit" class="btn btn-outline btn-sm">Add case study</button>
        </form>
      </details>
    </div>

    <div class="card">
      <h3 style="margin-top:0">Questions</h3>
      <div id="questions-list">
        <% questions.forEach(q => { %>
          <div class="question-row" data-question-id="<%= q.id %>" style="padding:12px;background:var(--bg-soft,#F1F5F9);border-radius:8px;margin-bottom:10px">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:10px">
              <div>
                <span class="drag-handle" aria-hidden="true" style="cursor:grab;color:var(--muted)">&#9776;</span>
                <strong><%- q.questionText %></strong>
                <div style="font-size:.78rem;color:var(--muted)">
                  <%= q.questionType.replace('_',' ') %> &middot; <%= q.marks %> mark<%= q.marks===1?'':'s' %><% if (q.negativeMarks > 0) { %> &middot; -<%= q.negativeMarks %> if wrong<% } %>
                  <% if (q.caseStudyId) { %> &middot; linked to case study<% } %>
                </div>
              </div>
              <form method="POST" action="/trainer/lms/questions/<%= q.id %>/delete" onsubmit="return confirm('Delete this question? Any past attempts that answered it keep their historical record.')">
                <button type="submit" class="btn btn-outline btn-sm" style="color:#B91C1C">Delete</button>
              </form>
            </div>
            <% if (q.options.length > 0) { %>
              <ul style="margin:8px 0 0;padding-left:20px;font-size:.85rem">
                <% q.options.forEach(o => { %><li style="<%= o.isCorrect ? 'color:#166534;font-weight:600' : '' %>"><%= o.optionText %><%= o.isCorrect ? ' \u2713' : '' %></li><% }) %>
              </ul>
            <% } %>
          </div>
        <% }) %>
      </div>

      <details>
        <summary style="cursor:pointer;font-size:.85rem;font-weight:600">+ Add question</summary>
        <form method="POST" action="/trainer/lms/quizzes/<%= quiz.id %>/questions" style="margin-top:10px" id="question-form">
          <div class="form-field">
            <label for="questionType">Question type</label>
            <select id="questionType" name="questionType" onchange="updateQuestionTypeUI()">
              <option value="MCQ">Multiple choice (single answer)</option>
              <option value="MULTI_SELECT">Multiple choice (multiple answers)</option>
              <option value="TRUE_FALSE">True / False</option>
              <option value="SHORT_ANSWER">Short answer (manually graded)</option>
            </select>
          </div>
          <div class="form-field"><label>Question text</label><textarea name="questionText" rows="2" required></textarea></div>
          <div class="form-field">
            <label>Case study (optional)</label>
            <select name="caseStudyId">
              <option value="">None</option>
              <% caseStudies.forEach(cs => { %><option value="<%= cs.id %>"><%= cs.title || 'Untitled case study' %></option><% }) %>
            </select>
          </div>

          <div id="options-mcq-multi">
            <p style="font-size:.8rem;color:var(--muted);margin-bottom:4px">Fill in the options you need; leave the rest blank. Mark the correct one(s).</p>
            <% for (let i = 0; i < 6; i++) { %>
              <div style="display:flex;gap:8px;align-items:center;margin-bottom:6px">
                <input type="radio" name="correctOption" value="<%= i %>" class="correct-radio">
                <input type="checkbox" name="optionCorrect<%= i %>" class="correct-checkbox" style="display:none">
                <input type="text" name="optionText<%= i %>" placeholder="Option <%= i+1 %>" style="flex:1">
              </div>
            <% } %>
          </div>

          <div id="options-truefalse" style="display:none">
            <div class="form-field">
              <label>Correct answer</label>
              <select name="trueFalseAnswer">
                <option value="true">True</option>
                <option value="false">False</option>
              </select>
            </div>
          </div>

          <div class="form-field"><label>Explanation / feedback (optional, shown after grading)</label><textarea name="explanation" rows="2"></textarea></div>
          <div style="display:flex;gap:16px">
            <div class="form-field"><label>Marks</label><input type="number" name="marks" min="0.5" step="0.5" value="1" required></div>
            <div class="form-field"><label>Negative marks if wrong</label><input type="number" name="negativeMarks" min="0" step="0.5" value="0"></div>
          </div>
          <button type="submit" class="btn btn-navy btn-sm">Add question</button>
        </form>
      </details>
    </div>

  </div>
</section>

<script>
function updateQuestionTypeUI() {
  const type = document.getElementById('questionType').value;
  document.getElementById('options-mcq-multi').style.display = (type === 'SHORT_ANSWER' || type === 'TRUE_FALSE') ? 'none' : 'block';
  document.getElementById('options-truefalse').style.display = type === 'TRUE_FALSE' ? 'block' : 'none';
  document.querySelectorAll('.correct-radio').forEach(el => el.style.display = type === 'MULTI_SELECT' ? 'none' : 'inline-block');
  document.querySelectorAll('.correct-checkbox').forEach(el => el.style.display = type === 'MULTI_SELECT' ? 'inline-block' : 'none');
}
updateQuestionTypeUI();

function reorderQuestions() {
  const ids = Array.from(document.querySelectorAll('.question-row')).map(el => el.dataset.questionId);
  fetch('/trainer/lms/quizzes/<%= quiz.id %>/questions/reorder', {
    method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ orderedIds: ids }),
  }).then(r => { if (!r.ok) location.reload(); });
}
const questionsList = document.getElementById('questions-list');
questionsList.querySelectorAll('.question-row').forEach(el => el.setAttribute('draggable', 'true'));
let draggedQ = null;
questionsList.addEventListener('dragstart', e => { const item = e.target.closest('.question-row'); if (item) draggedQ = item; });
questionsList.addEventListener('dragover', e => {
  e.preventDefault();
  const target = e.target.closest('.question-row');
  if (!target || target === draggedQ) return;
  const rect = target.getBoundingClientRect();
  questionsList.insertBefore(draggedQ, (e.clientY - rect.top) < rect.height / 2 ? target : target.nextSibling);
});
questionsList.addEventListener('drop', reorderQuestions);
</script>

<%- include('../partials/footer') %>
