<%- include('../partials/header') %>

<%
// Section 49's timezone principle applied here too, not just deadlines:
// format using the application's own date handling rather than mixing
// browser-local and server/database time. toLocaleDateString with an
// explicit locale/options keeps this server-rendered and consistent
// regardless of the visitor's own browser locale.
function formatLmsDate(iso) {
  if (!iso) return '';
  return new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
}
%>

<section class="section" style="padding-top:80px;padding-bottom:80px">
  <div class="container" style="max-width:560px;text-align:center">
    <div class="card" style="padding:40px 32px">
      <h1 style="font-size:1.5rem;margin-top:0">
        <% if (reason === 'not_enrolled') { %>You don't have access to this content.
        <% } else if (reason === 'lesson_locked') { %>This lesson isn't available to you yet.
        <% } else if (reason === 'not_started') { %>This course isn't open yet.
        <% } else if (reason === 'ended') { %>This course is no longer available.
        <% } else { %>Access required.
        <% } %>
      </h1>
      <p class="lead" style="color:var(--muted)">
        <% if (reason === 'not_enrolled') { %>
          You'll need to register for <strong><%= course.title %></strong> to access its course content.
        <% } else if (reason === 'not_started') { %>
          This course becomes available on <strong><%= formatLmsDate(course.lmsAccessStartDate) %></strong>.
        <% } else if (reason === 'ended') { %>
          Your access to <strong><%= course.title %></strong> ended on <strong><%= formatLmsDate(course.lmsAccessEndDate) %></strong>.
        <% } else { %>
          Some content in <strong><%= course.title %></strong> is only available once you're registered.
        <% } %>
      </p>
      <a href="/courses/<%= course.slug %>" class="btn btn-navy">View course details</a>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
