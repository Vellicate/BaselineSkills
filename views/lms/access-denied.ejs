<%- include('../partials/header') %>

<%
// Section 49's timezone principle applied here too, not just deadlines:
// format using the application's own date handling rather than mixing
// browser-local and server/database time. toLocaleDateString with an
// explicit locale/options keeps this server-rendered and consistent
// regardless of the visitor's own browser locale.
function formatLmsDate(iso) {
  if (!iso) return '';
  return new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
}
%>

<section class="section" style="padding-top:80px;padding-bottom:80px">
  <div class="container" style="max-width:560px;text-align:center">
    <div class="card" style="padding:40px 32px">
      <h1 style="font-size:1.5rem;margin-top:0">
        <% if (reason === 'not_enrolled') { %><%= t('denied_not_enrolled_title') %>
        <% } else if (reason === 'lesson_locked') { %><%= t('denied_lesson_locked_title') %>
        <% } else if (reason === 'not_started') { %><%= t('denied_not_started_title') %>
        <% } else if (reason === 'ended') { %><%= t('denied_ended_title') %>
        <% } else { %><%= t('denied_default_title') %>
        <% } %>
      </h1>
      <p class="lead" style="color:var(--muted)">
        <% if (reason === 'not_enrolled') { %>
          <%- t('denied_not_enrolled_lead', '<strong>' + course.title + '</strong>') %>
        <% } else if (reason === 'not_started') { %>
          <%- t('denied_not_started_lead', '<strong>' + formatLmsDate(course.lmsAccessStartDate) + '</strong>') %>
        <% } else if (reason === 'ended') { %>
          <%- t('denied_ended_lead', '<strong>' + course.title + '</strong>', '<strong>' + formatLmsDate(course.lmsAccessEndDate) + '</strong>') %>
        <% } else { %>
          <%- t('denied_default_lead', '<strong>' + course.title + '</strong>') %>
        <% } %>
      </p>
      <a href="/courses/<%= course.slug %>" class="btn btn-navy"><%= t('denied_view_course') %></a>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
