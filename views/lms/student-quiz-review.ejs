<%
// Maps a stored answerData value (an option id, an array of option ids,
// or raw text) back to readable text for display -- the DB never stores
// display text for MCQ/MULTI_SELECT/TRUE_FALSE answers (Section 45), so
// this lookup is what turns that back into something a student can read.
function optionText(options, id) {
  const opt = options.find(o => o.id === id);
  return opt ? opt.optionText : t('quizreview_no_answer');
}
function formatAnswer(q, answerData) {
  if (answerData == null) return t('quizreview_no_answer');
  if (q.questionType === 'SHORT_ANSWER') return answerData || '(no answer)';
  if (q.questionType === 'MULTI_SELECT') {
    if (!Array.isArray(answerData) || answerData.length === 0) return '(no answer)';
    return answerData.map(id => optionText(q.options, id)).join(', ');
  }
  return optionText(q.options, answerData);
}
function correctAnswerText(q) {
  const correct = q.options.filter(o => o.isCorrect);
  return correct.map(o => o.optionText).join(', ');
}
%>
<%- include('../partials/header') %>

<section class="section-tight" style="background:#fff;border-bottom:1px solid var(--line)">
  <div class="container">
    <a href="/student/lms/lessons/<%= lesson.id %>/quiz" style="font-size:.85rem;color:var(--muted)">&larr; <%= lesson.title %></a>
    <h1 style="font-size:1.6rem;margin-top:8px"><%= t('quizreview_title', attempt.attemptNumber) %></h1>
  </div>
</section>

<section class="section">
  <div class="container" style="max-width:720px">

    <div id="wrong-answer-nav" style="display:none;margin-bottom:16px;text-align:center">
      <button type="button" class="btn btn-outline btn-sm" id="prev-wrong-btn">&larr; <%= t('quizreview_prev_wrong') %></button>
      <span id="wrong-nav-status" style="font-size:.85rem;color:var(--muted);margin:0 10px"></span>
      <button type="button" class="btn btn-outline btn-sm" id="next-wrong-btn"><%= t('quizreview_next_wrong') %> &rarr;</button>
    </div>

    <% caseStudies.forEach(cs => { %>
      <div class="card" style="background:var(--bg-soft,#F1F5F9);margin-bottom:16px">
        <% if (cs.title) { %><h4 style="margin-top:0"><%= cs.title %></h4><% } %>
        <div><%- cs.content %></div>
      </div>
    <% }) %>

    <% questionsWithAnswers.forEach((q, i) => { %>
      <% const isGraded = q.answer && q.answer.isCorrect != null; %>
      <% const isCorrect = q.answer && q.answer.isCorrect === true; %>
      <div class="card question-review-card" data-is-wrong="<%= isGraded && !isCorrect ? 'true' : 'false' %>" style="margin-bottom:16px;<%= isGraded ? (isCorrect ? 'border-left:4px solid #166534' : 'border-left:4px solid #991B1B') : '' %>">
        <p style="font-weight:600"><%= i+1 %>. <%- q.questionText %></p>
        <p style="font-size:.9rem"><strong><%= t('quizreview_your_answer') %></strong> <%= formatAnswer(q, q.answer ? q.answer.answerData : null) %></p>
        <% if (q.questionType === 'SHORT_ANSWER') { %>
          <p style="font-size:.85rem;color:var(--muted)">
            <% if (q.answer && q.answer.marksAwarded != null) { %>
              <%= t('quizreview_graded_marks', q.answer.marksAwarded, q.marks) %>
            <% } else { %>
              <%= t('quizreview_awaiting_grading') %>
            <% } %>
          </p>
        <% } else { %>
          <% if (quiz.showCorrectAnswers && !isCorrect) { %>
            <p style="font-size:.9rem;color:#166534"><strong><%= t('quizreview_correct_answer') %></strong> <%= correctAnswerText(q) %></p>
          <% } %>
          <p style="font-size:.85rem;color:var(--muted)"><%= isCorrect ? t('quizreview_correct') : t('quizreview_incorrect') %> &middot; <%= t('quizreview_marks', q.answer ? q.answer.marksAwarded : 0, q.marks) %></p>
        <% } %>
        <% if (q.explanation) { %><p style="font-size:.85rem;color:var(--muted);font-style:italic"><%- q.explanation %></p><% } %>
      </div>
    <% }) %>

  </div>
</section>

<script>
const i18nWrongStatus = <%- JSON.stringify(t('quizreview_js_wrong_status', '{0}', '{1}')) %>;
const i18nNoWrong = <%- JSON.stringify(t('quizreview_js_no_wrong')) %>;
const wrongCards = Array.from(document.querySelectorAll('.question-review-card')).filter(el => el.dataset.isWrong === 'true');
let wrongIndex = -1;
if (wrongCards.length > 0) {
  document.getElementById('wrong-answer-nav').style.display = 'block';
  function goToWrong(index) {
    wrongIndex = ((index % wrongCards.length) + wrongCards.length) % wrongCards.length;
    wrongCards[wrongIndex].scrollIntoView({ behavior: 'smooth', block: 'center' });
    document.getElementById('wrong-nav-status').textContent = i18nWrongStatus.replace('{0}', wrongIndex + 1).replace('{1}', wrongCards.length);
  }
  document.getElementById('next-wrong-btn').addEventListener('click', () => goToWrong(wrongIndex + 1));
  document.getElementById('prev-wrong-btn').addEventListener('click', () => goToWrong(wrongIndex - 1));
  goToWrong(0);
} else {
  document.getElementById('wrong-answer-nav').innerHTML = '<p style="color:#166534;font-size:.9rem">' + i18nNoWrong + '</p>';
  document.getElementById('wrong-answer-nav').style.display = 'block';
}
</script>

<%- include('../partials/footer') %>
