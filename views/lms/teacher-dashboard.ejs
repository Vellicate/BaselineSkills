<%- include('../partials/header') %>

<section class="section-tight" style="background:#fff;border-bottom:1px solid var(--line)">
  <div class="container">
    <span class="eyebrow">LMS</span>
    <h1 style="font-size:2rem">Course content, <%= instructor.name %>.</h1>
    <p class="lead">Build and manage the modules, lessons and materials for the courses you deliver.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <% if (courseSummaries.length === 0) { %>
      <div class="card" style="text-align:center;padding:48px 24px">
        <p class="lead" style="color:var(--muted);margin:0">You don't have any courses assigned yet. Once you're assigned as the trainer for a course, it will appear here for you to build out.</p>
      </div>
    <% } else { %>
      <div class="why-grid" style="grid-template-columns:repeat(2,1fr);gap:20px">
        <% courseSummaries.forEach(s => { %>
          <div class="card">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:12px">
              <div>
                <h3 style="margin:0 0 4px"><%= s.course.title %></h3>
                <p style="margin:0;color:var(--muted);font-size:.85rem">
                  <%= s.course.lmsDeliveryMode ? s.course.lmsDeliveryMode.replace('_',' ') : 'No delivery mode set yet' %>
                </p>
              </div>
              <% if (s.course.published) { %><span class="pill" style="background:#F0FDF4;color:#166534">Live on site</span><% } else { %><span class="pill">Draft</span><% } %>
            </div>
            <div style="display:flex;gap:20px;margin:16px 0;font-size:.85rem;color:var(--muted)">
              <span><strong style="color:var(--navy)"><%= s.moduleCount %></strong> module<%= s.moduleCount === 1 ? '' : 's' %></span>
              <span><strong style="color:var(--navy)"><%= s.lessonCount %></strong> lesson<%= s.lessonCount === 1 ? '' : 's' %></span>
              <span><strong style="color:var(--navy)"><%= s.publishedLessonCount %></strong> published</span>
            </div>
            <a href="/trainer/lms/courses/<%= s.course.id %>" class="btn btn-navy btn-sm"><%= s.moduleCount === 0 ? 'Start building' : 'Continue editing' %></a>
            <% if (s.moduleCount > 0) { %>
              <a href="/trainer/lms/courses/<%= s.course.id %>/preview" class="btn btn-outline btn-sm" target="_blank" rel="noopener">Preview</a>
            <% } %>
            <a href="/trainer/lms/courses/<%= s.course.id %>/analytics" class="btn btn-outline btn-sm">Analytics</a>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</section>

<%- include('../partials/footer') %>
