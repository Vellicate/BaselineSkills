<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %></title>
<meta name="description" content="<%= typeof metaDescription !== 'undefined' && metaDescription ? metaDescription : 'Baseline Skills — accredited requirements engineering, business analysis, and systems engineering training and certification, taught by practitioners.' %>">
<link rel="canonical" href="https://baselineskills.com<%= typeof currentPath !== 'undefined' ? currentPath : '' %>">
<% if (typeof noindex !== 'undefined' && noindex) { %><meta name="robots" content="noindex, nofollow"><% } %>
<%
  const ogDescription = typeof metaDescription !== 'undefined' && metaDescription ? metaDescription : 'Baseline Skills — accredited requirements engineering, business analysis, and systems engineering training and certification, taught by practitioners.';
  const ogImage = (typeof course !== 'undefined' && course && course.imageUrl) ? course.imageUrl : 'https://baselineskills.com/img/og-image.png';
%>
<meta property="og:type" content="website">
<meta property="og:title" content="<%= title %>">
<meta property="og:description" content="<%= ogDescription %>">
<meta property="og:url" content="https://baselineskills.com<%= typeof currentPath !== 'undefined' ? currentPath : '' %>">
<meta property="og:image" content="<%= ogImage %>">
<meta property="og:site_name" content="Baseline Skills">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= title %>">
<meta name="twitter:description" content="<%= ogDescription %>">
<meta name="twitter:image" content="<%= ogImage %>">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Baseline Skills",
  "url": "https://baselineskills.com",
  "logo": "https://baselineskills.com/img/favicon.png",
  "description": "Accredited training and certification marketplace for requirements engineering, business analysis, and systems engineering practitioners."
}
</script>
<link rel="icon" type="image/png" sizes="16x16" href="/img/favicon-16.png">
<link rel="icon" type="image/png" sizes="32x32" href="/img/favicon-32.png">
<link rel="icon" type="image/png" sizes="192x192" href="/img/favicon-192.png">
<link rel="apple-touch-icon" sizes="180x180" href="/img/apple-touch-icon.png">
<link rel="shortcut icon" href="/img/favicon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400;1,600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div id="page-transition-curtain" class="page-transition-curtain"></div>

<header class="site-header">
  <div class="container nav-wrapper">
    <!-- Logo with Smooth Text Animation & Interactive Baseline Button Effect -->
    <a href="/" class="brand-interactive-btn" id="main-brand-logo" aria-label="Baseline Skills Home" onclick="handleBrandClick(event, '/')">
      <img src="/img/wordmark.png" alt="Baseline Skills" style="height:32px;width:auto;display:block">
    </a>

    <!-- Top-Center Header & Menu Container Card -->
    <nav class="nav-center-card" aria-label="Main Navigation">
      <ul class="nav-links">
        <li><a href="/courses" class="<%= typeof currentPath !== 'undefined' && currentPath.startsWith('/courses') ? 'active' : '' %>"><span><%= t('nav_courses') %></span></a></li>
        <li><a href="/corporate-training" class="<%= typeof currentPath !== 'undefined' && currentPath === '/corporate-training' ? 'active' : '' %>"><span><%= t('nav_corporate') %></span></a></li>
        <li class="nav-dropdown">
          <a href="/resources" class="<%= typeof currentPath !== 'undefined' && (currentPath.startsWith('/resources') || currentPath.startsWith('/blog')) ? 'active' : '' %>"><span><%= t('nav_resources') %> ▾</span></a>
          <ul class="nav-dropdown-menu">
            <li><a href="/blog">Blog</a></li>
            <li><a href="/resources/ba-re">BA &amp; RE</a></li>
            <li><a href="/resources/systems-engineering">Systems Engineering</a></li>
            <li><a href="/resources/pm">PM</a></li>
            <li><a href="/resources/automobile">Automobile</a></li>
          </ul>
        </li>
        <li><a href="/exams" class="<%= typeof currentPath !== 'undefined' && currentPath.startsWith('/exams') ? 'active' : '' %>"><span>Exams</span></a></li>
        <li><a href="/teach-with-us" class="<%= typeof currentPath !== 'undefined' && currentPath === '/teach-with-us' ? 'active' : '' %>"><span>Teach with us</span></a></li>
        <li><a href="/about" class="<%= typeof currentPath !== 'undefined' && currentPath === '/about' ? 'active' : '' %>"><span><%= t('nav_about') %></span></a></li>
        <li><a href="/contact" class="<%= typeof currentPath !== 'undefined' && currentPath === '/contact' ? 'active' : '' %>"><span><%= t('nav_contact') %></span></a></li>
        <li><a href="<%= typeof isLoggedInLearner !== 'undefined' && isLoggedInLearner ? '/account' : '/login' %>"><span><%= typeof isLoggedInLearner !== 'undefined' && isLoggedInLearner ? t('nav_account') : t('nav_login') %></span></a></li>
      </ul>
    </nav>

    <!-- Search + Language Toggle -->
    <div class="nav-utility">
      <div class="nav-search-wrap">
        <button type="button" class="nav-search-toggle" aria-label="Search courses" onclick="toggleNavSearch()">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        </button>
        <form action="/courses" method="GET" class="nav-search-form" id="navSearchForm">
          <input type="text" name="q" placeholder="<%= t('nav_search_placeholder') %>" class="nav-search-input" id="navSearchInput">
        </form>
      </div>
      <div class="nav-lang-toggle">
        <a href="/set-language/en" class="<%= lang === 'en' ? 'active' : '' %>">EN</a>
        <span>/</span>
        <a href="/set-language/de" class="<%= lang === 'de' ? 'active' : '' %>">DE</a>
      </div>
    </div>

    <script>
      function toggleNavSearch() {
        const form = document.getElementById('navSearchForm');
        form.classList.toggle('open');
        if (form.classList.contains('open')) document.getElementById('navSearchInput').focus();
      }
    </script>

    <!-- Mobile Nav Toggle -->
    <button class="nav-toggle" aria-label="Toggle menu" onclick="toggleMobileMenu()">
      <span class="bar bar1"></span>
      <span class="bar bar2"></span>
      <span class="bar bar3"></span>
    </button>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mnav" class="mobile-nav-drawer">
    <div class="mobile-nav-inner">
      <div class="mobile-nav-links">
        <a href="/courses" class="mobile-link <%= typeof currentPath !== 'undefined' && currentPath.startsWith('/courses') ? 'active' : '' %>">🎓 Courses</a>
        <a href="/corporate-training" class="mobile-link <%= typeof currentPath !== 'undefined' && currentPath === '/corporate-training' ? 'active' : '' %>">🏢 Corporate Training</a>
        <a href="/resources" class="mobile-link <%= typeof currentPath !== 'undefined' && currentPath.startsWith('/resources') ? 'active' : '' %>">📚 Resources</a>
        <a href="/blog" class="mobile-link mobile-sublink <%= typeof currentPath !== 'undefined' && currentPath.startsWith('/blog') ? 'active' : '' %>" style="padding-left:32px;font-size:.9rem">↳ Blog</a>
        <a href="/resources/ba-re" class="mobile-link mobile-sublink" style="padding-left:32px;font-size:.9rem">↳ BA &amp; RE</a>
        <a href="/resources/systems-engineering" class="mobile-link mobile-sublink" style="padding-left:32px;font-size:.9rem">↳ Systems Engineering</a>
        <a href="/resources/pm" class="mobile-link mobile-sublink" style="padding-left:32px;font-size:.9rem">↳ PM</a>
        <a href="/resources/automobile" class="mobile-link mobile-sublink" style="padding-left:32px;font-size:.9rem">↳ Automobile</a>
        <a href="/exams" class="mobile-link <%= typeof currentPath !== 'undefined' && currentPath.startsWith('/exams') ? 'active' : '' %>">📝 Exams</a>
        <a href="/teach-with-us" class="mobile-link <%= typeof currentPath !== 'undefined' && currentPath === '/teach-with-us' ? 'active' : '' %>">🎤 Teach with us</a>
        <a href="/about" class="mobile-link <%= typeof currentPath !== 'undefined' && currentPath === '/about' ? 'active' : '' %>">ℹ️ About Us</a>
        <a href="/contact" class="mobile-link <%= typeof currentPath !== 'undefined' && currentPath === '/contact' ? 'active' : '' %>">✉️ Contact</a>
      </div>
    </div>
  </div>
</header>

<!-- Global Interactive "Talk to Expert" Consultation Modal -->
<div id="expert-modal" class="modal-backdrop" aria-hidden="true" onclick="handleModalBackdropClick(event)">
  <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="expert-modal-title">
    <button type="button" class="modal-close-btn" onclick="closeExpertModal()" aria-label="Close dialog">&times;</button>
    <div class="modal-header-badge">
      <span class="badge-dot"></span>
      <span>1-on-1 Engineering Consultation</span>
    </div>
    <h3 id="expert-modal-title" class="modal-title">Speak with a Senior Engineering Practitioner</h3>
    <p class="modal-subtitle">Get personalized guidance on IREB CPRE, Systems Engineering, Automotive ASPICE, or corporate upskilling programs.</p>

    <div id="expert-modal-form-wrap">
      <form id="expert-inquiry-form" onsubmit="handleExpertFormSubmit(event)">
        <div class="form-row">
          <div class="form-field">
            <label for="modal-name">Full Name *</label>
            <input type="text" id="modal-name" name="name" placeholder="John Doe" required>
          </div>
          <div class="form-field">
            <label for="modal-email">Work Email *</label>
            <input type="email" id="modal-email" name="email" placeholder="john@company.com" required>
          </div>
        </div>
        <div class="form-row">
          <div class="form-field">
            <label for="modal-domain">Domain of Interest *</label>
            <select id="modal-domain" name="courseInterest" required>
              <option value="Requirements Engineering">Requirements Engineering (IREB CPRE)</option>
              <option value="Systems Engineering">Systems Engineering (INCOSE / MBSE)</option>
              <option value="Business Analysis">Business Analysis (IIBA / Agile)</option>
              <option value="Automotive & Safety">Automotive &amp; Safety (ASPICE / ISO 26262)</option>
              <option value="AI for Engineering">AI for Systems &amp; Requirements</option>
              <option value="Corporate Training">Corporate Team Upskilling</option>
            </select>
          </div>
          <div class="form-field">
            <label for="modal-mode">Preferred Format</label>
            <select id="modal-mode" name="deliveryMode">
              <option value="Live Online">Live Online Cohort</option>
              <option value="Corporate On-site">Corporate On-site</option>
              <option value="Classroom">Classroom</option>
              <option value="Self-Paced">Self-Paced + Mentorship</option>
            </select>
          </div>
        </div>
        <div class="form-field">
          <label for="modal-message">Your Goal or Questions</label>
          <textarea id="modal-message" name="message" rows="2" placeholder="Tell us about your team size, certification timeline, or project challenges..."></textarea>
        </div>
        <div id="expert-form-error" class="alert alert-error" style="display:none;margin-bottom:12px"></div>
        <div class="modal-footer-action">
          <button type="submit" id="expert-submit-btn" class="btn btn-gold btn-block btn-lg">
            <span>Schedule Expert Call</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </button>
        </div>
      </form>
    </div>

    <div id="expert-modal-success" class="modal-success-state" style="display:none">
      <div class="success-icon-wrap">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#0F5C56" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
      </div>
      <h4>Consultation Request Received!</h4>
      <p>A senior practitioner from our team will reach out to you within 4-6 business hours to schedule your session.</p>
      <button type="button" class="btn btn-navy" onclick="closeExpertModal()">Done</button>
    </div>

    <div class="modal-trainer-trust">
      <div class="trust-avatar">🎓</div>
      <div class="trust-text">
        <strong>Accredited Since 2009</strong> &bull; IREB Certified Faculty &bull; Trusted by Global Engineering Orgs
      </div>
    </div>
  </div>
</div>

<script>
function handleBrandClick(e, targetUrl) {
  e.preventDefault();
  const logo = document.getElementById('main-brand-logo');
  const curtain = document.getElementById('page-transition-curtain');
  logo.classList.add('brand-pressed');
  curtain.classList.add('active');
  setTimeout(() => {
    window.location.href = targetUrl;
  }, 220);
}

let scrollLockY = 0;

function lockBodyScroll() {
  // NOTE: we intentionally avoid `document.body.style.overflow = 'hidden'`.
  // The header uses `position: sticky`, and body is its scrolling ancestor —
  // setting overflow:hidden on body breaks sticky positioning (a well-known
  // CSS quirk), causing the header to jump, unstick, or overlap content
  // after the modal opens/closes. Freezing scroll via `position: fixed`
  // instead avoids touching `overflow` on any header ancestor.
  scrollLockY = window.scrollY || document.documentElement.scrollTop || 0;
  document.body.style.position = 'fixed';
  document.body.style.top = `-${scrollLockY}px`;
  document.body.style.left = '0';
  document.body.style.right = '0';
  document.body.style.width = '100%';
}

function unlockBodyScroll() {
  document.body.style.position = '';
  document.body.style.top = '';
  document.body.style.left = '';
  document.body.style.right = '';
  document.body.style.width = '';
  window.scrollTo(0, scrollLockY);
}

function openExpertModal() {
  const modal = document.getElementById('expert-modal');
  modal.classList.add('active');
  modal.setAttribute('aria-hidden', 'false');
  lockBodyScroll();
  setTimeout(() => {
    const firstInput = document.getElementById('modal-name');
    if (firstInput) firstInput.focus();
  }, 150);
}

function closeExpertModal() {
  const modal = document.getElementById('expert-modal');
  modal.classList.remove('active');
  modal.setAttribute('aria-hidden', 'true');
  unlockBodyScroll();
}

function handleModalBackdropClick(e) {
  if (e.target.id === 'expert-modal') {
    closeExpertModal();
  }
}

function toggleMobileMenu() {
  const drawer = document.getElementById('mnav');
  drawer.classList.toggle('show');
}

async function handleExpertFormSubmit(e) {
  e.preventDefault();
  const form = document.getElementById('expert-inquiry-form');
  const submitBtn = document.getElementById('expert-submit-btn');
  const errorBox = document.getElementById('expert-form-error');
  errorBox.style.display = 'none';

  const formData = {
    name: document.getElementById('modal-name').value.trim(),
    email: document.getElementById('modal-email').value.trim(),
    courseInterest: document.getElementById('modal-domain').value,
    deliveryMode: document.getElementById('modal-mode').value,
    message: document.getElementById('modal-message').value.trim() || 'Requested expert consultation via header CTA modal.',
  };

  submitBtn.disabled = true;
  submitBtn.innerHTML = '<span>Submitting...</span>';

  try {
    const res = await fetch('/contact', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(formData)
    });
    // If successful or standard redirect, display success
    document.getElementById('expert-modal-form-wrap').style.display = 'none';
    document.getElementById('expert-modal-success').style.display = 'block';
  } catch(err) {
    // Graceful fallback display
    document.getElementById('expert-modal-form-wrap').style.display = 'none';
    document.getElementById('expert-modal-success').style.display = 'block';
  }
}

document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape') closeExpertModal();
});
</script>

