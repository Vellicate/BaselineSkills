<%- include('partials/header') %>

<section class="section-tight" style="background:#fff;border-bottom:1px solid var(--line)">
  <div class="container">
    <span class="eyebrow"><%= t('contact_eyebrow') %></span>
    <h1 style="font-size:2.1rem"><%= t('contact_title') %></h1>
  </div>
</section>

<section class="section">
  <div class="container grid-2" style="align-items:start">
    <div>
      <h3><%= t('contact_reach_us') %></h3>
      <p style="color:var(--muted)">Email: Contact@baselineskills.com<br>Phone: +91-903-507-5455<br><%= t('contact_response_time') %></p>
    </div>
    <div class="card">
      <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success"><%= t('contact_success') %></div>
      <% } %>
      <% if (typeof error !== 'undefined' && error) { %><div class="alert alert-error"><%= error %></div><% } %>
      <form method="POST" action="/contact">
        <div class="form-row">
          <div class="form-field"><label><%= t('common_name') %> *</label><input type="text" name="name" required></div>
          <div class="form-field"><label><%= t('common_email') %> *</label><input type="email" name="email" required></div>
        </div>
        <div class="form-row">
          <div class="form-field"><label><%= t('common_company') %></label><input type="text" name="company"></div>
          <div class="form-field"><label><%= t('common_role') %></label><input type="text" name="role"></div>
        </div>
        <div class="form-row">
          <div class="form-field"><label><%= t('common_course_of_interest') %></label><input type="text" name="courseInterest"></div>
          <div class="form-field"><label><%= t('common_team_size') %></label><input type="text" name="teamSize"></div>
        </div>
        <div class="form-field">
          <label><%= t('common_preferred_delivery_mode') %></label>
          <select name="deliveryMode">
            <option value="Live Online"><%= t('common_live_online') %></option><option value="Classroom"><%= t('common_classroom') %></option><option value="Corporate On-site"><%= t('common_corporate_onsite') %></option><option value="Not sure yet"><%= t('common_not_sure_yet') %></option>
          </select>
        </div>
        <div class="form-field"><label><%= t('common_message') %> *</label><textarea name="message" rows="4" required></textarea></div>
        <button type="submit" class="btn btn-navy btn-block"><%= t('contact_send_button') %></button>
      </form>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
