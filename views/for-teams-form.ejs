<%- include('partials/header') %>

<section class="course-header">
  <div class="container">
    <span class="tag">For Teams</span>
    <h1 style="color:#fff;margin-top:14px"><%= heading %></h1>
    <p style="color:rgba(255,255,255,.8);max-width:640px"><%= intro %></p>
  </div>
</section>

<section class="section">
  <div class="container" style="max-width:560px">
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="card" style="text-align:center;padding:32px">
        <h3>Thank you — we've received your request.</h3>
        <p style="color:var(--muted)">Someone from our team will be in touch shortly.</p>
        <a href="/" class="btn btn-outline" style="margin-top:12px">Back to homepage</a>
      </div>
    <% } else { %>
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-error" style="margin-bottom:16px"><%= error %></div>
      <% } %>

      <% if (formType === 'team-cohorts') { %>
      <form method="POST" action="/for-teams/team-cohorts" class="card">
        <div class="form-field"><label>Name *</label><input type="text" name="name" required value="<%= typeof form !== 'undefined' ? form.name : '' %>"></div>
        <div class="form-field"><label>Organization *</label><input type="text" name="company" required value="<%= typeof form !== 'undefined' ? form.company : '' %>"></div>
        <div class="form-field"><label>Work email *</label><input type="email" name="email" required value="<%= typeof form !== 'undefined' ? form.email : '' %>"></div>
        <div class="form-field"><label>Number of participants *</label><input type="text" name="teamSize" required value="<%= typeof form !== 'undefined' ? form.teamSize : '' %>"></div>
        <div class="form-field"><label>Course / interest</label><input type="text" name="courseInterest" placeholder="e.g. CPRE Foundation" value="<%= typeof form !== 'undefined' ? form.courseInterest : '' %>"></div>
        <div class="form-field">
          <label>Preferred delivery format</label>
          <select name="deliveryMode">
            <option value="Live Online">Live Online</option>
            <option value="In Person">In Person</option>
            <option value="Either">Either</option>
          </select>
        </div>
        <div class="form-field"><label>Message (preferred dates, location, or anything else)</label><textarea name="message" rows="4"><%= typeof form !== 'undefined' ? form.message : '' %></textarea></div>
        <p style="font-size:.8rem;color:var(--muted)">By submitting, you agree to be contacted about this request. We don't share your details outside Baseline Skills.</p>
        <button type="submit" class="btn btn-navy">Submit Request</button>
      </form>
      <% } else { %>
      <form method="POST" action="/for-teams/request-conversation" class="card">
        <div class="form-field"><label>Name *</label><input type="text" name="name" required value="<%= typeof form !== 'undefined' ? form.name : '' %>"></div>
        <div class="form-field"><label>Organization</label><input type="text" name="company" value="<%= typeof form !== 'undefined' ? form.company : '' %>"></div>
        <div class="form-field"><label>Email *</label><input type="email" name="email" required value="<%= typeof form !== 'undefined' ? form.email : '' %>"></div>
        <div class="form-field"><label>Phone</label><input type="text" name="phone" value="<%= typeof form !== 'undefined' ? form.phone : '' %>"></div>
        <div class="form-field"><label>Reason for contacting</label><input type="text" name="courseInterest" value="<%= typeof form !== 'undefined' ? form.courseInterest : '' %>"></div>
        <div class="form-field"><label>Message</label><textarea name="message" rows="4"><%= typeof form !== 'undefined' ? form.message : '' %></textarea></div>
        <p style="font-size:.8rem;color:var(--muted)">By submitting, you agree to be contacted about this request. We don't share your details outside Baseline Skills.</p>
        <button type="submit" class="btn btn-navy">Request Conversation</button>
      </form>
      <% } %>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>
