<%- include('partials/header') %>

<script type="application/ld+json">
<%- JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": post.title,
  "description": post.excerpt || post.title,
  "author": { "@type": "Person", "name": post.author },
  "datePublished": post.createdAt,
  "dateModified": post.updatedAt || post.createdAt,
  "publisher": { "@type": "Organization", "name": "Baseline Skills" },
}) %>
</script>
<script type="application/ld+json">
<%- JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": t('blog_eyebrow'), "item": "https://www.baselineskills.com/blog" },
    { "@type": "ListItem", "position": 2, "name": post.title, "item": `https://www.baselineskills.com/blog/${post.slug}` },
  ],
}) %>
</script>

<section class="course-header">
  <div class="container">
    <span class="tag"><%= post.category %></span>
    <h1 style="color:#fff;margin-top:14px"><%= post.title %></h1>
    <p style="color:rgba(255,255,255,.75);font-size:.9rem"><%= t('blog_by', post.author) %> &middot; <%= new Date(post.createdAt).toLocaleDateString() %></p>
  </div>
</section>

<div class="container course-body">
  <div>
    <p style="white-space:pre-line;color:var(--text);line-height:1.7"><%= post.body %></p>

    <% if (related.length) { %>
    <h2 style="margin-top:36px"><%= t('blog_related_posts') %></h2>
    <div class="grid-3">
      <% related.forEach(r => { %>
        <div class="card">
          <h4><%= r.title %></h4>
          <p style="font-size:.85rem;color:var(--muted);flex:1"><%= r.excerpt %></p>
          <a href="/blog/<%= r.slug %>" class="btn btn-outline btn-sm"><%= t('read_more') %></a>
        </div>
      <% }) %>
    </div>
    <% } %>
  </div>

  <div>
    <div class="sticky-card">
      <h4 style="margin-top:0;font-size:.95rem"><%= t('blog_go_deeper') %></h4>
      <p style="font-size:.85rem;color:var(--muted)"><%= t('blog_go_deeper_desc') %></p>
      <a href="/courses" class="btn btn-gold btn-block"><%= t('blog_explore_courses') %></a>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
