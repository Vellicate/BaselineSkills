<%- include('partials/header') %>

<section class="course-header" style="padding:64px 0">
  <div class="container">
    <span class="eyebrow" style="background:rgba(245,197,24,.2);color:#F5C518">Corporate Training</span>
    <h1 style="color:#fff;max-width:720px">Build capability that shows up at work.</h1>
    <p class="lead" style="color:rgba(255,255,255,.82);max-width:640px">Training creates value when people use what they learned. Baseline Skills works with teams to build practical capability around their real roles, processes and challenges.</p>
    <a href="#proposal-form" class="btn btn-gold btn-lg" style="margin-top:16px" data-analytics-event="corporate_capability">Build capability with your team</a>
  </div>
</section>

<section class="section" style="background:#EAF5F3;padding-top:32px;padding-bottom:32px">
  <div class="container">
    <div class="why-grid-4">
      <div class="lpa-card" style="background:#fff"><h4 style="margin:0;font-size:.95rem">Learn</h4></div>
      <div class="lpa-card" style="background:#fff"><h4 style="margin:0;font-size:.95rem">Practise</h4></div>
      <div class="lpa-card" style="background:#fff"><h4 style="margin:0;font-size:.95rem">Apply</h4></div>
      <div class="lpa-card" style="background:#fff"><h4 style="margin:0;font-size:.95rem">Improve</h4></div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container grid-2" style="align-items:start">
    <div>
      <h2>What's included</h2>
      <ul style="padding-left:20px">
        <li>Tailored learning objectives</li>
        <li>Industry-specific case studies</li>
        <li>Flexible scheduling</li>
        <li>Skills assessment</li>
        <li>Post-training support</li>
        <li>Certification preparation</li>
      </ul>

      <h2 style="margin-top:32px">How it works</h2>
      <ol style="padding-left:20px">
        <li>Discovery call</li>
        <li>Needs analysis</li>
        <li>Technical discussion</li>
        <li>Customized proposal</li>
        <li>Delivery</li>
        <li>Feedback &amp; improvement</li>
      </ol>

      <h2 style="margin-top:32px">Industries we serve</h2>
      <div style="display:flex;flex-wrap:wrap;gap:10px">
        <% ["Automotive","Embedded Systems","Aerospace","Industrial Automation","Medical Devices","IT & Digital Products"].forEach(i => { %>
          <span class="pill"><%= i %></span>
        <% }) %>
      </div>
    </div>

    <div class="card" id="proposal-form">
      <h3 style="margin-top:0">Request a corporate training proposal</h3>
      <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success">Thanks — we've received your inquiry and will be in touch shortly.</div>
      <% } %>
      <% if (typeof error !== 'undefined' && error) { %><div class="alert alert-error"><%= error %></div><% } %>
      <% if (typeof prefilledCourse !== 'undefined' && prefilledCourse) { %>
        <div class="alert" style="background:var(--bg-soft,#F1F5F9);color:var(--navy);margin-bottom:16px">
          Inquiring about <strong><%= prefilledCourse.title %></strong><% if (typeof prefilledMode !== 'undefined' && prefilledMode) { %> &mdash; <%= prefilledMode %><% } %>
        </div>
      <% } %>
      <form method="POST" action="/corporate-training/inquiry">
        <div class="form-field"><label>Full name *</label><input type="text" name="name" required></div>
        <div class="form-field"><label>Company *</label><input type="text" name="company" required></div>
        <div class="form-field"><label>Work email *</label><input type="email" name="email" required></div>
        <div class="form-field"><label>Phone</label><input type="text" name="phone"></div>
        <% if (typeof prefilledCourse !== 'undefined' && prefilledCourse) { %>
          <div class="form-field">
            <label>Course</label>
            <input type="text" name="courseInterest" value="<%= prefilledCourse.title %>">
          </div>
          <div class="form-field">
            <label>Delivery mode</label>
            <input type="text" name="deliveryMode" value="<%= typeof prefilledMode !== 'undefined' && prefilledMode ? prefilledMode : '' %>" readonly>
          </div>
        <% } else { %>
          <div class="form-field"><label>Course of interest (optional)</label><input type="text" name="courseInterest" placeholder="e.g. IREB CPRE Foundation Level"></div>
        <% } %>
        <div class="form-field"><label>Expected number of participants</label><input type="text" name="teamSize" placeholder="e.g. 15-20"></div>
        <div class="form-field"><label>Preferred dates (optional)</label><input type="text" name="preferredDates" placeholder="e.g. Q1 2027, or a specific week"></div>
        <div class="form-field"><label>What are you looking to achieve?</label><textarea name="message" rows="3"></textarea></div>
        <button type="submit" class="btn btn-navy btn-block">Request Proposal</button>
      </form>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
