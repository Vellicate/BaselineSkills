<%- include('partials/header') %>

<section class="section-tight" style="background:#fff;border-bottom:1px solid var(--line)">
  <div class="container">
    <span class="eyebrow">Get Started</span>
    <h1 style="font-size:2.1rem">Create your account.</h1>
    <p class="lead">Track your registrations, certificates, and courses in one place.</p>
  </div>
</section>

<section class="section">
  <div class="container" style="max-width:480px">
    <div class="card">
      <% if (typeof error !== 'undefined' && error) { %><div class="alert alert-error"><%= error %></div><% } %>
      <form method="POST" action="/signup">
        <div class="form-field"><label>Full name *</label><input type="text" name="name" required></div>
        <div class="form-field"><label>Email *</label><input type="email" name="email" required></div>
        <div class="form-field"><label>Password * (<%= passwordMinLength %>+ characters)</label><input type="password" name="password" minlength="<%= passwordMinLength %>" required></div>
        <div class="form-field"><label>Country</label><input type="text" name="country"></div>
        <button type="submit" class="btn btn-navy btn-block">Create Account</button>
      </form>
      <p style="margin-top:16px;font-size:.9rem;color:var(--muted)">Already have an account? <a href="/login">Log in</a></p>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
