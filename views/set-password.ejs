<%- include('partials/header') %>

<section class="section-tight" style="background:#fff;border-bottom:1px solid var(--line)">
  <div class="container">
    <span class="eyebrow"><%= t('setpw_eyebrow') %></span>
    <h1 style="font-size:2.1rem"><%= t('setpw_title') %></h1>
    <p class="lead"><%= t('setpw_lead') %></p>
  </div>
</section>

<section class="section">
  <div class="container" style="max-width:480px">
    <div class="card">
      <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
      <% if (token) { %>
      <form method="POST" action="<%= typeof action !== 'undefined' ? action : '/set-password' %>">
        <input type="hidden" name="token" value="<%= token %>">
        <div class="form-field"><label><%= t('setpw_new_password_label', passwordMinLength) %></label><input type="password" name="password" minlength="<%= passwordMinLength %>" required autofocus></div>
        <button type="submit" class="btn btn-navy btn-block"><%= t('setpw_set_password') %></button>
      </form>
      <% } %>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
