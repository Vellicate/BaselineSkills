<%- include('partials/header') %>

<section class="section-tight" style="background:#fff;border-bottom:1px solid var(--line)">
  <div class="container">
    <span class="eyebrow">Almost done</span>
    <h1 style="font-size:2.1rem">Set your password.</h1>
    <p class="lead">We created an account for you when you registered — set a password to log in and manage it any time.</p>
  </div>
</section>

<section class="section">
  <div class="container" style="max-width:480px">
    <div class="card">
      <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
      <% if (token) { %>
      <form method="POST" action="/set-password">
        <input type="hidden" name="token" value="<%= token %>">
        <div class="form-field"><label>New password (<%= passwordMinLength %>+ characters)</label><input type="password" name="password" minlength="<%= passwordMinLength %>" required autofocus></div>
        <button type="submit" class="btn btn-navy btn-block">Set Password</button>
      </form>
      <% } %>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
