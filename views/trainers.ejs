<%- include('partials/header') %>

<section class="section-tight" style="background:linear-gradient(135deg,#0F5C56,#083834);color:#fff">
  <div class="container" style="max-width:760px">
    <span class="eyebrow" style="color:rgba(255,255,255,.75)"><%= t('trainers_eyebrow') %></span>
    <h1 style="color:#fff;margin:8px 0 12px"><%= t('trainers_title') %></h1>
    <p class="lead" style="color:rgba(255,255,255,.85)"><%= t('trainers_lead') %></p>
  </div>
</section>

<section class="section">
  <div class="container">
    <% if (trainers.length === 0) { %>
      <p class="lead" style="text-align:center;color:var(--muted)"><%= t('trainers_empty') %></p>
    <% } else { %>
      <div class="why-grid" style="grid-template-columns:repeat(auto-fill,minmax(260px,1fr))">
        <% trainers.forEach(tr => { %>
          <a href="/trainers/<%= tr.id %>" class="why-item" style="text-decoration:none;color:inherit;display:block">
            <% if (tr.photoPath) { %>
              <% const initials = tr.name.split(' ').map(n => n[0]).slice(0,2).join('').toUpperCase(); %>
              <img src="<%= tr.photoPath %>" alt="<%= tr.name %>" style="width:64px;height:64px;border-radius:50%;object-fit:cover;margin-bottom:12px" onerror="this.outerHTML='<div style=&quot;width:64px;height:64px;border-radius:50%;background:var(--navy);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;margin-bottom:12px&quot;><%= initials %></div>'">
            <% } else { %>
              <div style="width:64px;height:64px;border-radius:50%;background:var(--navy);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;margin-bottom:12px">
                <%= tr.name.split(' ').map(n => n[0]).slice(0,2).join('').toUpperCase() %>
              </div>
            <% } %>
            <h4 style="margin:0 0 4px"><%= tr.name %></h4>
            <% if (tr.title) { %><p style="margin:0 0 8px;color:var(--navy-soft);font-size:.85rem;font-weight:600"><%= tr.title %></p><% } %>
            <% if (tr.bio) { %><p style="margin:0;font-size:.85rem"><%= tr.bio.slice(0, 140) %><%= tr.bio.length > 140 ? '&hellip;' : '' %></p><% } %>
            <p style="margin:10px 0 0;font-size:.78rem;color:var(--muted)"><%= tr.courseCount %> <%= tr.courseCount === 1 ? t('outcome_course_singular') : t('outcome_course_plural') %></p>
          </a>
        <% }) %>
      </div>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>
