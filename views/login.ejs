<%- include('partials/header') %>

<section class="section-tight" style="background:#fff;border-bottom:1px solid var(--line)">
  <div class="container">
    <span class="eyebrow">Welcome Back</span>
    <h1 style="font-size:2.1rem">Log in to your account.</h1>
  </div>
</section>

<section class="section">
  <div class="container" style="max-width:480px">
    <div class="card">
      <% if (typeof error !== 'undefined' && error) { %><div class="alert alert-error"><%= error %></div><% } %>
      <form method="POST" action="/login">
        <input type="hidden" name="next" value="<%= typeof next !== 'undefined' ? next : '' %>">
        <div class="form-field"><label>Email</label><input type="email" name="email" required autofocus></div>
        <div class="form-field"><label>Password</label><input type="password" name="password" required></div>
        <button type="submit" class="btn btn-navy btn-block">Log In</button>
      </form>
      <p style="margin-top:16px;font-size:.9rem;color:var(--muted)">New here? <a href="/signup">Create an account</a></p>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
