<%- include('partials/header') %>

<section class="section-tight" style="background:#fff;border-bottom:1px solid var(--line)">
  <div class="container">
    <span class="eyebrow"><%= t('login_eyebrow') %></span>
    <h1 style="font-size:2.1rem"><%= t('login_title') %></h1>
  </div>
</section>

<section class="section">
  <div class="container" style="max-width:480px">
    <div class="card">
      <% if (typeof error !== 'undefined' && error) { %><div class="alert alert-error"><%= error %></div><% } %>
      <form method="POST" action="/login">
        <input type="hidden" name="next" value="<%= typeof next !== 'undefined' ? next : '' %>">
        <div class="form-field"><label><%= t('common_email') %></label><input type="email" name="email" required autofocus></div>
        <div class="form-field"><label><%= t('common_password') %></label><input type="password" name="password" required></div>
        <p style="text-align:right;margin:-8px 0 14px"><a href="/forgot-password" style="font-size:.85rem"><%= t('login_forgot_password') %></a></p>
        <button type="submit" class="btn btn-navy btn-block"><%= t('login_log_in') %></button>
      </form>
      <p style="margin-top:16px;font-size:.9rem;color:var(--muted)"><%= t('login_new_here') %> <a href="/signup"><%= t('login_create_account') %></a></p>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
