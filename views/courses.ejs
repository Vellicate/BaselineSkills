<%- include('partials/header') %>

<section class="section-tight" style="background:linear-gradient(180deg, #fff 0%, #f8fafc 100%);border-bottom:1px solid var(--line);padding:56px 0 36px">
  <div class="container">
    <div class="section-hdr">
      <span class="eyebrow">Engineering Curriculum</span>
      <h1 style="font-size:2.4rem;letter-spacing:-0.02em">Accredited Certifications &amp; Practical Skills Programs</h1>
      <p class="lead">Explore globally recognized certifications and role-based training programs led by senior industry practitioners.</p>
    </div>
  </div>
</section>

<section class="section" style="padding-top:40px">
  <div class="container">
    <% const courseCategoryDisplayLabel = (cat) => cat === 'AI' ? 'Artificial Intelligence' : cat; %>
    <div class="path-tabs-container" style="margin-bottom:24px">
      <div class="path-tabs" style="justify-content:center">
        <% categories.forEach(cat => { %>
          <a href="/courses?category=<%= encodeURIComponent(cat) %>&level=<%= encodeURIComponent(activeLevel) %>&format=<%= encodeURIComponent(activeFormat) %>&q=<%= encodeURIComponent(q) %>" class="path-tab <%= cat===activeCategory?'active':'' %>" style="text-decoration:none;display:inline-flex;align-items:center;gap:6px">
            <span><%= courseCategoryDisplayLabel(cat) %></span>
          </a>
        <% }) %>
      </div>
    </div>

    <form method="GET" action="/courses" class="card course-filter-bar" style="margin-bottom:32px;padding:20px">
      <input type="hidden" name="category" value="<%= activeCategory %>">
      <div class="form-field filter-field-search">
        <label>Search</label>
        <input type="text" name="q" placeholder="Search by course name..." value="<%= q %>">
      </div>
      <div class="form-field filter-field-select">
        <label>Level</label>
        <select name="level">
          <% levels.forEach(l => { %><option value="<%= l %>" <%= l===activeLevel?'selected':'' %>><%= l %></option><% }) %>
        </select>
      </div>
      <div class="form-field filter-field-select">
        <label>Format</label>
        <select name="format">
          <% formats.forEach(f => { %><option value="<%= f %>" <%= f===activeFormat?'selected':'' %>><%= f %></option><% }) %>
        </select>
      </div>
      <div class="form-field filter-field-select">
        <label>Certification Body</label>
        <select name="certBody">
          <% certBodies.forEach(b => { %>
            <% const val = b === 'All' ? 'All' : b.slug; const label = b === 'All' ? 'All' : b.name; %>
            <option value="<%= val %>" <%= val===activeCertBody?'selected':'' %>><%= label %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-field filter-field-price">
        <label>Max price (€)</label>
        <input type="number" name="maxPrice" placeholder="Any" value="<%= maxPrice %>">
      </div>
      <button type="submit" class="btn btn-navy">Filter</button>
    </form>

    <% if (courses.length === 0) { %>
      <div class="card" style="text-align:center;padding:48px 24px">
        <h3>No courses match your search</h3>
        <p class="lead" style="margin-bottom:20px">Try a different search term or filter, or view all our available training programs.</p>
        <div><a href="/courses" class="btn btn-navy">View All Courses</a></div>
      </div>
    <% } %>

    <div class="grid-3">
      <% courses.forEach(c => { %>
        <% const cd = c.cardData; %>
        <div class="course-mini-card">
          <% if (c.imageUrl) { %><img src="<%= c.imageUrl %>" alt="<%= c.title %>" style="width:100%;height:140px;object-fit:cover;border-radius:8px;margin-bottom:12px"><% } %>
          <div class="mini-card-top">
            <span class="tag <%= cd.certifyingBodyLabel ? 'tag-cert' : 'tag-skill' %>">
              <%= cd.certifyingBodyLabel ? ('🏅' + cd.certifyingBodyLabel) : '⚡ Skills Mastery' %>
            </span>
            <span class="mini-duration"><%= c.durationDays %> Day<%= c.durationDays > 1 ? 's' : '' %></span>
          </div>

          <span class="domain-sub-kicker"><%= c.category %><% if (c.level) { %> · <%= c.level %><% } %></span>
          <h3 class="mini-course-title" style="font-size:1.18rem;margin-top:4px"><%= c.title %></h3>
          <% if (cd.avgRating != null) { %>
            <p style="margin:2px 0 6px;font-size:.85rem;color:#B8860B" aria-label="Rated <%= cd.avgRating.toFixed(1) %> out of 5 from <%= cd.reviewCount %> review<%= cd.reviewCount !== 1 ? 's' : '' %>">
              <span aria-hidden="true">⭐</span> <%= cd.avgRating.toFixed(1) %> (<%= cd.reviewCount %>)
            </p>
          <% } %>
          <p class="mini-course-summary"><%= c.summary %></p>

          <% if (cd.nextSession) { %>
            <p style="font-size:.8rem;color:var(--muted);margin:6px 0">
              <span aria-hidden="true">📅</span> Next: <%= cd.nextSession.startDate %> · <%= cd.nextSession.mode %>
            </p>
          <% } %>

          <div class="mini-price-row">
            <div class="price-val-wrap">
              <% if (cd.pricing.discountPercent > 0) { %>
                <span class="price-was" style="text-decoration:line-through;opacity:.55;font-size:.8em;margin-right:4px"><%= currencySymbol(c.currency) %><%= (cd.pricing.originalPriceCents/100).toFixed(0) %></span>
              <% } %>
              <span class="price-current"><%= currencySymbol(c.currency) %><%= (cd.pricing.finalPriceCents/100).toFixed(0) %></span>
              <% if(cd.pricing.discountPercent > 0){ %><span class="price-discount-pill"><%= cd.pricing.discountPercent %>% OFF</span><% } %>
            </div>
            <% if (cd.availabilityLabel) { %>
              <div class="seats-status-pill">
                <span class="status-pulse-dot"></span>
                <span><%= cd.availabilityLabel %></span>
              </div>
            <% } %>
          </div>

          <div class="course-mini-ctas">
            <a href="/courses/<%= c.slug %>" class="btn btn-outline btn-learn-more">
              <span>View Course</span>
              <svg class="cta-arrow-slide" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </a>
            <a href="/courses/<%= c.slug %>#sessions" class="btn btn-navy btn-batches-cta">
              <span>Upcoming Batches</span>
              <span class="batch-count-dot">📅</span>
            </a>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<%- include('partials/footer') %>

